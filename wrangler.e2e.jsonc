// Configuration réservée aux tests e2e (playwright.config.ts) : mêmes
// assets que wrangler.jsonc, sans `build`, pour que `wrangler dev` serve le
// dist/ déjà construit au lieu de relancer `bun run build`.
{
  "name": "williamdeazevedo-e2e",
  "compatibility_date": "2026-06-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
