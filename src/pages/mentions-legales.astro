---
import FadeReveal from "@/components/animations/FadeReveal.astro";
import { isAudienceExempt } from "@/scripts/analytics";
import Layout from "../layout/Layout.astro";

// Mesure d'audience Rybbit : données d'après la configuration publique de
// l'instance et le script servi, relevés le 16/11/2026
// (docs/confidentialite-deploiement.md). Ce qui n'a pas été vérifié n'est pas
// affirmé ci-dessous.
// oxlint-disable-next-line no-warning-comments -- informations manquantes, à compléter par William (liste reprise dans docs/confidentialite-deploiement.md).
/* TODO(William): pays d'hébergement du serveur Rybbit (texte « à préciser »
   ci-dessous), réglages IP et captures automatiques : voir la liste
   « À compléter » de docs/confidentialite-deploiement.md. Conservation : si
   une durée est fixée sur le serveur (TTL ClickHouse), remplacer le
   paragraphe « Durée de conservation ». */
const rybbitLoading = isAudienceExempt
    ? "Rybbit est chargé dès votre arrivée sur le site, sans attendre votre accord : cette mesure d'audience relève de l'exemption de consentement prévue par l'article 82 de la loi Informatique et Libertés, dans les conditions fixées par la CNIL, et repose sur l'intérêt légitime à connaître la fréquentation du site. Vous pouvez vous y opposer à tout moment, comme indiqué en fin de section."
    : "Rybbit n'est chargé qu'après votre accord pour la finalité « Mesure d'audience » du bandeau cookies, et cette mesure repose sur ce consentement. Sans accord, aucune requête n'est envoyée à analytics.williamdeazevedo.fr.";
const rybbitIdentifierDeletion = isAudienceExempt
    ? "Le site efface cet identifiant si vous vous opposez à la mesure d'audience."
    : "Le site efface cet identifiant si vous refusez ou retirez la mesure d'audience, ainsi qu'à votre première visite après l'expiration de votre choix (6 mois).";
const rybbitCookieRule = isAudienceExempt
    ? "Rybbit, l'outil de mesure d'audience du site, est chargé sans attendre votre accord (voir « Mesure d'audience ») ; refuser la mesure d'audience l'arrête."
    : "Rybbit, l'outil de mesure d'audience du site, suit la même règle : il n'est chargé qu'après votre accord pour la mesure d'audience.";

const sections = [
    {
        id: "editeur",
        title: "Éditeur",
        paragraphs: [
            "Ce site est édité par William Ferreira De Azevedo, entrepreneur individuel (EI) exerçant sous le régime de la micro-entreprise, dont le siège est situé au 62 rue Michel Giraux, 78670 Villennes-sur-Seine, France.",
        ],
    },
    {
        id: "immatriculation",
        title: "Immatriculation",
        paragraphs: [
            "Entreprise individuelle immatriculée au Registre National des Entreprises (RNE) depuis le 11 décembre 2025. SIREN : 995 010 873. SIRET du siège : 995 010 873 00017. Code APE/NAF : 6201Z (Programmation informatique).",
        ],
    },
    {
        id: "responsable-publication",
        title: "Responsable de publication",
        paragraphs: ["William Ferreira De Azevedo."],
    },
    {
        id: "contact",
        title: "Contact",
        paragraphs: [
            "Pour toute demande, vous pouvez écrire à william.deazevedopro@gmail.com ou appeler le 07 62 74 60 21.",
            "Adresse de correspondance : 3 rue des Tourelles, 78260 Achères, France.",
        ],
    },
    {
        id: "tva",
        title: "TVA",
        paragraphs: [
            "TVA non applicable, article 293 B du Code général des impôts (franchise en base de TVA).",
        ],
    },
    {
        id: "hebergement",
        title: "Hébergement",
        paragraphs: [
            "Le site est hébergé par Cloudflare, Inc., 101 Townsend Street, San Francisco, CA 94107, États-Unis. Téléphone : +1 650 319 8930.",
        ],
    },
    {
        id: "propriete-intellectuelle",
        title: "Propriété intellectuelle",
        paragraphs: [
            "Les contenus, textes, images et éléments graphiques présents sur ce site restent la propriété de William De Azevedo ou de leurs auteurs respectifs, sauf mention contraire. Toute reproduction sans autorisation est interdite.",
        ],
    },
    {
        id: "confidentialite",
        title: "Données personnelles",
        paragraphs: [
            "William Ferreira De Azevedo, identifié dans la rubrique Éditeur, est responsable des traitements liés à ce site. Pour toute question ou demande concernant vos données : william.deazevedopro@gmail.com.",
            "Lorsque vous écrivez par email ou demandez un rendez-vous, les données traitées comprennent vos coordonnées, le contenu de votre demande et, pour une réservation, le créneau choisi. Elles servent à répondre à votre demande, préparer un devis ou organiser un échange. Les démarches liées à un projet reposent sur les mesures précontractuelles prises à votre demande ; les autres demandes reposent sur l'intérêt légitime à répondre aux personnes qui nous contactent.",
            "Vos coordonnées ne sont pas vendues. Elles sont accessibles à William Ferreira De Azevedo et aux prestataires nécessaires au service : Google pour la messagerie Gmail, Cal.com pour la réservation et Cloudflare pour l'hébergement et la sécurité du site.",
            "Les échanges sont conservés pendant le traitement de votre demande et la préparation éventuelle de votre projet. Si une relation contractuelle commence, les données nécessaires sont conservées pendant cette relation ; certaines pièces doivent ensuite être archivées pour respecter les obligations légales ou défendre des droits. Vous pouvez demander la suppression des informations qui ne sont plus nécessaires.",
        ],
    },
    {
        id: "reservation",
        title: "Rendez-vous avec Cal.com",
        paragraphs: [
            "Le calendrier de réservation est fourni par Cal.com. Cal.com n'est contacté qu'au moment où vous appuyez sur un bouton de réservation (souris, doigt ou stylet) ou l'activez au clavier. Le chargement commence dès cet appui, même si vous relâchez ensuite en dehors du bouton, auquel cas la fenêtre de réservation ne s'ouvre pas. Survoler un bouton de réservation ou le sélectionner au clavier ne contacte pas Cal.com.",
            "Cal.com reçoit alors les informations techniques nécessaires à la connexion, puis les renseignements que vous saisissez pour organiser le rendez-vous. La mesure de réussite d'une réservation n'inclut pas votre nom, votre adresse email ni le contenu de votre demande.",
            "Les données nécessaires à l'organisation du rendez-vous reposent sur les mesures précontractuelles demandées par vous. Les traitements propres à Cal.com sont décrits dans sa politique de confidentialité : https://cal.com/privacy.",
        ],
    },
    {
        id: "mesure-audience",
        title: "Mesure d'audience",
        paragraphs: [
            "Ce site mesure son audience avec Rybbit, un logiciel libre de mesure d'audience. Il est auto-hébergé : William Ferreira De Azevedo l'installe et l'administre lui-même sur son serveur personnel, à l'adresse analytics.williamdeazevedo.fr. Votre navigateur envoie les statistiques uniquement à ce serveur, et non à un service en ligne de l'éditeur du logiciel Rybbit. Cette mesure sert à connaître la fréquentation des pages et à améliorer les contenus et la navigation, sans personnalisation publicitaire. La provenance des visites inclut les paramètres de campagne présents dans l'adresse (utm, gclid). Les requêtes vers cette adresse passent par Cloudflare.",
            rybbitLoading,
            "Données envoyées à Rybbit : adresse de la page consultée (chemin, titre et paramètres d'URL ; la recherche saisie sur la page Articles n'est jamais placée dans l'adresse), page de provenance, taille de l'écran, langue, navigateur et système d'exploitation. Avec la configuration actuelle de Rybbit, s'y ajoutent les clics sur les boutons et les liens vers d'autres sites, le texte que vous copiez sur le site, l'envoi des formulaires et le nom des champs modifiés (pas ce que vous y saisissez), les erreurs techniques de la page, ainsi que les événements du site décrits ci-dessous (clics sur les moyens de contact, les réseaux sociaux et les liens vers d'autres sites, ouverture et réussite d'une réservation). Le script calcule aussi un indice à partir de caractéristiques techniques du navigateur, pour écarter les robots.",
            `Votre adresse IP sert à déduire une localisation approximative (pays, région, parfois ville). Rybbit enregistre dans le stockage local de votre navigateur un identifiant aléatoire, sous la clé rybbit-visitor-id, dans le stockage local du navigateur ; son script ne lui fixe pas de durée de vie. ${rybbitIdentifierDeletion} Côté serveur, Rybbit relie les visites d'un même navigateur par un identifiant calculé à partir de l'adresse IP et du navigateur, et déduit de l'adresse IP l'opérateur réseau (nom du fournisseur d'accès ou de l'organisation).`,
            "Durée de conservation : le logiciel Rybbit ne supprime pas automatiquement les statistiques de visite, et aucune durée de suppression automatique n'a été fixée à ce jour sur le serveur. Les statistiques sont donc conservées jusqu'à ce que William Ferreira De Azevedo les supprime ; elles ne servent qu'à mesurer l'audience du site. Vous pouvez demander à tout moment l'effacement des données liées à votre navigateur à william.deazevedopro@gmail.com.",
            "Les clics sur les liens de contact ne prouvent pas qu'un email a été envoyé ou qu'un appel a abouti. Le contenu des emails et les coordonnées saisies pour un rendez-vous ne sont pas transmis par les événements de mesure du site.",
            "Google Analytics (mesure d'audience) et Google Ads (mesure des contacts issus des annonces : rendez-vous, clics sur l'email ou le téléphone) sont chargés par Google Tag Manager, et seulement pour les finalités que vous acceptez dans le bandeau. Sans accord, aucun script Google n'est chargé. Google Search Console est un service distinct, décrit ci-dessous.",
            "Pour retirer votre accord ou vous opposer à la mesure d'audience, ouvrez vos préférences avec le bouton ci-dessous ou le lien « Gérer les cookies » en bas de page, puis désactivez « Mesure d'audience ». Le site efface alors l'identifiant Rybbit et enregistre la clé disable-rybbit dans le stockage local, pour que Rybbit ne se charge plus. Si Rybbit était actif, la page se recharge. La clé disable-rybbit est retirée si vous acceptez de nouveau la mesure d'audience.",
        ],
        cookieSettings: true,
    },
    {
        id: "cookies",
        title: "Cookies et autres traceurs",
        paragraphs: [
            `Google Tag Manager, et avec lui les cookies Google de mesure d'audience (Google Analytics) et de publicité (Google Ads), n'est chargé qu'après votre accord, donné via le bandeau de consentement. ${rybbitCookieRule} Vous pouvez accepter ou refuser chaque finalité séparément, et refuser est aussi simple qu'accepter. Votre choix est enregistré dans le stockage local du navigateur pendant 6 mois, puis redemandé. Vous pouvez le modifier à tout moment avec le lien « Gérer les cookies » en bas de page.`,
            "Traceurs Google, seulement après accord pour la finalité concernée : mesure d'audience (Google Analytics), cookies _ga et _ga_<identifiant>, conservés jusqu'à 2 ans (durée par défaut de Google Analytics) ; publicité (Google Ads), cookies _gcl_au et _gcl_aw, conservés 90 jours. Aucune personnalisation des annonces (remarketing) n'est activée. Rybbit utilise l'identifiant rybbit-visitor-id du stockage local, décrit dans la section « Mesure d'audience ». Le choix lui-même est enregistré sous la clé wui-consent du stockage local, pendant 6 mois ; il ne sert qu'à mémoriser votre décision. Si vous refusez la mesure d'audience, la clé disable-rybbit y est aussi enregistrée, jusqu'à ce que vous l'acceptiez de nouveau, pour que Rybbit ne se charge pas. Retirer une finalité efface ses cookies et identifiants, puis recharge la page.",
            "Le code du site ne conserve aucune file d'événements de mesure dans le stockage local ou de session. Les événements en attente, lorsque la mesure est activée, sont gardés uniquement en mémoire pendant la page courante.",
            "Cloudflare fournit l'hébergement et la protection du site ; des informations techniques de connexion peuvent être traitées pour ces finalités. Les liens vers les réseaux sociaux ouvrent des sites tiers, dont les propres règles de confidentialité s'appliquent après votre navigation.",
        ],
    },
    {
        id: "search-console",
        title: "Google Search Console",
        paragraphs: [
            "Google Search Console permet de consulter les performances du site dans les résultats Google : impressions, clics, requêtes et indexation. Ce service est distinct de Google Analytics. La validation du site par DNS ou fichier HTML n'ajoute pas, à elle seule, de traceur dans le navigateur des visiteurs.",
        ],
    },
    {
        id: "droits",
        title: "Vos droits",
        paragraphs: [
            "Selon le traitement concerné, vous pouvez demander l'accès, la rectification, l'effacement, la limitation ou la portabilité de vos données. Vous pouvez vous opposer aux traitements reposant sur l'intérêt légitime et retirer à tout moment un consentement, sans remettre en cause les traitements antérieurs à ce retrait.",
            "Adressez votre demande à william.deazevedopro@gmail.com. Une réponse vous est apportée en principe dans un délai d'un mois ; une prolongation motivée peut s'appliquer aux demandes complexes. Vous pouvez également introduire une réclamation auprès de la CNIL : https://www.cnil.fr/fr/plaintes.",
        ],
    },
    {
        id: "prestataires",
        title: "Prestataires et transferts",
        paragraphs: [
            "Le recours à Google, Cloudflare et Cal.com peut entraîner des traitements en dehors de l'Union européenne. Les garanties applicables et les durées de conservation propres aux services doivent être examinées dans les contrats et politiques des prestataires. Le serveur Rybbit est le serveur personnel de l'éditeur, qui l'administre lui-même, sans prestataire de mesure d'audience ; les requêtes y passent par Cloudflare. Pays d'hébergement de ce serveur : à préciser.",
            "Informations des prestataires : https://www.cloudflare.com/privacypolicy/, https://policies.google.com/privacy et https://cal.com/privacy. Pour obtenir des précisions sur les traitements de ce site ou exercer vos droits, contactez William Ferreira De Azevedo.",
        ],
    },
];
---

<Layout
    title="Mentions légales et confidentialité - William De Azevedo"
    description="Mentions légales, confidentialité, cookies et mesure d'audience du site de William De Azevedo."
>
    <section class="mx-auto flex w-full max-w-3xl flex-col gap-10 px-4 py-12 md:py-16">
        <FadeReveal delay={0.1}>
            <div class="flex flex-col gap-4 text-center">
                <p class="text-sm font-light text-blue-500">Informations légales</p>
                <h1 class="page-heading">
                    Mentions légales et confidentialité
                </h1>
                <p class="page-subheading max-w-sm sm:max-w-lg">
                    Cette page rassemble les informations essentielles liées à
                    l'édition, l'hébergement et l'utilisation du site.
                </p>
            </div>
        </FadeReveal>
        <p class="text-sm text-gray-600">Mise à jour : 16 novembre 2026.</p>
        <nav aria-label="Références de confidentialité" class="flex flex-wrap gap-4 text-sm underline">
            <a href="https://www.cnil.fr/fr/plaintes">CNIL et réclamations</a>
            <a href="https://cal.com/privacy">Confidentialité Cal.com</a>
            <a href="https://policies.google.com/privacy">Confidentialité Google</a>
            <a href="https://www.cloudflare.com/privacypolicy/">Confidentialité Cloudflare</a>
        </nav>
        <div class="flex flex-col divide-y divide-snow-600/80">
            {
                sections.map((section) => (
                    <section
                        class="grid gap-3 py-6 sm:grid-cols-[12rem_1fr]"
                        id={section.id}
                    >
                        <h2 class="text-base font-medium text-gray-900">
                            {section.title}
                        </h2>
                        <div class="flex flex-col gap-4">
                            {section.paragraphs.map((paragraph) => (
                                <p class="font-light leading-relaxed text-gray-600">
                                    {paragraph}
                                </p>
                            ))}
                            {/* Rouvre le bandeau (CookieBanner.astro), comme « Gérer les cookies » en pied de page. */}
                            {section.cookieSettings && (
                                <button
                                    class="hero-button hero-button--secondary flex min-h-10 w-fit cursor-pointer items-center justify-center rounded-xl px-4 py-2 text-sm font-normal"
                                    aria-controls="cookie-banner"
                                    data-cookie-settings
                                    type="button"
                                >
                                    Gérer les cookies
                                </button>
                            )}
                        </div>
                    </section>
                ))
            }
        </div>
    </section>
</Layout>
