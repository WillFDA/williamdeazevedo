---
import { Image } from "astro:assets";
import Layout from "../layout/Layout.astro";
import AboutCallout from "../components/AboutCallout.astro";
import FadeReveal from "../components/animations/FadeReveal.astro";
import FadeRevealOnScroll from "../components/animations/FadeRevealOnScroll.astro";
import Marquee from "../components/Marquee.astro";
import UserHeart from "../components/icons/nucleo/user-heart-fill.svg";
import WindowPaintbrush from "../components/icons/nucleo/window-paintbrush-fill.svg";
import WindowPointer from "../components/icons/nucleo/window-pointer-fill.svg";
import { type IconTone, iconToneClasses } from "@/lib/iconTones";
import bourgetPicture from "@/assets/pictures/bourget-opti.jpg";
import desktopPicture from "@/assets/pictures/desktop-opti.jpg";
import gokuPicture from "@/assets/pictures/goku-opti.jpg";
import maderePicture from "@/assets/pictures/madere-opti.jpg";
import majorquePicture from "@/assets/pictures/majorque-opti.jpg";

export const prerender = true;

const aboutHeroTitleWords = [
    "Du",
    "design",
    "au",
    "code,",
    "je",
    "rends",
    "vos",
    "sites",
    "plus",
    "clairs,",
    "rapides",
    "et",
    "crédibles.",
];
const highlightedAboutHeroWords = new Set(["clairs,", "rapides", "crédibles."]);

const pictures = [
    {
        alt: "Photo prise au Bourget",
        className: "rotate-2",
        src: bourgetPicture,
    },
    {
        alt: "Photo de voyage à Majorque",
        className: "-rotate-2",
        src: majorquePicture,
    },
    {
        alt: "Photo de voyage à Madère",
        className: "rotate-2",
        src: maderePicture,
    },
    {
        alt: "Photo de Goku",
        className: "-rotate-2 hidden lg:block",
        src: gokuPicture,
    },
    {
        alt: "Photo du setup de travail",
        className: "rotate-2 hidden lg:block",
        src: desktopPicture,
    },
];

type ClientAngle = {
    icon: "design" | "way" | "projects";
    items: string[];
    title: string;
    tone: IconTone;
};

const clientAngles: ClientAngle[] = [
    {
        icon: "design",
        tone: "violet",
        title: "Ce que le design apporte",
        items: [
            "hiérarchie visuelle plus lisible",
            "interfaces plus faciles à comprendre",
            "cohérence entre marque, message et action",
        ],
    },
    {
        icon: "way",
        tone: "blue",
        title: "Ma manière de travailler",
        items: [
            "écoute et pédagogie",
            "décisions expliquées simplement",
            "solutions sobres plutôt que complexité gratuite",
        ],
    },
    {
        icon: "projects",
        tone: "sky",
        title: "Les projets où je suis utile",
        items: [
            "sites vitrines et refontes",
            "interfaces produit et front-end",
            "projets avec un enjeu de clarté et de conversion",
        ],
    },
];
---

<Layout
    title="À propos - William De Azevedo"
    description="Développeur front-end avec une approche design et produit pour créer des sites clairs, rapides, accessibles et crédibles."
>
    <div class="mx-auto flex w-full max-w-5xl flex-col gap-12 px-4 py-12 md:gap-16 md:py-16">
        <section class="flex flex-col gap-6">
            <h1 class="page-heading flex w-full max-w-sm flex-wrap justify-center gap-x-[0.18em] px-2 sm:max-w-4xl md:max-w-5xl">
                {
                    aboutHeroTitleWords.map((word, index) => (
                        <span
                            class:list={[
                                "about-hero-title-word",
                                highlightedAboutHeroWords.has(word) &&
                                    "text-coffee-300",
                            ]}
                            style={`--about-hero-word-index: ${index}`}
                        >
                            {word}
                        </span>
                    ))
                }
            </h1>
            <FadeReveal delay={0.32}>
                <p class="page-subheading max-w-sm sm:max-w-lg">
                    Mon rôle : repérer ce qui brouille la compréhension, rendre
                    l'interface plus lisible, puis développer une base rapide,
                    accessible et simple à maintenir.
                </p>
            </FadeReveal>
            <Marquee />
        </section>

        <FadeRevealOnScroll>
            <section class="mx-auto flex w-full max-w-2xl flex-col gap-4 text-center">
                <h2 class="text-base font-medium text-blue-500">Parcours</h2>
                <div class="flex flex-col gap-4 text-base font-normal leading-relaxed text-gray-600">
                    <p>
                        Mon parcours dans l'infographie et le motion design
                        m'a donné un <span class="font-medium text-gray-900"
                            >œil aiguisé pour le design</span
                        > et une sensibilité forte pour les interfaces qui se comprennent
                        vite.
                    </p>
                    <p>
                        En 2022, j'ai fait le choix de me reconvertir dans le
                        développement web pour <span class="font-medium text-gray-900"
                            >donner vie à mes propres projets</span
                        >. Depuis, je construis des expériences web avec une approche
                        front-end, produit et full stack.
                    </p>
                    <p>
                        Aujourd'hui, je travaille sur des sites vitrines, des
                        interfaces produit et des applications complètes, avec le
                        même objectif : <span class="font-medium text-gray-900"
                            >enlever les frictions qui font douter</span
                        > et livrer quelque chose de clair, rapide et réellement utile.
                    </p>
                </div>
            </section>
        </FadeRevealOnScroll>

        <section class="grid gap-4 md:grid-cols-3">
            {
                clientAngles.map((angle, index) => (
                    <FadeRevealOnScroll class="flex" delay={0.05 + index * 0.06}>
                        <article class="w-full rounded-xl bg-snow-50 p-5 ring-1 ring-snow-600">
                            <div class="mb-4 flex items-center gap-3">
                                <span
                                    class:list={[
                                        "inline-flex size-9 shrink-0 items-center justify-center rounded-lg text-snow-50",
                                        iconToneClasses[angle.tone],
                                    ]}
                                    aria-hidden="true"
                                >
                                    {angle.icon === "design" && (
                                        <WindowPaintbrush class="size-5" />
                                    )}
                                    {angle.icon === "way" && (
                                        <UserHeart class="size-5" />
                                    )}
                                    {angle.icon === "projects" && (
                                        <WindowPointer class="size-5" />
                                    )}
                                </span>
                                <h2 class="text-lg font-normal leading-tight text-gray-900">
                                    {angle.title}
                                </h2>
                            </div>
                            <ul class="flex flex-col gap-3">
                                {angle.items.map((item) => (
                                    <li class="flex items-start gap-3 text-base font-normal leading-relaxed text-gray-600">
                                        <span
                                            class="mt-2.5 size-1.5 shrink-0 rounded-full bg-gray-300"
                                            aria-hidden="true"
                                        />
                                        <span>{item}</span>
                                    </li>
                                ))}
                            </ul>
                        </article>
                    </FadeRevealOnScroll>
                ))
            }
        </section>

        <AboutCallout title="Je relie mon œil design au code pour créer des interfaces utiles." />

        <section class="relative left-1/2 w-dvw -translate-x-1/2">
            <FadeRevealOnScroll>
                <div aria-label="Photos de William" class="photo-strip flex items-center justify-start gap-3 overflow-x-auto px-4 sm:px-4 lg:justify-center lg:gap-5 lg:overflow-visible lg:px-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500" role="region" tabindex="0">
                    {
                        pictures.map((picture, index) => (
                            <div
                                class:list={[
                                    "aspect-[9/10] w-36 shrink-0 overflow-hidden rounded-lg bg-gray-100 transition-transform duration-300 hover:scale-[1.02] sm:w-40 lg:w-44",
                                    picture.className,
                                ]}
                            >
                                <Image
                                    alt={picture.alt}
                                    class="h-full w-full object-cover"
                                    loading={index < 3 ? "eager" : "lazy"}
                                    widths={[176, 352]}
                                    sizes="176px"
                                    src={picture.src}
                                />
                            </div>
                        ))
                    }
                </div>
            </FadeRevealOnScroll>
        </section>
    </div>
</Layout>

<style>
    .about-hero-title-word {
        animation: about-hero-title-word 1100ms cubic-bezier(0.16, 1, 0.3, 1)
            backwards;
        animation-delay: calc(var(--about-hero-word-index, 0) * 65ms);
        display: inline-block;
    }

    @keyframes about-hero-title-word {
        from {
            filter: blur(10px);
            opacity: 0;
            transform: translateY(-0.65em);
        }

        to {
            filter: none;
            opacity: 1;
            transform: none;
        }
    }

    .photo-strip {
        scrollbar-width: none;
    }

    .photo-strip::-webkit-scrollbar {
        display: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .about-hero-title-word {
            animation: none;
            filter: none;
            opacity: 1;
            transform: none;
        }
    }
</style>
