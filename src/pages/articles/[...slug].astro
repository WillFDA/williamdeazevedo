---
import { Image } from "astro:assets";
import { render } from "astro:content";
import ArticleAuthorBox from "@/components/articles/ArticleAuthorBox.astro";
import ArticleBody from "@/components/articles/ArticleBody.astro";
import ArticleImage from "@/components/articles/ArticleImage.astro";
import RelatedArticles from "@/components/articles/RelatedArticles.astro";
import ServiceCallout from "@/components/articles/ServiceCallout.astro";
import ChevronLeft from "@/components/icons/nucleo/chevron-left-fill.svg";
import FadeReveal from "@/components/animations/FadeReveal.astro";
import ReadingProgress from "@/components/ReadingProgress.astro";
import ArticleTag from "@/components/articles/ArticleTag.astro";
import williamPortrait from "@/assets/williamdeazevedo.webp";
import Layout, { DEFAULT_OG_IMAGE } from "@/layout/Layout.astro";
import { FAQ_SECTION_TITLE } from "@/lib/articleFaq";
import {
    type Article,
    formatArticleDate,
    getArticleReadingTimeMinutes,
    getArticleWordCount,
    getRelatedArticles,
    getVisibleArticles,
} from "@/lib/articles";

export async function getStaticPaths() {
    const articles = await getVisibleArticles();
    return articles.map((article) => ({
        params: { slug: article.id },
        props: {
            article,
            relatedArticles: getRelatedArticles(article, articles, 3),
        },
    }));
}

interface Props {
    article: Article;
    relatedArticles: Article[];
}

const { article, relatedArticles } = Astro.props;
const { Content, headings } = await render(article);
const { author, description, image, pubDate, seoTitle, tags, title, updatedDate } =
    article.data;

// Garde les H2 et H3 du corps dans le sommaire, mais exclut les questions H3
// de la section « Questions fréquentes » (rendues en accordéon plus bas) pour
// éviter un sommaire interminable sur mobile comme sur ordinateur.
const tocItems: typeof headings = [];
let inFaqSection = false;
for (const heading of headings) {
    if (heading.depth === 2) {
        inFaqSection = heading.text.trim() === FAQ_SECTION_TITLE;
        tocItems.push(heading);
    } else if (heading.depth === 3 && !inFaqSection) {
        tocItems.push(heading);
    }
}

const wordCount = getArticleWordCount(article.body);
const readingMinutes = getArticleReadingTimeMinutes(wordCount);
const showUpdatedDate =
    updatedDate !== undefined && updatedDate.getTime() > pubDate.getTime();
const isWilliam = author === "William De Azevedo";

const articleTitleBreak = "2 000 euros";
const shouldSplitArticleTitle =
    article.id === "site-600-euros-vs-site-2000-euros" &&
    title.includes(articleTitleBreak);
const [articleTitleStart, articleTitleEnd = ""] = shouldSplitArticleTitle
    ? title.split(articleTitleBreak)
    : [title, ""];

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
// Même @id et même url (/about/) que le nœud Person du Layout, pour relier
// proprement les entités sans contradiction.
const personId = new URL("/#person", siteUrl).href;
const personUrl = new URL("/about/", siteUrl).href;
const authorNode = isWilliam
    ? {
          "@type": "Person",
          "@id": personId,
          name: author,
          url: personUrl,
      }
    : {
          "@type": "Person",
          name: author,
          url: siteUrl.href,
      };
const canonicalUrl = new URL(`/articles/${article.id}/`, siteUrl);
const ogImage = new URL(image?.src ?? DEFAULT_OG_IMAGE, siteUrl);

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    inLanguage: "fr-FR",
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    image: ogImage.href,
    url: canonicalUrl.href,
    mainEntityOfPage: canonicalUrl.href,
    ...(tags[0] && { articleSection: tags[0] }),
    ...(wordCount > 0 && { wordCount }),
    keywords: tags,
    author: authorNode,
    publisher: authorNode,
};

const breadcrumbJsonLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Accueil",
            item: siteUrl.href,
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Articles",
            item: new URL("/articles/", siteUrl).href,
        },
        {
            "@type": "ListItem",
            position: 3,
            name: title,
            item: canonicalUrl.href,
        },
    ],
};
---

<Layout
    title={`${seoTitle ?? title} - William De Azevedo`}
    description={description}
    image={image?.src}
    imageAlt={image?.alt}
    canonicalPath={`/articles/${article.id}/`}
    ogType="article"
    article={{
        publishedTime: pubDate.toISOString(),
        modifiedTime: (updatedDate ?? pubDate).toISOString(),
        author,
        tags,
    }}
>
    <ReadingProgress />

    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(jsonLd)}
    />
    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(breadcrumbJsonLd)}
    />

    <article
        class="mx-auto w-full max-w-6xl px-4 pt-12 pb-4 md:px-6 md:pt-16 md:pb-6"
        data-reading-progress-root
    >
        {/* Glissement sans fondu : le titre peut être l'élément LCP (mobile, article sans couverture). */}
        <FadeReveal delay={0.1} fade={false}>
            <header class="mx-auto mb-12 max-w-5xl text-center">
                <a
                    class="mb-6 inline-flex items-center gap-2 text-sm font-normal text-gray-600 transition-colors hover:text-gray-900"
                    href="/articles/"
                >
                    <ChevronLeft aria-hidden="true" class="size-4" />
                    Tous les articles
                </a>
                <h1 class="page-heading mb-4 text-pretty">
                    {shouldSplitArticleTitle ? (
                        <>
                            {articleTitleStart.trim()}
                            <br class="hidden sm:block" />{" "}
                            <span>{articleTitleBreak + articleTitleEnd}</span>
                        </>
                    ) : (
                        title
                    )}
                </h1>
                <p class="page-subheading">{description}</p>
                {tags.length > 0 && (
                    <div class="mt-5 flex flex-wrap justify-center gap-2">
                        {tags.map((tag) => (
                            <ArticleTag tag={tag} />
                        ))}
                    </div>
                )}
                <div class="mt-6 flex items-center justify-center gap-3">
                    <Image
                        class="size-10 shrink-0 rounded-full object-cover"
                        src={williamPortrait}
                        alt=""
                        width={80}
                        height={80}
                        loading="eager"
                    />
                    <div class="text-left text-sm">
                        <p class="font-medium text-gray-900">
                            {isWilliam ? (
                                <a
                                    class="no-underline transition-colors hover:text-blue-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                                    href="/about/"
                                    rel="author"
                                >
                                    {author}
                                </a>
                            ) : (
                                author
                            )}
                            {isWilliam && (
                                <span class="font-normal text-gray-600">
                                    {" "}<span aria-hidden="true">·</span>{" "}
                                    Développeur front-end freelance
                                </span>
                            )}
                        </p>
                        <p class="flex flex-wrap items-center gap-x-1.5 font-normal text-gray-600">
                            <time datetime={pubDate.toISOString()}>
                                {formatArticleDate(pubDate)}
                            </time>
                            {showUpdatedDate && updatedDate && (
                                <>
                                    <span aria-hidden="true">·</span>
                                    <span>
                                        Mis à jour le{" "}
                                        <time
                                            datetime={updatedDate.toISOString()}
                                        >
                                            {formatArticleDate(updatedDate)}
                                        </time>
                                    </span>
                                </>
                            )}
                            <span aria-hidden="true">·</span>
                            <span>{readingMinutes} min de lecture</span>
                        </p>
                    </div>
                </div>
            </header>
        </FadeReveal>

        {/* Couverture hors FadeReveal : c'est l'élément LCP, elle doit être
            peinte dès le premier rendu, sans fondu. */}
        <div class="mx-auto mb-14 aspect-video w-full max-w-5xl overflow-hidden rounded-lg bg-gray-200">
            {image ? (
                <ArticleImage
                    class="size-full object-cover"
                    src={image.src}
                    alt={image.alt}
                    sizes="(min-width: 1024px) 1024px, 100vw"
                    loading="eager"
                    fetchpriority="high"
                />
            ) : (
                <span class="block size-full bg-gray-200"></span>
            )}
        </div>

        <ArticleBody articleId={article.id} tocItems={tocItems}>
            <Content />
        </ArticleBody>
    </article>

    {/* Blocs complémentaires hors <article> pour distinguer le contenu
        principal de l'article des éléments de navigation et de présentation. */}
    <div class="mx-auto w-full max-w-6xl px-4 pb-12 md:px-6 md:pb-16">
        <ArticleAuthorBox author={author} />
        <RelatedArticles articles={relatedArticles} />
        <ServiceCallout articleId={article.id} />
    </div>
</Layout>

<style is:global>
    .article-toc-column {
        align-self: start;
    }

    @media (min-width: 1024px) {
        .article-toc-column {
            max-height: calc(100dvh - 8.5rem);
            overflow-y: auto;
            padding-right: 0.35rem;
            position: sticky;
            scrollbar-color: var(--color-gray-300) transparent;
            scrollbar-width: thin;
            top: 7.5rem;
        }
    }

    .article-body-shell > * {
        min-width: 0;
    }

    .article-prose {
        overflow-wrap: anywhere;
        color: var(--color-gray-600);
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.75;
    }

    .article-prose > * + * {
        margin-top: 1.15rem;
    }

    .article-prose h2 {
        color: var(--color-gray-900);
        font-size: 1.25rem;
        font-weight: 500;
        line-height: 1.35;
        margin-top: 2.75rem;
        scroll-margin-top: 7rem;
    }

    .article-prose h3 {
        color: var(--color-gray-900);
        font-size: 1rem;
        font-weight: 500;
        line-height: 1.45;
        margin-top: 2.25rem;
        scroll-margin-top: 7rem;
    }

    /* The FAQ sits outside .article-prose: same offset for its anchors. */
    .article-faq :is(h2, h3) {
        scroll-margin-top: 7rem;
    }

    .article-prose strong {
        color: var(--color-gray-900);
        font-weight: 500;
    }

    .article-prose a {
        color: inherit;
        text-decoration: underline;
        text-decoration-color: var(--color-gray-300);
        text-underline-offset: 2px;
        transition: color 200ms ease;
    }

    @media (hover: hover) {
        .article-prose a:hover {
            color: var(--color-gray-900);
        }
    }

    .article-prose ul,
    .article-prose ol {
        padding-left: 1.25rem;
    }

    .article-prose ul {
        list-style: disc;
    }

    .article-prose ol {
        list-style: decimal;
    }

    .article-prose li + li {
        margin-top: 0.35rem;
    }

    .article-prose ul.contains-task-list {
        background: var(--color-snow-50);
        border: 1px solid var(--color-gray-200);
        border-radius: 1rem;
        list-style: none;
        padding: 0.35rem 1.25rem;
    }

    .article-prose .task-list-item {
        align-items: flex-start;
        display: flex;
        gap: 0.8rem;
        padding-block: 0.7rem;
    }

    .article-prose .task-list-item + .task-list-item {
        border-top: 1px solid var(--color-gray-100);
        margin-top: 0;
    }

    .article-prose .task-list-item input {
        appearance: none;
        background: var(--color-snow-50);
        border: 1.5px solid var(--color-gray-300);
        border-radius: 0.3rem;
        flex: none;
        height: 1.1rem;
        margin-top: 0.3rem;
        width: 1.1rem;
    }

    .article-prose blockquote {
        border-left: 2px solid var(--color-gray-200);
        color: var(--color-gray-500);
        font-style: italic;
        margin-block: 2rem;
        padding-left: 1rem;
    }

    .article-prose blockquote p {
        margin: 0;
    }

    .article-prose :not(pre) > code {
        background: var(--color-gray-100);
        border-radius: 0.25rem;
        color: var(--color-gray-900);
        font-size: 0.85em;
        padding: 0.15em 0.4em;
    }

    .article-prose pre {
        border-radius: 0.5rem;
        font-size: 0.8125rem;
        line-height: 1.6;
        margin-block: 1.75rem;
        overflow-x: auto;
        padding: 1rem 1.15rem;
    }

    .article-prose img {
        border-radius: 0.5rem;
        height: auto;
        margin-block: 1.75rem;
        width: 100%;
    }

    .article-prose p:has(> img:only-child) + p:has(> em:only-child) {
        color: var(--color-gray-600);
        font-size: 0.8125rem;
        line-height: 1.6;
        margin-top: -0.75rem;
        text-align: center;
    }

    .article-prose p:has(> img:only-child) + p > em:only-child {
        font-style: normal;
    }

    .article-table-scroll {
        background: var(--color-snow-50);
        border-radius: 1.25rem;
        border: 1px solid var(--color-gray-200);
        box-shadow: 0 1.25rem 2.5rem -2rem rgba(34, 42, 55, 0.35);
        margin-block: 2rem;
        max-width: 100%;
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scrollbar-color: var(--color-gray-500) transparent;
        scrollbar-width: thin;
    }

    /* Scroll hint: the right edge fades while more columns remain hidden.
       Scroll-driven animation only; without support the table simply scrolls. */
    @supports (animation-timeline: scroll(self inline)) {
        .article-table-scroll {
            /* Longhands on purpose: Lightning CSS would merge a shorthand
               into a form Chrome rejects. */
            animation-name: article-table-hint;
            animation-timing-function: linear;
            animation-fill-mode: both;
            animation-timeline: scroll(self inline);
        }

        @keyframes article-table-hint {
            from,
            95% {
                mask-image: linear-gradient(to right, #000 calc(100% - 3rem), transparent);
            }

            to {
                mask-image: none;
            }
        }
    }

    .article-table-scroll:focus-visible {
        /* The fade mask would clip the focus ring. */
        animation-name: none;
        outline: 2px solid var(--color-blue-500);
        outline-offset: 4px;
    }

    .article-prose table {
        border-collapse: separate;
        border-spacing: 0;
        font-size: 0.875rem;
        line-height: 1.55;
        width: 100%;
    }

    .article-prose th,
    .article-prose td {
        min-width: 9rem;
        padding: 0.9rem 1.1rem;
        text-align: left;
        vertical-align: top;
    }

    .article-prose :is(th, td)[align="right"] {
        font-variant-numeric: tabular-nums;
        text-align: right;
    }

    .article-prose td {
        border-top: 1px solid var(--color-gray-100);
        color: var(--color-gray-700);
        transition: background-color 160ms ease;
    }

    .article-prose tbody tr:nth-child(even) td {
        background: var(--color-surface-muted);
    }

    @media (hover: hover) {
        .article-prose tbody tr:hover td {
            background: color-mix(in srgb, var(--color-blue-50) 60%, white);
        }
    }

    .article-prose td:first-child {
        color: var(--color-gray-900);
        font-weight: 600;
    }

    .article-prose thead th {
        background: var(--color-blue-500);
        color: var(--color-snow-50);
        font-size: 0.8125rem;
        font-weight: 500;
        letter-spacing: 0.01em;
    }

    .article-prose td strong {
        font-weight: 600;
    }

    .article-prose thead th :is(strong, a, a:hover) {
        color: inherit;
    }

    .article-prose td :not(pre) > code {
        background: var(--color-snow-50);
        box-shadow: inset 0 0 0 1px var(--color-gray-200);
    }

    .article-prose td code {
        white-space: nowrap;
    }

    .article-prose tbody tr:last-child:has(strong) td {
        background: var(--color-blue-50);
        border-top: 1px solid var(--color-blue-100);
        color: var(--color-gray-900);
    }

    @media (prefers-reduced-motion: reduce) {
        .article-prose td {
            transition: none;
        }
    }

    .article-prose hr {
        border: 0;
        border-top: 1px solid var(--color-gray-200);
        margin-block: 2.5rem;
    }
</style>
