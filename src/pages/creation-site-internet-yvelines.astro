---
import SeoServicePage from "@/components/SeoServicePage.astro";
import { getServiceBySlug } from "@/data/services";

export const prerender = true;

const service = getServiceBySlug("creation-site-internet-yvelines");

if (!service) {
    throw new Error("Service not found: creation-site-internet-yvelines");
}
---

<SeoServicePage
    service={service}
    canonicalPath="/creation-site-internet-yvelines/"
/>
