---
import CalButton from "@/components/CalButton.astro";
import FadeReveal from "@/components/animations/FadeReveal.astro";
import FadeRevealOnScroll from "@/components/animations/FadeRevealOnScroll.astro";
import PricingComparison from "@/components/PricingComparison.astro";
import CheckIcon from "@/components/icons/nucleo/check-2-outline.svg";
import CodeEditor from "@/components/icons/nucleo/code-editor-fill.svg";
import Target from "@/components/icons/nucleo/target-fill.svg";
import ViewAll from "@/components/icons/nucleo/view-all-fill.svg";
import WindowLayout from "@/components/icons/nucleo/window-layout-fill.svg";
import WindowPaintbrush from "@/components/icons/nucleo/window-paintbrush-fill.svg";
import WindowPointer from "@/components/icons/nucleo/window-pointer-fill.svg";
import { projects } from "@/data/projects";
import { type IconTone, iconToneClasses } from "@/lib/iconTones";
import Layout from "@/layout/Layout.astro";

export const prerender = true;

type ProjectFormat = {
    icon: "code" | "landing" | "multipage" | "onepage" | "refonte" | "cms";
    title: string;
    text: string;
    tone: IconTone;
};

const projectFormats: ProjectFormat[] = [
    {
        icon: "landing",
        tone: "blue",
        title: "Landing page",
        text: "Une page centrée sur une offre, une campagne ou une prise de rendez-vous.",
    },
    {
        icon: "onepage",
        tone: "sky",
        title: "Site vitrine one-page",
        text: "Un parcours court pour présenter une activité simple et faciliter le contact.",
    },
    {
        icon: "multipage",
        tone: "violet",
        title: "Site vitrine multipage",
        text: "Plusieurs pages pour détailler les services, les preuves, la méthode et les contenus utiles.",
    },
    {
        icon: "cms",
        tone: "slate",
        title: "Site administrable",
        text: "Un site avec CMS pour publier projets, articles, prestations ou témoignages après la mise en ligne.",
    },
    {
        icon: "refonte",
        tone: "cyan",
        title: "Refonte",
        text: "Un travail sur l'existant : structure, contenus, design, performance, migration et redirections.",
    },
    {
        icon: "code",
        tone: "indigo",
        title: "Mission front-end",
        text: "Une intervention ciblée pour intégrer, corriger ou faire évoluer une interface web.",
    },
];

const priceFactors = [
    "nombre de pages et complexité des parcours",
    "qualité des contenus fournis au départ",
    "besoin de cadrage, rédaction ou restructuration",
    "design sur mesure, animations et états d'interface",
    "CMS administrable ou fonctionnalités spécifiques",
    "formulaires, intégrations externes et suivi de conversion",
    "reprise d'un ancien site, migration et redirections",
    "urgence, disponibilité des retours et validations",
];

const included = [
    "cadrage du besoin et des objectifs",
    "structure des pages et hiérarchie des contenus",
    "design responsive",
    "développement front-end",
    "SEO technique initial",
    "performance et accessibilité de base",
    "formulaire ou action de contact",
    "mise en ligne et vérifications",
];

const afterCosts = [
    "nom de domaine",
    "hébergement",
    "outils tiers ou CMS",
    "maintenance et corrections",
    "évolutions de contenu",
    "nouvelles pages ou fonctionnalités",
];

const aiBudgetPoints = [
    "audit de votre situation et de vos freins réels",
    "choix de structure, de messages et de parcours",
    "direction design avant génération ou exécution",
    "contrôle humain sur le code, le responsive et la mise en ligne",
];
---

<Layout
    title="Budget d'un site web freelance - William De Azevedo"
    description="Comprendre ce qui fait varier le budget d'un site vitrine, d'une refonte ou d'une mission front-end freelance selon les freins à lever."
>
    <div class="mx-auto flex w-full max-w-5xl flex-col gap-12 px-4 py-12 md:gap-16 md:py-16">
        <FadeReveal delay={0.1}>
            <section class="mx-auto flex max-w-4xl flex-col items-center gap-5 text-center">
                <h1 class="page-heading">
                    Le bon budget dépend surtout du problème à résoudre
                </h1>
                <p class="page-subheading max-w-sm sm:max-w-lg">
                    Un site lent, flou ou daté n'a pas toujours besoin d'une
                    refonte complète. Le prix dépend du vrai périmètre : contenu,
                    design, autonomie attendue, technique et priorités à traiter.
                </p>
                <CalButton
                    class="rounded-xl text-base font-normal"
                    label="Estimer mon budget"
                    location="tarifs-hero"
                />
            </section>
        </FadeReveal>

        <PricingComparison />

        <section class="flex flex-col gap-8" aria-labelledby="formats-title">
            <FadeRevealOnScroll>
                <div class="mx-auto flex max-w-3xl flex-col items-center gap-4 text-center">
                    <h2 id="formats-title" class="section-heading">
                        Six formats de projet, un même cadrage
                    </h2>
                    <p class="section-subheading">
                        Le format ne se choisit pas au catalogue : il découle de
                        votre offre, de vos contenus et de l'autonomie attendue
                        après la mise en ligne.
                    </p>
                </div>
            </FadeRevealOnScroll>
            <div class="grid gap-4 md:grid-cols-3">
                {
                    projectFormats.map((format, index) => (
                        <FadeRevealOnScroll
                            class="flex"
                            delay={0.05 + (index % 3) * 0.06}
                        >
                            <article class="flex w-full flex-col rounded-xl bg-snow-50 p-5 ring-1 ring-snow-600">
                                <span
                                    class:list={[
                                        "mb-4 inline-flex size-9 items-center justify-center rounded-lg text-snow-50",
                                        iconToneClasses[format.tone],
                                    ]}
                                    aria-hidden="true"
                                >
                                    {format.icon === "landing" && (
                                        <Target class="size-5" />
                                    )}
                                    {format.icon === "onepage" && (
                                        <WindowPointer class="size-5" />
                                    )}
                                    {format.icon === "multipage" && (
                                        <WindowLayout class="size-5" />
                                    )}
                                    {format.icon === "cms" && (
                                        <ViewAll class="size-5" />
                                    )}
                                    {format.icon === "refonte" && (
                                        <WindowPaintbrush class="size-5" />
                                    )}
                                    {format.icon === "code" && (
                                        <CodeEditor class="size-5" />
                                    )}
                                </span>
                                <h3 class="mb-2 text-lg font-normal leading-tight text-gray-900">
                                    {format.title}
                                </h3>
                                <p class="text-base font-normal leading-relaxed text-gray-600">
                                    {format.text}
                                </p>
                            </article>
                        </FadeRevealOnScroll>
                    ))
                }
            </div>
        </section>

        <FadeRevealOnScroll>
            <section class="grid gap-6 md:grid-cols-[0.85fr_1.15fr] md:items-start md:gap-12">
                <div class="flex flex-col gap-4">
                    <h2 class="section-heading text-left">
                        Ce qui fait varier le devis
                    </h2>
                    <p class="text-base font-normal leading-relaxed text-gray-600">
                        Deux sites vitrines peuvent avoir le même nombre de pages
                        et demander un travail très différent. Le cadrage sert à
                        éviter les angles morts et à identifier les freins
                        prioritaires avant de chiffrer.
                    </p>
                </div>
                <ul class="grid gap-3 sm:grid-cols-2">
                    {
                        priceFactors.map((factor) => (
                            <li class="rounded-xl bg-gray-100 px-4 py-3 text-base font-normal leading-relaxed text-gray-700 ring-1 ring-gray-200">
                                {factor}
                            </li>
                        ))
                    }
                </ul>
            </section>
        </FadeRevealOnScroll>

        <FadeRevealOnScroll>
            <section class="grid gap-6 rounded-4xl bg-gray-100 p-6 ring-1 ring-gray-200 md:grid-cols-[0.9fr_1.1fr] md:gap-12 md:p-8">
                <div class="flex flex-col gap-4">
                    <h2 class="section-heading text-left">
                        Vous ne payez pas une génération de pages
                    </h2>
                    <p class="text-base font-normal leading-relaxed text-gray-600">
                        Un site généré sans réflexion peut sembler moins cher,
                        mais il laisse souvent les vrais problèmes intacts : offre
                        floue, design générique, parcours hésitant, technique
                        fragile. Le devis couvre le cadrage, les choix et la
                        vérification, pas seulement la production d'écrans.
                    </p>
                    <a
                        class="w-fit text-base font-normal text-gray-900 underline decoration-gray-300 underline-offset-4 transition-colors hover:text-blue-500 focus-visible:text-blue-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                        href="/services/"
                    >
                        Voir les services associés
                    </a>
                </div>
                <ul class="grid gap-3">
                    {
                        aiBudgetPoints.map((point) => (
                            <li class="flex items-center gap-3 rounded-xl bg-snow-50 px-4 py-3 text-base font-normal leading-relaxed text-gray-700 ring-1 ring-snow-600">
                                <span
                                    class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-500"
                                    aria-hidden="true"
                                >
                                    <CheckIcon class="size-4" />
                                </span>
                                <span>{point}</span>
                            </li>
                        ))
                    }
                </ul>
            </section>
        </FadeRevealOnScroll>

        <section class="grid gap-4 md:grid-cols-2">
            <FadeRevealOnScroll class="flex">
                <article class="w-full rounded-xl bg-snow-50 p-6 ring-1 ring-snow-600">
                    <h2 class="mb-4 text-2xl font-normal leading-tight text-gray-900">
                        Ce qui est généralement compris
                    </h2>
                    <ul class="flex flex-col gap-3">
                        {
                            included.map((item) => (
                                <li class="flex items-center gap-3 text-base font-normal leading-relaxed text-gray-600">
                                    <span
                                        class="flex size-8 shrink-0 items-center justify-center rounded-xl bg-snow-50 text-emerald-500 shadow-[0_14px_32px_-24px_rgba(34,42,55,0.55)] ring-1 ring-gray-200/70"
                                        aria-hidden="true"
                                    >
                                        <CheckIcon class="size-4" />
                                    </span>
                                    <span>{item}</span>
                                </li>
                            ))
                        }
                    </ul>
                </article>
            </FadeRevealOnScroll>
            <FadeRevealOnScroll class="flex" delay={0.08}>
                <article class="w-full rounded-xl bg-snow-50 p-6 ring-1 ring-snow-600">
                    <h2 class="mb-4 text-2xl font-normal leading-tight text-gray-900">
                        Les coûts à prévoir après la livraison
                    </h2>
                    <ul class="flex flex-col gap-3">
                        {
                            afterCosts.map((item) => (
                                <li class="flex items-center gap-3 text-base font-normal leading-relaxed text-gray-600">
                                    <span
                                        class="size-1.5 shrink-0 rounded-full bg-gray-300"
                                        aria-hidden="true"
                                    />
                                    <span>{item}</span>
                                </li>
                            ))
                        }
                    </ul>
                    <p class="mt-5 text-sm font-normal leading-relaxed text-gray-500">
                        Ces postes restent à votre nom : vous gardez la main sur
                        votre domaine, votre hébergement et vos outils.
                    </p>
                </article>
            </FadeRevealOnScroll>
        </section>

        <FadeRevealOnScroll>
            <section class="flex flex-col gap-6">
                <div class="flex max-w-lg flex-col gap-4">
                    <h2 class="section-heading text-left">
                        Exemples de complexité
                    </h2>
                    <p class="text-base font-normal leading-relaxed text-gray-600">
                        Les réalisations donnent un repère plus utile qu'un prix
                        sorti de son contexte.
                    </p>
                </div>
                <div class="grid gap-4 md:grid-cols-3">
                    {
                        projects.map((project) => (
                            <article class="flex flex-col rounded-xl bg-gray-100 p-5 ring-1 ring-gray-200 transition-transform duration-300 ease-out hover:-translate-y-1">
                                <h3 class="mb-2 text-lg font-normal leading-tight text-gray-900">
                                    {project.title}
                                </h3>
                                <p class="text-base font-normal leading-relaxed text-gray-600">
                                    {project.summary}
                                </p>
                                <a
                                    class="mt-4 inline-flex text-sm font-normal text-gray-900 underline decoration-gray-300 underline-offset-4 transition-colors hover:text-blue-500 focus-visible:text-blue-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                                    href={`/realisations/${project.id}/`}
                                >
                                    Voir le contexte
                                </a>
                            </article>
                        ))
                    }
                </div>
            </section>
        </FadeRevealOnScroll>
    </div>

    <div class="mx-auto w-full max-w-5xl px-4 pb-12 md:pb-16">
        <FadeRevealOnScroll>
            <section class="relative left-1/2 isolate w-[calc(100dvw-1rem)] -translate-x-1/2 overflow-hidden rounded-4xl bg-coffee-300 py-12 text-snow-50 sm:w-[calc(100dvw-2rem)] md:py-16">
                <div class="relative z-10 mx-auto flex max-w-4xl flex-col items-center gap-4 px-4 text-center sm:px-8 md:gap-6">
                    <h2 class="section-heading section-heading--inverse max-w-4xl">
                        Le plus simple : cadrer le problème avant de parler budget
                    </h2>
                    <p class="section-subheading section-subheading--inverse max-w-3xl">
                        En 15 minutes, on peut déjà vérifier les freins
                        prioritaires, le type de projet et la prochaine étape
                        pertinente.
                    </p>
                    <CalButton
                        class="mt-2 rounded-xl text-base font-normal"
                        label="Demander un devis gratuit"
                        location="tarifs-final"
                        variant="light"
                    />
                </div>
            </section>
        </FadeRevealOnScroll>
    </div>
</Layout>
