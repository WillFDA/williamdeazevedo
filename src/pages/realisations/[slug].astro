---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import FadeReveal from "@/components/animations/FadeReveal.astro";
import FadeRevealOnScroll from "@/components/animations/FadeRevealOnScroll.astro";
import ChevronLeft from "@/components/icons/nucleo/chevron-left-fill.svg";
import GlobeIcon from "@/components/icons/nucleo/globe-outline.svg";
import MediaPause from "@/components/icons/nucleo/media-pause-fill.svg";
import MediaPlay from "@/components/icons/nucleo/media-play-fill.svg";
import ReadingProgress from "@/components/ReadingProgress.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import WaveIcon from "@/components/ui/WaveIcon.astro";
import WaveText from "@/components/ui/WaveText.astro";
import { getProjectById } from "@/data/projects";
import Layout from "@/layout/Layout.astro";

export const prerender = true;

export async function getStaticPaths() {
    const realisations = await getCollection("realisations");

    return realisations.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

interface Props {
    entry: CollectionEntry<"realisations">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { gallery, projectId, siteLabel } = entry.data;

const project = getProjectById(projectId);

if (!project) {
    throw new Error(`Projet introuvable pour ${entry.id}`);
}

const title = project.title;
const description = project.summary;
const siteUrl = project.href;

const galleryItems = [...(project.gallery ?? []), ...gallery];
const tocItems = [
    ...(project.media.type === "video"
        ? [{ depth: 2, slug: "apercu-du-projet", text: "Aperçu du projet" }]
        : []),
    ...headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3),
    ...(galleryItems.length > 0
        ? [{ depth: 2, slug: "captures-du-projet", text: "Captures du projet" }]
        : []),
];

const site = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(`/realisations/${entry.id}/`, site);

const creativeWorkJsonLd = {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: title,
    headline: title,
    description,
    inLanguage: "fr-FR",
    url: canonicalUrl.href,
    mainEntityOfPage: canonicalUrl.href,
    workExample: siteUrl,
    creator: {
        "@type": "Person",
        "@id": new URL("/#person", site).href,
        name: "William De Azevedo",
        url: site.href,
    },
};

const breadcrumbJsonLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Accueil",
            item: site.href,
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Réalisations",
            item: new URL("/realisations/", site).href,
        },
        {
            "@type": "ListItem",
            position: 3,
            name: title,
            item: canonicalUrl.href,
        },
    ],
};
---

<Layout
    title={`${title} : étude de cas - William De Azevedo`}
    description={project.seoDescription ?? description}
>
    <ReadingProgress />

    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(creativeWorkJsonLd)}
    />
    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(breadcrumbJsonLd)}
    />

    <main
        class="mx-auto w-full max-w-7xl px-4 py-12 md:px-6 md:py-16"
        data-reading-progress-root
    >
        <FadeReveal delay={0.16}>
            <header class="mx-auto mt-10 flex max-w-4xl flex-col items-center gap-5 text-center">
                <a
                    class="group mb-2 inline-flex min-h-11 items-center gap-3 rounded-xl px-1 text-sm font-normal text-gray-600 no-underline transition-colors hover:text-gray-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500 md:text-base"
                    href="/realisations/"
                >
                    <ChevronLeft
                        class="size-4 transition-transform group-hover:-translate-x-0.5"
                        aria-hidden="true"
                    />
                    <span>Revenir en arrière</span>
                </a>
                <h1 class="max-w-4xl text-5xl font-medium leading-none tracking-normal text-gray-900 md:text-6xl">
                    {title}
                </h1>
                <p class="max-w-2xl text-base font-normal leading-7 text-gray-600 md:text-lg md:leading-8">
                    {description}
                </p>
                {siteUrl && (
                    <a
                        class="group relative isolate mt-2 inline-flex min-h-14 items-center justify-center gap-4 overflow-hidden rounded-xl bg-snow-50 px-6 py-3 text-base font-normal text-gray-900 no-underline shadow-[0_12px_30px_-24px_rgba(34,42,55,0.5)] transition-transform hover:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                        href={siteUrl}
                        rel="noreferrer"
                        target="_blank"
                    >
                        <WaveText text={siteLabel} trigger="parent" />
                        <WaveIcon
                            style="--wui-wave-icon-size: 1.1rem;"
                            direction="up"
                            trigger="parent"
                        >
                            <GlobeIcon class="size-full" aria-hidden="true" />
                        </WaveIcon>
                    </a>
                )}
            </header>
        </FadeReveal>

        <section class="realisation-body-shell mx-auto mt-14 grid max-w-7xl gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,46rem)_minmax(13rem,17rem)] lg:gap-12">
            <div class="hidden lg:block" aria-hidden="true"></div>

            <article class="realisation-story min-w-0">
                {project.media.type === "video" && (
                    <FadeReveal delay={0.24}>
                        <section id="apercu-du-projet" class="scroll-mt-28">
                            <h2 class="sr-only">Aperçu du projet</h2>
                            <figure
                                class="realisation-video-player relative overflow-hidden rounded-3xl shadow-[0_24px_70px_-54px_rgba(34,42,55,0.5)]"
                                data-realisation-video-player
                                data-playing="false"
                            >
                                <video
                                    muted
                                    playsinline
                                    preload="metadata"
                                    poster={project.media.poster}
                                    aria-label={`Vidéo du projet ${project.title}`}
                                    class="aspect-video w-full object-cover"
                                    data-realisation-video
                                >
                                    <source src={project.media.src} type="video/mp4" />
                                </video>
                                <button
                                    class="realisation-video-player__button"
                                    type="button"
                                    aria-label={`Lire la vidéo du projet ${project.title}`}
                                    data-realisation-video-toggle
                                >
                                    <MediaPlay
                                        class="size-5"
                                        aria-hidden="true"
                                        data-realisation-play-icon
                                    />
                                    <MediaPause
                                        class="size-5"
                                        aria-hidden="true"
                                        data-realisation-pause-icon
                                    />
                                </button>
                            </figure>
                        </section>
                    </FadeReveal>
                )}

                <FadeReveal delay={0.3}>
                    <div class="realisation-prose mt-12">
                        <Content />
                    </div>
                </FadeReveal>

                {galleryItems.length > 0 && (
                    <section id="captures-du-projet" class="mt-12 scroll-mt-28">
                        <h2 class="realisation-section-title">
                            Captures du projet
                        </h2>
                        <div class="mt-5 grid gap-6">
                            {galleryItems.map((item, index) => (
                                <FadeRevealOnScroll>
                                    <figure class="overflow-hidden rounded-3xl shadow-[0_20px_60px_-54px_rgba(34,42,55,0.42)]">
                                        <img
                                            src={item.src}
                                            alt={item.alt}
                                            class="w-full object-cover"
                                            loading={index === 0 ? "eager" : "lazy"}
                                            decoding="async"
                                        />
                                    </figure>
                                </FadeRevealOnScroll>
                            ))}
                        </div>
                    </section>
                )}
            </article>

            <aside class="realisation-toc-column order-first lg:order-none">
                <TableOfContents items={tocItems} />
            </aside>
        </section>
    </main>
</Layout>

<script>
    const syncRealisationVideoPlayer = (
        player: HTMLElement,
        video: HTMLVideoElement,
        button: HTMLButtonElement,
    ) => {
        const isPlaying = !video.paused && !video.ended;

        player.dataset.playing = isPlaying ? "true" : "false";
        button.setAttribute(
            "aria-label",
            isPlaying ? "Mettre la vidéo en pause" : "Lire la vidéo",
        );
    };

    const initRealisationVideoPlayers = () => {
        document
            .querySelectorAll<HTMLElement>("[data-realisation-video-player]")
            .forEach((player) => {
                if (player.dataset.videoPlayerReady === "true") return;

                const video = player.querySelector<HTMLVideoElement>(
                    "[data-realisation-video]",
                );
                const button = player.querySelector<HTMLButtonElement>(
                    "[data-realisation-video-toggle]",
                );

                if (!video || !button) return;

                player.dataset.videoPlayerReady = "true";

                button.addEventListener("click", async () => {
                    if (video.paused || video.ended) {
                        try {
                            await video.play();
                        } catch {
                            syncRealisationVideoPlayer(player, video, button);
                        }
                    } else {
                        video.pause();
                    }
                });

                video.addEventListener("play", () =>
                    syncRealisationVideoPlayer(player, video, button),
                );
                video.addEventListener("pause", () =>
                    syncRealisationVideoPlayer(player, video, button),
                );
                video.addEventListener("ended", () =>
                    syncRealisationVideoPlayer(player, video, button),
                );

                syncRealisationVideoPlayer(player, video, button);
            });
    };

    const realisationVideoWindow = window as Window & {
        __wuiRealisationVideoPlayersReady?: boolean;
    };

    initRealisationVideoPlayers();

    if (!realisationVideoWindow.__wuiRealisationVideoPlayersReady) {
        realisationVideoWindow.__wuiRealisationVideoPlayersReady = true;
        document.addEventListener(
            "astro:page-load",
            initRealisationVideoPlayers,
        );
    }
</script>

<style is:global>
    .realisation-video-player__button {
        align-items: center;
        backdrop-filter: blur(16px);
        background: rgba(34, 42, 55, 0.82);
        border: 0;
        border-radius: 999em;
        bottom: 1rem;
        box-shadow:
            inset 0 1px rgba(255, 255, 255, 0.16),
            0 18px 38px -24px rgba(14, 20, 32, 0.62);
        color: var(--color-snow-50);
        display: inline-flex;
        height: 3.25rem;
        justify-content: center;
        left: 1rem;
        position: absolute;
        transition:
            background-color 180ms ease,
            transform 220ms var(--wui-ease-standard, cubic-bezier(0.2, 0, 0, 1));
        width: 3.25rem;
        z-index: 2;
    }

    .realisation-video-player__button:focus-visible {
        outline: 2px solid var(--color-blue-500);
        outline-offset: 4px;
    }

    .realisation-video-player[data-playing="false"]
        [data-realisation-pause-icon],
    .realisation-video-player[data-playing="true"] [data-realisation-play-icon] {
        display: none;
    }

    @media (hover: hover) {
        .realisation-video-player__button:hover {
            background: rgba(34, 42, 55, 0.92);
            transform: scale(0.96);
        }
    }

    .realisation-toc-column {
        align-self: start;
    }

    .realisation-section-title {
        color: var(--color-gray-900);
        font-size: 1.25rem;
        font-weight: 500;
        line-height: 1.35;
    }

    .realisation-prose {
        color: var(--color-gray-600);
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.75;
    }

    .realisation-prose > * + * {
        margin-top: 1.1rem;
    }

    .realisation-prose h2 {
        color: var(--color-gray-900);
        font-size: 1.25rem;
        font-weight: 500;
        line-height: 1.35;
        margin-top: 2.5rem;
        scroll-margin-top: 7rem;
    }

    .realisation-prose strong {
        color: var(--color-gray-900);
        font-weight: 500;
    }

    .realisation-prose a {
        color: inherit;
        text-decoration: underline;
        text-decoration-color: var(--color-gray-300);
        text-underline-offset: 2px;
        transition: color 200ms ease;
    }

    @media (hover: hover) {
        .realisation-prose a:hover {
            color: var(--color-gray-900);
        }
    }

    .realisation-prose ul,
    .realisation-prose ol {
        padding-left: 1.25rem;
    }

    .realisation-prose ul {
        list-style: disc;
    }

    .realisation-prose ol {
        list-style: decimal;
    }

    .realisation-prose li + li {
        margin-top: 0.35rem;
    }

    @media (min-width: 1024px) {
        .realisation-toc-column {
            position: sticky;
            top: 7.5rem;
        }
    }

    @media (scripting: none) {
        .realisation-video-player__button {
            display: none;
        }
    }
</style>
