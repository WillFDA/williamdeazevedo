---
import PricingComparison from "@/components/PricingComparison.astro";
import SeoServicePage from "@/components/SeoServicePage.astro";
import { getServiceBySlug } from "@/data/services";

export const prerender = true;

const service = getServiceBySlug("creation-site-vitrine");

if (!service) {
    throw new Error("Service not found: creation-site-vitrine");
}
---

<SeoServicePage service={service} canonicalPath="/creation-site-vitrine/">
    <PricingComparison slot="after-cta" />
</SeoServicePage>
