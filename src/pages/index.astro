---
import Layout from "../layout/Layout.astro";
import FadeReveal from "../components/animations/FadeReveal.astro";
import AboutCallout from "../components/AboutCallout.astro";
import CapabilitiesStrip from "../components/CapabilitiesStrip.astro";
import ExpertiseShowcase from "../components/ExpertiseShowcase.astro";
import FaqSection from "../components/FaqSection.astro";
import LatestArticles from "../components/LatestArticles.astro";
import PricingPreview from "../components/PricingPreview.astro";
import ProblemComparison from "../components/ProblemComparison.astro";
import ProjectShowcase from "../components/ProjectShowcase.astro";
import TestimonialsSection from "../components/TestimonialsSection.astro";
import ArrowRight from "../components/icons/nucleo/arrow-right-fill.svg";
import SearchContent from "../components/icons/nucleo/search-content-2-fill.svg";
import Star from "../components/icons/nucleo/star-fill.svg";
import { Image } from "astro:assets";
import WaveIcon from "../components/ui/WaveIcon.astro";
import WaveText from "../components/ui/WaveText.astro";
import AnimatedHeading from "../components/ui/AnimatedHeading.astro";
import { getPublishedTestimonials } from "@/lib/testimonials";

export const prerender = true;

const heroTitleParts = [
    { text: "Je" },
    { text: "crée" },
    { text: "des" },
    { pill: true, text: "sites web" },
    { text: "et" },
    { text: "des" },
    { pill: true, text: "interfaces" },
    { text: "rapides," },
    { text: "accessibles" },
    { text: "et" },
    { text: "pensés" },
    { text: "pour" },
    { text: "inspirer" },
    { text: "confiance." },
];

const expertiseItems = [
    {
        id: "creation",
        label: "Création site vitrine",
        icon: "site",
        title: "Construire une présence claire et crédible",
        description: [
            "Je pars de votre offre, de vos contenus et des objections de vos prospects pour créer un site qui se comprend vite.",
            "L'objectif : transformer une première impression fragile en parcours rassurant, rapide et orienté contact.",
        ],
        pills: [
            "Architecture des pages",
            "Design responsive",
            "SEO technique",
            "Mise en ligne",
        ],
    },
    {
        id: "refonte",
        label: "Refonte web",
        icon: "refresh",
        title: "Repenser ce qui freine votre site actuel",
        description: [
            "Je vous aide à repérer ce qui crée du doute : message confus, hiérarchie faible, mobile pénible, lenteur ou design daté.",
            "On garde ce qui fonctionne, on retire ce qui brouille le parcours et on reconstruit une base plus lisible.",
        ],
        pills: [
            "Audit rapide",
            "UX mobile",
            "Performance",
            "Redirections utiles",
        ],
    },
    {
        id: "front-end",
        label: "Renfort front-end",
        icon: "code",
        title: "Intégrer et faire évoluer vos interfaces",
        description: [
            "J'interviens comme renfort autonome pour transformer des maquettes ou écrans existants en interfaces propres et maintenables.",
            "Le regard reste autant front-end que produit : responsive, accessibilité, performance, états d'interface et détails visuels.",
        ],
        pills: [
            "Intégration Figma",
            "React / Next.js",
            "Accessibilité",
            "Développement IA",
            "DevOps mise en ligne",
        ],
    },
    {
        id: "audit-ux",
        label: "Audit UX",
        icon: "ux",
        title: "Clarifier les points de friction avant de construire",
        description: [
            "Je relis votre parcours, vos pages clés et vos messages pour voir où un visiteur hésite, décroche ou ne comprend pas la suite.",
            "Vous repartez avec des priorités concrètes : quoi clarifier, quoi supprimer, quoi améliorer en premier.",
        ],
        pills: [
            "Parcours utilisateur",
            "Clarté de l'offre",
            "Hiérarchie visuelle",
            "Actions prioritaires",
        ],
    },
    {
        id: "performance",
        label: "Performance web",
        icon: "performance",
        title: "Rendre votre site plus rapide et plus stable",
        description: [
            "J'optimise les pages qui comptent : poids des assets, structure front-end, rendu mobile et points bloquants côté expérience.",
            "Un site plus rapide est aussi un site plus rassurant : il donne moins de raisons de partir avant d'avoir compris l'offre.",
        ],
        pills: [
            "Core Web Vitals",
            "Images optimisées",
            "Chargement rapide",
            "Mobile first",
        ],
    },
    {
        id: "produit",
        label: "Accompagnement produit",
        icon: "site",
        title: "Faire évoluer l'interface avec une logique produit",
        description: [
            "Je vous aide à prioriser les évolutions utiles, à transformer les retours terrain en écrans concrets et à garder une interface cohérente.",
            "C'est un accompagnement pensé pour avancer vite sans accumuler des rustines qui rendent le produit moins clair.",
        ],
        pills: [
            "Priorisation",
            "Design produit",
            "Itérations rapides",
            "Base maintenable",
        ],
    },
] as const;

const displayedTestimonials = getPublishedTestimonials();
---

<Layout>
    <section
        class="mx-auto flex w-full min-w-0 max-w-5xl flex-col gap-6 px-2 sm:px-4"
        data-section-reveal="false"
    >
        <a
            aria-label="Avis Google : 5,0 sur 5 (nouvel onglet)"
            class="pill mx-auto max-w-full leading-tight no-underline transition-transform hover:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500 sm:text-base"
            data-hero-eyebrow
            href="https://share.google/LlCN4Hr5IlatyVSl2"
            rel="noreferrer"
            target="_blank"
        >
            <span>Avis Google</span>
            <span class="inline-flex items-center gap-1.5 rounded-xl bg-blue-500 px-2.5 py-1 font-medium text-snow-50">
                <Star aria-hidden="true" class="size-4 text-snow-50" />
                <span>5,0</span>
            </span>
        </a>
        <AnimatedHeading
            class="page-heading flex w-full max-w-sm flex-wrap justify-center gap-x-[0.18em] px-2 sm:max-w-4xl md:max-w-5xl"
            fade={false}
            parts={heroTitleParts}
        />
        <FadeReveal delay={0.32} fade={false}>
            <p
                class="page-subheading max-w-sm sm:max-w-lg"
            >
                J’aide les petites structures et les équipes produit à lancer
                des interfaces & sites performants, soignés et pensés pour le
                référencement naturel.
            </p>
        </FadeReveal>
        <FadeReveal delay={0.44} fade={false}>
            <div class="mx-auto mt-5 flex w-full max-w-sm flex-col items-center justify-center gap-3 sm:mt-7 sm:max-w-none sm:flex-row sm:gap-8">
                <button
                    aria-controls="cal-drawer"
                    aria-haspopup="dialog"
                    class="hero-button hero-button--primary flex min-h-14 w-full max-w-full items-center justify-center gap-5 rounded-xl px-8 py-3 text-base font-normal sm:w-auto sm:px-10"
                    data-cal-location="hero"
                    data-cal-open
                    type="button"
                    ><WaveText
                        text="Parlons de votre projet"
                        trigger="parent"
                    />
                    <WaveIcon
                        style="--wui-wave-icon-size: 1rem;"
                        direction="right"
                        trigger="parent"
                    >
                        <ArrowRight class="size-full" aria-hidden="true" />
                    </WaveIcon>
                </button>
                <a
                    class="hero-button hero-button--secondary flex min-h-14 w-full max-w-full items-center justify-center rounded-xl px-8 py-3 text-base font-normal sm:w-auto sm:px-10"
                    href="/services/"
                    ><WaveText
                        text="Découvrir mes services"
                        trigger="parent"
                    /></a
                >
            </div>
        </FadeReveal>
        <FadeReveal animate={false}>
            <div
                class="testimonial-rotator mx-auto mb-4 mt-0 text-center text-xs"
                data-testimonial-rotator
                data-testimonial-interval="5500"
            >
                {
                    displayedTestimonials.map((temoignage, index) => (
                        <figure
                            class:list={[
                                "testimonial-rotator__item",
                                index === 0 && "is-active",
                            ]}
                            data-testimonial-item
                            data-testimonial-initial={
                                index === 0 ? true : undefined
                            }
                            aria-hidden={index === 0 ? undefined : "true"}
                            inert={index === 0 ? undefined : true}
                        >
                            <blockquote class="mx-auto max-w-md text-base font-normal leading-normal text-gray-900">
                                “{temoignage.excerpt ?? temoignage.text}”
                            </blockquote>
                            <div class="testimonial-rotator__person flex items-center justify-center gap-3">
                                <div class="testimonial-rotator__avatar inline-flex size-10 items-center justify-center overflow-hidden rounded-full bg-snow-600 text-xs font-medium text-gray-900">
                                    {temoignage.image ? (
                                        <Image
                                            class="block size-full object-cover"
                                            src={temoignage.image}
                                            alt={temoignage.imageAlt ?? ""}
                                            width={64}
                                            height={64}
                                            loading={
                                                index === 0 ? "eager" : "lazy"
                                            }
                                        />
                                    ) : (
                                        <span>{temoignage.initials}</span>
                                    )}
                                </div>
                                <figcaption class="testimonial-rotator__author text-left text-sm font-medium leading-tight text-gray-900">
                                    <a
                                        class="text-inherit no-underline underline-offset-2 focus-visible:underline"
                                        href={temoignage.href}
                                        target="_blank"
                                        rel="noreferrer"
                                        aria-label={`Voir le site de ${temoignage.name}`}
                                    >
                                        {temoignage.name}
                                    </a>
                                </figcaption>
                            </div>
                        </figure>
                    ))
                }
            </div>
        </FadeReveal>
    </section>
    <CapabilitiesStrip />
    <ProblemComparison />
    <AboutCallout title="Hello moi c'est William, un développeur à la frontière du design !" />
    <div class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-8 md:py-16">
        <ExpertiseShowcase
            title="Ce que je corrige pour rendre un site plus convaincant"
            description="Chaque accompagnement part d'un frein concret : manque de clarté, expérience lente, design qui ne rassure plus ou interface difficile à faire évoluer."
            items={expertiseItems}
        />
        <div class="mt-12 flex justify-center">
            <button
                aria-controls="cal-drawer"
                aria-haspopup="dialog"
                class="expertise-cta inline-flex min-h-14 items-center justify-center gap-5 rounded-xl px-8 py-3 text-base font-normal focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-blue-500"
                data-cal-location="expertise"
                data-cal-open
                type="button"
            >
                <span>Trouver ce qui bloque</span>
                <WaveIcon
                    class="expertise-cta__icon"
                    direction="up"
                    trigger="parent"
                >
                    <SearchContent aria-hidden="true" />
                </WaveIcon>
            </button>
        </div>
    </div>
    <PricingPreview />
    <FaqSection title="Questions fréquentes" />
    <TestimonialsSection />
    <ProjectShowcase />
    <LatestArticles />
</Layout>

<script>
    type HomeInteractionState = {
        destroy: () => void;
    };

    const windowWithHomeInteractions = window as Window & {
        __wuiHomeInteractionLifecycleReady?: boolean;
        __wuiHomeInteractionStates?: Set<HomeInteractionState>;
    };
    const activeHomeInteractionStates =
        windowWithHomeInteractions.__wuiHomeInteractionStates ??
        new Set<HomeInteractionState>();
    windowWithHomeInteractions.__wuiHomeInteractionStates =
        activeHomeInteractionStates;

    function registerHomeInteractionCleanup(destroy: () => void) {
        const state: HomeInteractionState = {
            destroy: () => {
                if (!activeHomeInteractionStates.delete(state)) return;
                destroy();
            },
        };

        activeHomeInteractionStates.add(state);
    }

    function resetHomeInteractions() {
        Array.from(activeHomeInteractionStates).forEach((state) =>
            state.destroy(),
        );
    }

    const initTestimonialRotators = () => {
        document
            .querySelectorAll<HTMLElement>("[data-testimonial-rotator]")
            .forEach((root) => {
                if (root.dataset.testimonialRotatorReady === "true") return;

                const items = Array.from(
                    root.querySelectorAll<HTMLElement>(
                        "[data-testimonial-item]",
                    ),
                );

                if (items.length < 2) return;

                if (
                    window.matchMedia("(prefers-reduced-motion: reduce)").matches
                ) {
                    items.forEach((item, index) => {
                        const isActive = index === 0;
                        item.classList.toggle("is-active", isActive);
                        item.setAttribute("aria-hidden", String(!isActive));
                        item.toggleAttribute("inert", !isActive);
                    });
                    return;
                }

                const interval = Math.max(
                    1200,
                    Number.parseInt(root.dataset.testimonialInterval ?? "", 10) ||
                        5500,
                );
                let activeIndex = items.findIndex((item) =>
                    item.classList.contains("is-active"),
                );
                let hasAutoplayStarted = false;
                let isPausedByInteraction = false;
                let timeout: number | undefined;

                if (activeIndex < 0) activeIndex = 0;

                const setActiveItem = (nextIndex: number) => {
                    if (nextIndex !== 0) {
                        const initialItem = items[0];
                        if (initialItem) {
                            delete initialItem.dataset.testimonialInitial;
                        }
                    }

                    activeIndex = nextIndex;
                    items.forEach((item, index) => {
                        const isActive = index === activeIndex;

                        item.classList.toggle("is-active", isActive);
                        item.setAttribute("aria-hidden", String(!isActive));
                        // inert removes the hidden testimonial (and its link)
                        // from the a11y tree AND tab order, so aria-hidden no
                        // longer wraps a focusable descendant.
                        item.toggleAttribute("inert", !isActive);
                    });
                };

                const schedule = () => {
                    window.clearTimeout(timeout);
                    if (isPausedByInteraction) return;

                    timeout = window.setTimeout(() => {
                        if (!document.hidden) {
                            setActiveItem((activeIndex + 1) % items.length);
                        }

                        schedule();
                    }, interval);
                };

                const pause = () => {
                    isPausedByInteraction = true;
                    window.clearTimeout(timeout);
                };
                const resume = () => {
                    isPausedByInteraction = false;
                    if (hasAutoplayStarted) schedule();
                };
                const resumeAfterFocus = (event: FocusEvent) => {
                    if (
                        event.relatedTarget instanceof Node &&
                        root.contains(event.relatedTarget)
                    ) {
                        return;
                    }

                    resume();
                };
                // Un seul signal pour retirer d'un coup les trois écouteurs d'attente.
                const waitingForInteraction = new AbortController();
                const stopWaitingForInteraction = () =>
                    waitingForInteraction.abort();
                const startAutoplay = () => {
                    if (hasAutoplayStarted) return;

                    hasAutoplayStarted = true;
                    stopWaitingForInteraction();
                    schedule();
                };

                root.dataset.testimonialRotatorReady = "true";
                setActiveItem(activeIndex);
                root.addEventListener("focusin", pause);
                root.addEventListener("focusout", resumeAfterFocus);
                root.addEventListener("mouseenter", pause);
                root.addEventListener("mouseleave", resume);
                window.addEventListener("click", startAutoplay, {
                    signal: waitingForInteraction.signal,
                });
                window.addEventListener("keydown", startAutoplay, {
                    signal: waitingForInteraction.signal,
                });
                window.addEventListener("scroll", startAutoplay, {
                    passive: true,
                    signal: waitingForInteraction.signal,
                });
                registerHomeInteractionCleanup(() => {
                    window.clearTimeout(timeout);
                    stopWaitingForInteraction();
                    root.removeEventListener("focusin", pause);
                    root.removeEventListener("focusout", resumeAfterFocus);
                    root.removeEventListener("mouseenter", pause);
                    root.removeEventListener("mouseleave", resume);
                    delete root.dataset.testimonialRotatorReady;
                });
            });
    };

    initTestimonialRotators();

    if (windowWithHomeInteractions.__wuiHomeInteractionLifecycleReady !== true) {
        windowWithHomeInteractions.__wuiHomeInteractionLifecycleReady = true;
        document.addEventListener("astro:before-swap", resetHomeInteractions);
        document.addEventListener("astro:page-load", initTestimonialRotators);
    }
</script>

<style>
    [data-hero-eyebrow] {
        animation: hero-eyebrow-fade 780ms cubic-bezier(0.2, 0, 0, 1)
            backwards;
    }

    @keyframes hero-eyebrow-fade {
        from {
            filter: blur(8px);
            opacity: 0;
        }

        to {
            filter: none;
            opacity: 1;
        }
    }

    .testimonial-rotator {
        display: grid;
        min-height: 8.5rem;
        place-items: center;
        width: min(100%, 30rem);
    }

    .testimonial-rotator__item {
        align-items: center;
        display: flex;
        filter: blur(6px);
        flex-direction: column;
        gap: 1rem;
        grid-area: 1 / 1;
        opacity: 0;
        pointer-events: none;
        transform: translateY(0.35rem);
        transition:
            opacity 360ms cubic-bezier(0.2, 0, 0, 1),
            filter 520ms cubic-bezier(0.2, 0, 0, 1),
            transform 520ms cubic-bezier(0.2, 0, 0, 1);
        width: 100%;
    }

    .testimonial-rotator__item.is-active {
        filter: none;
        opacity: 1;
        pointer-events: auto;
        transform: none;
    }

    .testimonial-rotator__item.is-active blockquote,
    .testimonial-rotator__item.is-active .testimonial-rotator__person {
        animation: testimonial-content-in 920ms cubic-bezier(0.22, 1.16, 0.36, 1)
            backwards;
    }

    .testimonial-rotator__item.is-active blockquote {
        animation-delay: 120ms;
    }

    .testimonial-rotator__item.is-active .testimonial-rotator__person {
        animation-delay: 360ms;
    }

    .testimonial-rotator__item[data-testimonial-initial] {
        animation: testimonial-initial-card-in 440ms
            cubic-bezier(0.16, 1, 0.3, 1) both;
        transform-origin: 50% 35%;
    }

    .testimonial-rotator__item[data-testimonial-initial] blockquote {
        animation: testimonial-initial-copy-in 420ms
            cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .testimonial-rotator__item[data-testimonial-initial]
        .testimonial-rotator__person {
        animation: testimonial-initial-person-in 480ms
            cubic-bezier(0.16, 1, 0.3, 1) 60ms both;
    }

    .testimonial-rotator__item[data-testimonial-initial]
        .testimonial-rotator__avatar {
        animation: testimonial-initial-avatar-in 520ms
            cubic-bezier(0.22, 1.24, 0.36, 1) 90ms both;
    }

    .testimonial-rotator__item[data-testimonial-initial]
        .testimonial-rotator__author {
        animation: testimonial-initial-author-in 460ms
            cubic-bezier(0.16, 1, 0.3, 1) 130ms both;
    }

    @keyframes testimonial-initial-card-in {
        from {
            opacity: 0.78;
            transform: translateY(0.55rem) scale(0.992);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    @keyframes testimonial-initial-copy-in {
        from {
            transform: translateY(0.4rem);
        }

        to {
            transform: none;
        }
    }

    @keyframes testimonial-initial-person-in {
        from {
            opacity: 0.68;
            transform: translateY(0.5rem);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    @keyframes testimonial-initial-avatar-in {
        from {
            opacity: 0.72;
            transform: scale(0.84);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    @keyframes testimonial-initial-author-in {
        from {
            opacity: 0.72;
            transform: translateX(-0.35rem);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    @keyframes testimonial-content-in {
        from {
            filter: blur(8px);
            opacity: 0;
            transform: translateY(-0.65rem);
        }

        to {
            filter: none;
            opacity: 1;
            transform: none;
        }
    }

    @media (scripting: none), (prefers-reduced-motion: reduce) {
        [data-hero-eyebrow] {
            animation: none;
        }

        .testimonial-rotator__item {
            animation: none;
            transition: none;
        }

        .testimonial-rotator__avatar,
        .testimonial-rotator__author,
        .testimonial-rotator__person,
        .testimonial-rotator blockquote {
            animation: none;
        }

    }
    .expertise-cta {
        background: transparent;
        border: 0;
        color: var(--color-snow-50);
        isolation: isolate;
        overflow: hidden;
        position: relative;
    }

    .expertise-cta::before {
        background: var(--color-blue-500);
        border: 1px solid
            color-mix(in srgb, var(--color-blue-500) 70%, var(--color-blue-600));
        border-radius: inherit;
        box-shadow: inset 0 2px rgba(184, 200, 255, 0.18);
        content: "";
        inset: 0;
        position: absolute;
        transform: scale(1);
        transition: transform 520ms
            var(--wui-ease-standard, cubic-bezier(0.2, 0, 0, 1));
        z-index: -1;
    }

    .expertise-cta:focus-visible::before {
        transform: scale(0.95);
    }

    @media (hover: hover) {
        .expertise-cta:hover::before {
            transform: scale(0.95);
        }
    }

    .expertise-cta__icon {
        --wui-wave-icon-size: 1.25rem;

        color: var(--color-blue-100);
    }

    @media (prefers-reduced-motion: reduce) {
        .expertise-cta::before {
            transition: none;
        }
    }
</style>
