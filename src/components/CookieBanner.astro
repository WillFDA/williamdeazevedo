---
// Bandeau de consentement (CNIL) branché sur Consent Mode v2, mode basique :
// GTM n'est chargé qu'après un accord (src/scripts/consent.ts). Deux
// finalités séparées : mesure d'audience et publicité.

// Trois boutons de même taille et de même forme : « Tout refuser » et
// « Tout accepter » (même prééminence, exigence CNIL ; seule la couleur
// change) et « Personnaliser » (contour seul), qui ouvre le choix par
// finalité et cède sa place à « Enregistrer mes choix », même style.
// Sur mobile et en paysage (variante `wide` de global.css), bandeau compact
// (refuser et accepter côte à côte, plus bas) pour masquer le moins
// possible le hero.
const choiceClass =
    "hero-button flex min-h-10 w-full cursor-pointer items-center justify-center rounded-xl px-3 py-2 text-sm font-normal wide:min-h-14 wide:px-8 wide:py-3 wide:text-base";

const purposes = [
    {
        name: "analytics",
        label: "Mesure d'audience",
        description: "Google Analytics : pages vues et provenance.",
    },
    {
        name: "ads",
        label: "Publicité",
        description: "Google Ads : contacts issus des annonces, sans pub personnalisée.",
    },
];
---

<div
    id="cookie-banner"
    class="fixed inset-x-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 bottom-2 z-50 rounded-2xl border border-gray-200 bg-snow-50 p-2.5 text-[13px] wide:p-4 wide:text-sm text-gray-900 shadow-[0_24px_46px_-22px_rgba(14,23,37,0.45)] wide:right-auto wide:bottom-4 wide:left-4 wide:max-w-sm"
    role="dialog"
    aria-modal="false"
    aria-labelledby="cookie-banner-title"
    aria-describedby="cookie-banner-text"
    tabindex="-1"
    hidden
    transition:persist
>
    {/* Titre masqué visuellement sur mobile (bandeau plus bas), toujours lu. */}
    <h2 id="cookie-banner-title" class="sr-only text-sm font-medium wide:not-sr-only wide:text-base">Cookies</h2>
    <p id="cookie-banner-text" class="leading-snug text-gray-700 wide:mt-1 wide:leading-relaxed">
        <span aria-hidden="true" class="font-medium text-gray-900 wide:hidden">Cookies&nbsp;:{" "}</span>
        <span class="wide:hidden">avec</span><span class="hidden wide:inline">Avec</span> votre accord, des
        cookies Google mesurent l'audience et les contacts issus de nos
        annonces. Modifiable à tout moment.{" "}
        <a
            class="underline underline-offset-2 hover:text-gray-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
            href="/mentions-legales/#cookies">En savoir plus</a
        >
    </p>
    <fieldset
        id="cookie-purposes"
        class="mt-2 flex flex-col gap-1.5 wide:mt-3 wide:gap-2"
        data-cookie-purposes
        hidden
    >
        <legend class="sr-only">Choisir les cookies</legend>
        {
            purposes.map(({ name, label, description }) => (
                <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-transparent bg-surface-muted px-3 py-2 transition-colors hover:border-gray-300 has-checked:border-coffee-300">
                    <span class="min-w-0 flex-1 leading-snug">
                        <span class="block font-medium text-gray-900">{label}</span>
                        <span class="block text-gray-600">{description}</span>
                    </span>
                    {/* Vraie case native, redessinée : la coche suit :checked. */}
                    <span class="grid shrink-0 place-items-center">
                        <input
                            class="peer col-start-1 row-start-1 size-5 cursor-pointer appearance-none rounded-md border border-gray-400 bg-snow-50 transition-colors checked:border-coffee-300 checked:bg-coffee-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
                            type="checkbox"
                            name={name}
                            data-cookie-purpose={name}
                        />
                        <svg
                            class="pointer-events-none col-start-1 row-start-1 size-3.5 text-snow-50 opacity-0 peer-checked:opacity-100"
                            viewBox="0 0 16 16"
                            fill="none"
                            aria-hidden="true"
                        >
                            <path
                                d="M3.5 8.5l3 3 6-7"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                        </svg>
                    </span>
                </label>
            ))
        }
    </fieldset>
    <div class="mt-2 grid grid-cols-2 gap-1.5 wide:mt-4 wide:grid-cols-1 wide:gap-3">
        <button
            class:list={[choiceClass, "hero-button--secondary"]}
            type="button"
            data-cookie-choice="denied"
        >
            Tout refuser
        </button>
        <button
            class:list={[choiceClass, "hero-button--primary"]}
            type="button"
            data-cookie-choice="granted"
        >
            Tout accepter
        </button>
        <button
            class:list={[choiceClass, "hero-button--ghost col-span-2 wide:col-span-1"]}
            type="button"
            aria-expanded="false"
            aria-controls="cookie-purposes"
            data-cookie-customize
        >
            Personnaliser
        </button>
        <button
            class:list={[choiceClass, "hero-button--ghost col-span-2 wide:col-span-1"]}
            type="button"
            data-cookie-choice="custom"
            hidden
        >
            Enregistrer mes choix
        </button>
    </div>
</div>

<style is:global>
    /* Tant que le bandeau est affiché, le défilement au clavier garde
       l'élément focalisé au-dessus de lui (WCAG 2.4.11). */
    html:has(#cookie-banner:not([hidden])) {
        scroll-padding-bottom: 12rem;
    }
</style>

<script>
    import {
        readConsent,
        saveConsent,
        type ConsentChoice,
    } from "../scripts/consent";

    const bannerWindow = window as Window & {
        __wuiCookieBannerReady?: boolean;
    };

    const banner = () => document.getElementById("cookie-banner");
    let returnFocus: HTMLElement | null = null;

    const purposeInputs = (element: HTMLElement) =>
        element.querySelectorAll<HTMLInputElement>("[data-cookie-purpose]");

    // Affiche ou masque le détail par finalité, cases pré-remplies avec le
    // choix en cours (rien de coché par défaut : pas de case pré-cochée).
    const setCustomizing = (element: HTMLElement, customizing: boolean) => {
        const fieldset = element.querySelector<HTMLElement>("[data-cookie-purposes]");
        const toggle = element.querySelector<HTMLElement>("[data-cookie-customize]");
        const save = element.querySelector<HTMLElement>('[data-cookie-choice="custom"]');
        if (fieldset) fieldset.hidden = !customizing;
        if (save) save.hidden = !customizing;
        // « Personnaliser » cède sa place à « Enregistrer mes choix » une fois
        // le détail ouvert (le focus passe à la première case).
        if (toggle) {
            toggle.hidden = customizing;
            toggle.setAttribute("aria-expanded", String(customizing));
        }
        if (!customizing) return;
        const current = readConsent();
        for (const input of purposeInputs(element)) {
            const purpose = input.dataset.cookiePurpose as keyof ConsentChoice;
            input.checked = current?.[purpose] ?? false;
        }
    };

    const choiceFrom = (element: HTMLElement, kind: string | undefined) => {
        if (kind === "granted") return { analytics: true, ads: true };
        if (kind === "custom") {
            const choice: ConsentChoice = { analytics: false, ads: false };
            for (const input of purposeInputs(element)) {
                const purpose = input.dataset.cookiePurpose;
                if (purpose === "analytics" || purpose === "ads")
                    choice[purpose] = input.checked;
            }
            return choice;
        }
        return { analytics: false, ads: false };
    };

    const close = (element: HTMLElement) => {
        element.hidden = true;
        setCustomizing(element, false);
        // Premier choix : le focus revient au début du contenu, pas sur <body>.
        (returnFocus ?? document.getElementById("main-content"))?.focus({
            preventScroll: true,
        });
        returnFocus = null;
    };

    if (!bannerWindow.__wuiCookieBannerReady) {
        bannerWindow.__wuiCookieBannerReady = true;

        document.addEventListener("click", (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;
            const element = banner();
            if (!element) return;

            const choice = target.closest<HTMLElement>("[data-cookie-choice]");
            if (choice) {
                saveConsent(choiceFrom(element, choice.dataset.cookieChoice));
                close(element);
                return;
            }

            if (target.closest("[data-cookie-customize]")) {
                setCustomizing(element, true);
                element.querySelector<HTMLInputElement>("[data-cookie-purpose]")?.focus();
                return;
            }

            // « Gérer les cookies » : rouvre le bandeau avec le détail ouvert,
            // pour pouvoir retirer une seule finalité.
            const opener = target.closest<HTMLElement>("[data-cookie-settings]");
            if (!opener) return;
            returnFocus = opener;
            element.hidden = false;
            setCustomizing(element, true);
            element.focus();
        });

        // Se déclenche aussi au premier chargement ; ré-affiche le bandeau si
        // le choix a expiré pendant la navigation.
        document.addEventListener("astro:page-load", () => {
            const element = banner();
            if (element && !readConsent()) element.hidden = false;
        });
    }
</script>
