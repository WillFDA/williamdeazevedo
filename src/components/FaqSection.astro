---
import ArrowRight from "./icons/nucleo/arrow-right-fill.svg";
import Accordion from "./ui/Accordion.astro";
import WaveIcon from "./ui/WaveIcon.astro";
import WaveText from "./ui/WaveText.astro";

type FaqItem = {
    answer: string;
    link?: {
        href: string;
        label: string;
    };
    question: string;
};

interface Props {
    class?: string;
    ctaLabel?: string;
    ctaLocation?: string;
    description?: string;
    id?: string;
    items: readonly FaqItem[];
    padded?: boolean;
    showCta?: boolean;
    title?: string;
}

const {
    class: className,
    ctaLabel = "Parler de mon cas",
    ctaLocation = "faq",
    description,
    id = "faq",
    items,
    padded = true,
    showCta = true,
    title = "FAQ",
} = Astro.props;
const faqItems = Array.from(items);

const accordionClasses = {
    content:
        "px-5 pb-5 pr-14 text-base font-light leading-normal text-gray-600 sm:px-6 sm:pr-16",
    icon: "text-gray-900",
    item: "bg-gray-100 shadow-sm ring-1 ring-gray-200",
    summary:
        "px-5 py-4 text-base font-normal leading-tight text-gray-900 sm:px-6",
};
---

<section
    id={id}
    class:list={[
        "mx-auto w-full max-w-7xl py-12 md:py-16",
        padded ? "px-4 sm:px-8" : "px-0",
        className,
    ]}
    aria-labelledby={`${id}-title`}
>
    <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
        <h2 id={`${id}-title`} class="section-heading">{title}</h2>
        {
            description && (
                <p class="section-subheading mt-5 max-w-2xl">
                    {description}
                </p>
            )
        }
    </div>

    <Accordion
        class="mx-auto mt-12 max-w-4xl"
        items={faqItems}
        itemClass={accordionClasses.item}
        summaryClass={accordionClasses.summary}
        contentClass={accordionClasses.content}
        iconClass={accordionClasses.icon}
    />

    {
        showCta && (
            <div class="mt-10 flex justify-center">
                <button
                    aria-controls="cal-drawer"
                    aria-haspopup="dialog"
                    class="faq-cta inline-flex min-h-14 items-center justify-center gap-5 rounded-xl bg-coffee-300 px-8 py-3 text-base font-normal text-snow-50 shadow-lg transition-transform hover:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                    data-cal-location={ctaLocation}
                    data-cal-open
                    type="button"
                >
                    <WaveText text={ctaLabel} trigger="parent" />
                    <WaveIcon
                        style="--wui-wave-icon-size: 1rem;"
                        direction="right"
                        trigger="parent"
                    >
                        <ArrowRight class="size-full" aria-hidden="true" />
                    </WaveIcon>
                </button>
            </div>
        )
    }
</section>
