---
const calLink = String(
    import.meta.env.PUBLIC_CAL_LINK ?? "william-de-azevedo-rbyobm/15min",
)
    .replace(/^https?:\/\/(?:app\.)?cal\.com\//, "")
    .replace(/^\/+/, "")
    .replace(/\/+$/, "");
---

<dialog
    aria-label="Planifier un créneau"
    class="cal-drawer fixed overflow-hidden rounded-lg border-0 p-0 text-gray-900"
    data-cal-drawer
    id="cal-drawer"
    transition:persist
>
    <div class="cal-drawer__header flex items-center justify-end p-4">
        <button
            aria-label="Fermer"
            class="cal-drawer__close inline-flex size-11 items-center justify-center rounded-lg border-0 bg-gray-900/5 p-0 text-gray-900"
            data-cal-close
            type="button"
        >
            <svg
                aria-hidden="true"
                class="size-5"
                fill="none"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
            >
                <path
                    d="m6 6 12 12M18 6 6 18"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-width="1.8"
                />
            </svg>
        </button>
    </div>
    <p class="px-4 pb-3 text-sm text-gray-600">Le calendrier est fourni par Cal.com. Vos coordonnées servent à organiser le rendez-vous. <a class="underline" href="/mentions-legales/#reservation">Confidentialité</a></p>
    <div
        aria-label="Réserver un appel avec William De Azevedo"
        class="cal-drawer__embed mx-auto h-full min-h-0 w-full overflow-auto"
        data-cal-inline
        data-cal-link={calLink}
    ></div>
</dialog>

<script>
    import { trackAnalytics } from "../scripts/analytics";

    // File d'attente du snippet Cal.com : les appels sont mis en file jusqu'au
    // chargement de embed.js, qui remplace ensuite window.Cal.
    type CalQueue = { q?: unknown[][] };
    type CalApi = ((...args: unknown[]) => void) & CalQueue;
    type CalGlobal = CalApi & { loaded?: boolean; ns?: Record<string, CalApi> };
    type CalBookingEvent = {
        detail?: { data?: { eventTypeId?: number | string; status?: string } };
    };

    const calWindow = window as Window & { Cal?: CalGlobal };

    const drawer = document.querySelector("[data-cal-drawer]");
    const inlineEmbed = document.querySelector("[data-cal-inline]");
    const root = document.documentElement;
    const closeAnimationMs = 320;
    let isCalEmbedded = false;
    let isCalConfigured = false;
    let closeTimer: number | undefined;

    // Pose le stub du snippet une seule fois et renvoie window.Cal : les appels
    // ne sont pas optionnels, un stub absent doit lever une erreur, pas se taire.
    function loadCalEmbed(): CalGlobal {
        if (calWindow.Cal) return calWindow.Cal;

        return (function initCalEmbedSnippet(
            C: typeof calWindow,
            A: string,
            L: string,
        ): CalGlobal {
            const push = (api: CalQueue, args: unknown[]) => api.q?.push(args);
            const documentRef = C.document;

            if (!C.Cal) {
                const stub: CalGlobal = (...args: unknown[]) => {
                    // Comme le snippet officiel : relit window.Cal à chaque appel.
                    const cal = C.Cal ?? stub;

                    if (!cal.loaded) {
                        cal.ns ||= {};
                        cal.q ||= [];

                        const script = documentRef.createElement("script");
                        script.src = A;
                        documentRef.head.append(script);
                        cal.loaded = true;
                    }

                    if (args[0] === L) {
                        const api: CalApi = (...namespaceArgs: unknown[]) => {
                            push(api, namespaceArgs);
                        };
                        const namespace = args[1];

                        api.q ||= [];
                        if (typeof namespace === "string") {
                            cal.ns ||= {};
                            const namespaces = cal.ns;
                            namespaces[namespace] ||= api;
                            push(namespaces[namespace], args);
                            push(cal, ["initNamespace", namespace]);
                        } else {
                            push(cal, args);
                        }
                        return;
                    }

                    push(cal, args);
                };
                C.Cal = stub;
            }
            return C.Cal;
        })(calWindow, "https://app.cal.com/embed/embed.js", "init");
    }

    function getCalLink() {
        if (!(inlineEmbed instanceof HTMLElement)) return "";
        return inlineEmbed.dataset.calLink ?? "";
    }

    function configureCalEmbed(calLink: string) {
        if (isCalConfigured) return;

        const cal = loadCalEmbed();
        cal("init", { origin: "https://cal.com" });
        // Thème clair, aligné sur le reste du site. La langue (français) et le
        // premier jour de la semaine (lundi) se règlent dans le compte Cal.com
        // (Paramètres > Général) : l'embed n'expose aucune option pour les forcer.
        cal("ui", {
            layout: "month_view",
            styles: {
                body: { background: "#ffffff" },
            },
            theme: "light",
        });
        cal("on", {
            action: "bookingSuccessfulV2",
            callback: (event: CalBookingEvent) => {
                const booking = event.detail?.data ?? {};

                // Google Tag Manager : conversion prise de rendez-vous.
                const w = window as Window & { dataLayer?: unknown[] };
                w.dataLayer ||= [];
                w.dataLayer.push({ event: "prise_rdv" });

                trackAnalytics("cal_booking_success", {
                    cal_link: calLink,
                    event_type_id: String(booking.eventTypeId ?? ""),
                    location: "drawer",
                    status: booking.status ?? "",
                });
            },
        });
        cal("preload", { calLink });
        isCalConfigured = true;
    }

    function mountCalEmbed() {
        if (isCalEmbedded || !(inlineEmbed instanceof HTMLElement)) return;

        const calLink = getCalLink();
        if (!calLink) return;

        configureCalEmbed(calLink);
        loadCalEmbed()("inline", {
            calLink,
            config: {
                layout: "month_view",
                theme: "light",
                "ui.color-scheme": "light",
            },
            elementOrSelector: inlineEmbed,
        });
        isCalEmbedded = true;
    }

    function openCalDrawer() {
        if (!(drawer instanceof HTMLDialogElement)) return;
        mountCalEmbed();
        trackAnalytics("cal_open", {
            cal_link: getCalLink(),
            location: "drawer",
        });
        window.clearTimeout(closeTimer);
        drawer.classList.remove("is-closing");
        if (!drawer.open) {
            drawer.showModal();
        }
        root.classList.add("cal-drawer-open");
    }

    function closeCalDrawer() {
        if (!(drawer instanceof HTMLDialogElement) || !drawer.open) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            drawer.close();
            return;
        }

        drawer.classList.add("is-closing");
        window.clearTimeout(closeTimer);
        closeTimer = window.setTimeout(() => drawer.close(), closeAnimationMs);
    }

    drawer?.addEventListener("close", () => {
        window.clearTimeout(closeTimer);
        drawer.classList.remove("is-closing");
        root.classList.remove("cal-drawer-open");
    });

    drawer?.addEventListener("cancel", (event) => {
        event.preventDefault();
        closeCalDrawer();
    });

    // Préchargement à l'intention : survol ou focus d'un bouton de réservation.
    // embed.js et la page Cal.com se chargent avant le clic, le tiroir s'ouvre
    // donc sur un calendrier déjà prêt.
    function preloadOnIntent(event: Event) {
        if (isCalConfigured) return;
        const target = event.target;
        if (!(target instanceof Element) || !target.closest("[data-cal-open]")) {
            return;
        }
        const calLink = getCalLink();
        if (calLink) configureCalEmbed(calLink);
    }

    document.addEventListener("pointerover", preloadOnIntent, { passive: true });
    document.addEventListener("focusin", preloadOnIntent);

    document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const calOpenButton = target.closest("[data-cal-open]");
        if (calOpenButton instanceof HTMLElement) {
            event.preventDefault();
            trackAnalytics("cal_cta_click", {
                location: calOpenButton.dataset.calLocation ?? "unknown",
            });
            openCalDrawer();
            return;
        }

        if (
            (target.closest("[data-cal-close]") || target === drawer) &&
            drawer instanceof HTMLDialogElement
        ) {
            closeCalDrawer();
        }
    });

</script>

<style>
    :global(html.cal-drawer-open),
    :global(html.cal-drawer-open body) {
        overflow: hidden;
    }

    .cal-drawer {
        background: var(--color-snow-50);
        box-shadow: 0 24px 60px -32px rgb(34 42 55 / 0.45);
        height: calc(100dvh - 2rem);
        inset: 1rem 1rem 1rem auto;
        margin: auto 0 auto auto;
        max-height: calc(100dvh - 2rem);
        max-width: min(720px, calc(100dvw - 2rem));
        width: min(720px, calc(100dvw - 2rem));
    }

    .cal-drawer:not([open]) {
        display: none;
    }

    .cal-drawer::backdrop {
        backdrop-filter: blur(5px);
        background: rgb(232 229 232 / 0.48);
    }

    .cal-drawer[open] {
        animation: cal-drawer-in 440ms cubic-bezier(0.16, 1, 0.3, 1);
        display: grid;
        /* En-tête, mention de confidentialité, puis le calendrier qui prend
           toute la hauteur restante. */
        grid-template-rows: auto auto minmax(0, 1fr);
    }

    .cal-drawer[open]::backdrop {
        animation: cal-backdrop-in 440ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .cal-drawer[open].is-closing {
        animation: cal-drawer-out 320ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    .cal-drawer[open].is-closing::backdrop {
        animation: cal-backdrop-out 320ms cubic-bezier(0.4, 0, 0.2, 1)
            forwards;
    }

    .cal-drawer__close:focus-visible {
        outline: 2px solid var(--color-blue-500);
        outline-offset: 3px;
    }

    .cal-drawer__embed {
        max-width: 640px;
    }

    .cal-drawer__embed :global(iframe) {
        display: block;
        margin: 0 auto;
        max-width: 640px;
        width: 100%;
    }

    @media (max-width: 640px) {
        .cal-drawer {
            height: calc(100dvh - 1rem);
            inset: 0.5rem;
            margin: auto;
            max-height: calc(100dvh - 1rem);
            max-width: calc(100dvw - 1rem);
            width: calc(100dvw - 1rem);
        }

        .cal-drawer__embed {
            width: 100%;
        }
    }

    @keyframes cal-drawer-in {
        from {
            filter: blur(12px);
            opacity: 0;
            transform: translateY(1rem) scale(0.98);
        }
        to {
            filter: blur(0);
            opacity: 1;
            transform: none;
        }
    }

    @keyframes cal-drawer-out {
        from {
            filter: blur(0);
            opacity: 1;
            transform: none;
        }
        to {
            filter: blur(10px);
            opacity: 0;
            transform: translateY(0.75rem) scale(0.985);
        }
    }

    @keyframes cal-backdrop-in {
        from {
            backdrop-filter: blur(0);
            background: rgb(232 229 232 / 0);
        }
        to {
            backdrop-filter: blur(5px);
            background: rgb(232 229 232 / 0.48);
        }
    }

    @keyframes cal-backdrop-out {
        from {
            backdrop-filter: blur(5px);
            background: rgb(232 229 232 / 0.48);
        }
        to {
            backdrop-filter: blur(0);
            background: rgb(232 229 232 / 0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .cal-drawer[open],
        .cal-drawer[open]::backdrop,
        .cal-drawer[open].is-closing,
        .cal-drawer[open].is-closing::backdrop {
            animation: none;
        }
    }
</style>
