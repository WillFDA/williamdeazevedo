---
import Star from "./icons/nucleo/star-fill.svg";
import {
    formatGoogleRating,
    formatGoogleReviewCount,
    getDisplayableGoogleReviews,
} from "@/data/googleReviews";

interface Props {
    class?: string;
    location: string;
}

const { class: className = "", location } = Astro.props;
// Rien n'est rendu sans relevé valide de la note réelle.
const reviews = getDisplayableGoogleReviews();
const ratingLabel = reviews ? formatGoogleRating(reviews.rating) : "";
const countLabel = reviews ? formatGoogleReviewCount(reviews.reviewCount) : "";
---

{
    reviews && (
        <div class:list={["flex justify-center", className]}>
            <a
                class="inline-flex max-w-full items-center gap-2 rounded-xl bg-snow-50 px-3.5 py-2 text-sm font-normal leading-tight text-gray-900 no-underline shadow-[0_10px_22px_-16px_rgba(34,42,55,0.45)] transition-transform hover:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500 sm:text-base"
                aria-label={`${countLabel} : ${ratingLabel} sur 5. Voir la fiche Google (nouvel onglet)`}
                data-analytics-label="avis-google"
                data-analytics-location={location}
                href={reviews.profileUrl}
                rel="noreferrer"
                target="_blank"
            >
                <span>{countLabel}</span>
                <span class="inline-flex items-center gap-1.5 rounded-xl bg-blue-500 px-2.5 py-1 font-medium text-snow-50">
                    <Star aria-hidden="true" class="size-4 text-snow-50" />
                    <span>{ratingLabel}</span>
                </span>
            </a>
        </div>
    )
}
