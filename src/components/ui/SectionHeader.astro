---
import SectionEyebrow from "./SectionEyebrow.astro";
import { withFrenchSpacing } from "@/lib/typography";

// En-tête commun aux sections du bas de l'accueil : libellé mono, titre
// aligné à gauche et, en desktop, description dans la colonne de droite,
// calée sur le haut du titre (lg:pt-8 = libellé de 12 px + son écart de 20 px).
interface Props {
    class?: string;
    description?: string;
    eyebrow: string;
    id: string;
    title: string;
}

const { class: className, description, eyebrow, id, title } = Astro.props;
---

<div
    class:list={[
        "grid gap-6 lg:grid-cols-12 lg:items-start lg:gap-x-8",
        className,
    ]}
>
    <div class="flex flex-col items-start gap-5 lg:col-span-7">
        <SectionEyebrow>{eyebrow}</SectionEyebrow>
        <h2 id={id} class="section-title">{withFrenchSpacing(title)}</h2>
    </div>
    {
        description && (
            <p class="max-w-xl text-base font-light leading-normal text-gray-600 sm:text-lg lg:col-span-5 lg:pt-8">
                {withFrenchSpacing(description)}
            </p>
        )
    }
</div>
