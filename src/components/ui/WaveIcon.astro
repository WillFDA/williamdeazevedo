---
type Direction = "up" | "down" | "left" | "right" | "up-right";
type Trigger = "self" | "parent";
type StyleValue = string | Record<string, string | number | null | undefined>;
type Offsets = {
  enterX: string;
  enterY: string;
  exitX: string;
  exitY: string;
};

interface Props {
  as?: keyof HTMLElementTagNameMap;
  class?: string;
  direction?: Direction;
  distance?: number | string;
  label?: string;
  style?: StyleValue;
  trigger?: Trigger;
  [key: string]: unknown;
}

const directionVectors = {
  up: { x: 0, y: -1 },
  "up-right": { x: 1, y: -1 },
  down: { x: 0, y: 1 },
  left: { x: -1, y: 0 },
  right: { x: 1, y: 0 },
} satisfies Record<Direction, { x: -1 | 0 | 1; y: -1 | 0 | 1 }>;

const formatDistance = (distance: number | string) =>
  typeof distance === "number" ? `${distance}%` : distance;

const formatOffset = (axis: -1 | 0 | 1, distance: string) => {
  if (axis === 0) return "0%";
  return axis === -1 ? `-${distance}` : distance;
};

const styleToString = (style: StyleValue | undefined) => {
  if (!style) return "";
  if (typeof style === "string") return style;

  return Object.entries(style)
    .filter((entry): entry is [string, string | number] => entry[1] !== null && entry[1] !== undefined)
    .map(([key, value]) => `${key}: ${value};`)
    .join(" ");
};

const buildStyle = (offsets: Offsets, style: StyleValue | undefined) =>
  [
    `--wui-wave-icon-enter-x: ${offsets.enterX};`,
    `--wui-wave-icon-enter-y: ${offsets.enterY};`,
    `--wui-wave-icon-exit-x: ${offsets.exitX};`,
    `--wui-wave-icon-exit-y: ${offsets.exitY};`,
    styleToString(style),
  ]
    .filter(Boolean)
    .join(" ");

const {
  as = "span",
  class: className,
  direction = "up",
  distance = 115,
  label,
  style,
  trigger = "self",
  ...attrs
} = Astro.props;

const Tag = as;
const distanceValue = formatDistance(distance);
const vector = directionVectors[direction] ?? directionVectors.up;
const offsets = {
  enterX: formatOffset((vector.x * -1) as -1 | 0 | 1, distanceValue),
  enterY: formatOffset((vector.y * -1) as -1 | 0 | 1, distanceValue),
  exitX: formatOffset(vector.x, distanceValue),
  exitY: formatOffset(vector.y, distanceValue),
};
---

<Tag
  {...attrs}
  class:list={["wui-wave-icon", className]}
  data-wui-wave-icon
  data-wui-wave-icon-enter-x={offsets.enterX}
  data-wui-wave-icon-enter-y={offsets.enterY}
  data-wui-wave-icon-exit-x={offsets.exitX}
  data-wui-wave-icon-exit-y={offsets.exitY}
  data-wui-wave-icon-trigger={trigger}
  style={buildStyle(offsets, style)}
>
  {label && <span class="sr-only">{label}</span>}

  <span class="wui-wave-icon__stage" aria-hidden="true">
    <span class="wui-wave-icon__layer" data-wui-wave-icon-layer="first">
      <slot />
    </span>
    <span class="wui-wave-icon__layer" data-wui-wave-icon-layer="second">
      <slot />
    </span>
  </span>
</Tag>

<style>
  .wui-wave-icon {
    --wui-wave-icon-size: 1.125rem;

    align-items: center;
    color: inherit;
    display: inline-flex;
    flex: 0 0 auto;
    height: var(--wui-wave-icon-size);
    line-height: 1;
    position: relative;
    text-decoration: inherit;
    width: var(--wui-wave-icon-size);
  }

  .wui-wave-icon__stage {
    display: grid;
    height: 100%;
    line-height: inherit;
    overflow: clip;
    width: 100%;
  }

  .wui-wave-icon__layer {
    align-items: center;
    display: inline-flex;
    grid-area: 1 / 1;
    height: 100%;
    justify-content: center;
    width: 100%;
  }

  /* Promote to a compositor layer only during the interaction (see WaveText)
     rather than keeping a permanent GPU layer alive for every icon. */
  .wui-wave-icon:focus-visible .wui-wave-icon__layer,
  :global(:where(a, button, [data-wui-wave-parent]):focus-visible)
    .wui-wave-icon[data-wui-wave-icon-trigger="parent"]
    .wui-wave-icon__layer {
    will-change: transform;
  }

  .wui-wave-icon__layer :global(i),
  .wui-wave-icon__layer :global(svg) {
    display: inline-flex;
    flex: 0 0 auto;
    height: 100%;
    line-height: 1;
    width: 100%;
  }

  .wui-wave-icon__layer :global(i)::before {
    display: block;
    line-height: 1;
  }

  [data-wui-wave-icon-layer="first"] {
    transform: translate3d(0%, 0%, 0);
  }

  [data-wui-wave-icon-layer="second"] {
    transform: translate3d(
      var(--wui-wave-icon-enter-x),
      var(--wui-wave-icon-enter-y),
      0
    );
  }

  .wui-wave-icon:not([data-wui-wave-icon-ready="true"]) .wui-wave-icon__layer {
    transition: transform 520ms var(--wui-ease-standard, cubic-bezier(0.2, 0, 0, 1));
  }

  .wui-wave-icon:not([data-wui-wave-icon-ready="true"]):focus-visible
    [data-wui-wave-icon-layer="first"],
  :global(:where(a, button, [data-wui-wave-parent]):focus-visible)
    .wui-wave-icon[data-wui-wave-icon-trigger="parent"]:not([data-wui-wave-icon-ready="true"])
    [data-wui-wave-icon-layer="first"] {
    transform: translate3d(
      var(--wui-wave-icon-exit-x),
      var(--wui-wave-icon-exit-y),
      0
    );
  }

  .wui-wave-icon:not([data-wui-wave-icon-ready="true"]):focus-visible
    [data-wui-wave-icon-layer="second"],
  :global(:where(a, button, [data-wui-wave-parent]):focus-visible)
    .wui-wave-icon[data-wui-wave-icon-trigger="parent"]:not([data-wui-wave-icon-ready="true"])
    [data-wui-wave-icon-layer="second"] {
    transform: translate3d(0%, 0%, 0);
  }

  @media (hover: hover) {
    .wui-wave-icon:hover .wui-wave-icon__layer,
    :global(:where(a, button, [data-wui-wave-parent]):hover)
      .wui-wave-icon[data-wui-wave-icon-trigger="parent"]
      .wui-wave-icon__layer {
      will-change: transform;
    }

    .wui-wave-icon:not([data-wui-wave-icon-ready="true"]):hover
      [data-wui-wave-icon-layer="first"],
    :global(:where(a, button, [data-wui-wave-parent]):hover)
      .wui-wave-icon[data-wui-wave-icon-trigger="parent"]:not([data-wui-wave-icon-ready="true"])
      [data-wui-wave-icon-layer="first"] {
      transform: translate3d(
        var(--wui-wave-icon-exit-x),
        var(--wui-wave-icon-exit-y),
        0
      );
    }

    .wui-wave-icon:not([data-wui-wave-icon-ready="true"]):hover
      [data-wui-wave-icon-layer="second"],
    :global(:where(a, button, [data-wui-wave-parent]):hover)
      .wui-wave-icon[data-wui-wave-icon-trigger="parent"]:not([data-wui-wave-icon-ready="true"])
      [data-wui-wave-icon-layer="second"] {
      transform: translate3d(0%, 0%, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wui-wave-icon__layer {
      transition: none;
      will-change: auto;
    }

    [data-wui-wave-icon-layer="second"] {
      display: none;
    }
  }
</style>
