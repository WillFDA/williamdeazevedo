---
import type { HTMLAttributes } from "astro/types";

export type AnimatedHeadingPart = {
    pill?: boolean;
    text: string;
};

type Props = Omit<HTMLAttributes<"h1">, "class"> & {
    as?: "h1" | "h2";
    class?: string;
    parts: readonly AnimatedHeadingPart[];
};

const { as = "h1", class: className, parts, ...attributes } = Astro.props as Props;
const Tag = as;

const isMultiWordPill = (part: AnimatedHeadingPart) =>
    part.pill === true && /\s/.test(part.text.trim());

// Décalage réparti sur 180 ms quelle que soit la longueur du titre : avec les
// 320 ms de l'animation, le titre est en place en 500 ms.
const wordDelay = (index: number) => Math.round((index / parts.length) * 180);
---

<Tag {...attributes} class={className}>
    {
        parts.map((part, index) => (
            <Fragment>
                <span
                    class:list={[
                        "animated-heading__word",
                        part.pill && "title-pill",
                        isMultiWordPill(part) && "animated-heading__pill-group",
                    ]}
                    style={`--animated-heading-delay: ${wordDelay(index)}ms`}
                >
                    {isMultiWordPill(part)
                        ? part.text.split(/\s+/).map((word, wordIndex, words) => (
                              <Fragment>
                                  <span class="title-pill animated-heading__pill-word">
                                      {word}
                                  </span>
                                  {wordIndex < words.length - 1 && " "}
                              </Fragment>
                          ))
                        : part.text}
                </span>
                {index < parts.length - 1 && " "}
            </Fragment>
        ))
    }
</Tag>

<style>
    .animated-heading__word {
        animation: animated-heading-word 320ms cubic-bezier(0.16, 1, 0.3, 1)
            var(--animated-heading-delay, 0ms) backwards;
        display: inline-block;
    }

    .animated-heading__pill-word {
        display: inline-block;
    }

    /* Desktop: one pill around the whole phrase. */
    @media (min-width: 640px) {
        .animated-heading__pill-word {
            background: none;
            box-shadow: none;
            color: inherit;
            margin: 0;
            padding: 0;
        }
    }

    /* Mobile: the phrase wraps, so an inline-block pill would stretch to the
       full line width. Give each word its own pill that hugs the text. */
    @media (max-width: 639px) {
        .animated-heading__pill-group {
            background: none;
            box-shadow: none;
            margin: 0;
            padding: 0;
        }
    }

    /* Glissement seul : un mot à opacité 0 n'est compté dans le LCP qu'à la
       fin de son animation. */
    @keyframes animated-heading-word {
        from {
            transform: translateY(0.32em);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .animated-heading__word {
            animation: none;
        }
    }
</style>
