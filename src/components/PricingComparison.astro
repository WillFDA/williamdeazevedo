---
import { type IconTone, iconToneClasses } from "@/lib/iconTones";
import CalButton from "./CalButton.astro";
import FadeRevealOnScroll from "./animations/FadeRevealOnScroll.astro";
import CheckIcon from "./icons/nucleo/check-2-outline.svg";
import BadgeDollar from "./icons/nucleo/badge-dollar-fill.svg";
import CodeEditor from "./icons/nucleo/code-editor-fill.svg";
import Gauge from "./icons/nucleo/gauge-3-fill.svg";
import Msgs from "./icons/nucleo/msgs-fill.svg";
import SearchContent from "./icons/nucleo/search-content-2-fill.svg";
import Sparkle from "./icons/nucleo/sparkle-3-fill.svg";
import Target from "./icons/nucleo/target-fill.svg";
import TouchClick from "./icons/nucleo/touch-click-fill.svg";
import UserHeart from "./icons/nucleo/user-heart-fill.svg";
import WindowLayout from "./icons/nucleo/window-layout-fill.svg";
import WindowPaintbrush from "./icons/nucleo/window-paintbrush-fill.svg";
import AnimationRepeat from "./icons/nucleo/animation-repeat-fill.svg";
import Globe from "./icons/nucleo/globe-outline.svg";
import XMarkIcon from "./icons/nucleo/xmark-fill.svg";

type ComparisonCell =
    | {
          type: "check" | "x";
      }
    | {
          type: "text";
          text: string;
      };

type ComparisonRow = {
    label: string;
    icon: ComparisonIcon;
    tone: IconTone;
    solo: ComparisonCell;
    split: ComparisonCell;
    complete: string;
};

type ComparisonIcon =
    | "budget"
    | "code"
    | "form"
    | "ia"
    | "identity"
    | "performance"
    | "globe"
    | "repeat"
    | "search"
    | "target"
    | "touch"
    | "user"
    | "ux";

interface Props {
    /**
     * `full` : comparatif complet (page /tarifs/).
     * `costs` : uniquement le coût estimé sur 3 ans, pour les pages services.
     */
    variant?: "costs" | "full";
}

const { variant = "full" } = Astro.props;
const isCosts = variant === "costs";
const headingId = isCosts
    ? "pricing-comparison-costs-title"
    : "pricing-comparison-title";

const otherColumns = [
    {
        eyebrow: "Option 1",
        title: "Site à 600 €",
        note: "Agence low-cost ou modèle tout fait",
    },
    {
        eyebrow: "Option 2",
        title: "Prestataires séparés",
        note: "Graphiste, dev et SEO à coordonner",
    },
] as const;

const rows: ComparisonRow[] = [
    {
        label: "Offre et positionnement",
        icon: "target",
        tone: "blue",
        solo: { type: "text", text: "À clarifier seul" },
        split: { type: "text", text: "Souvent dispersé" },
        complete: "Message cadré",
    },
    {
        label: "Identité visuelle",
        icon: "identity",
        tone: "violet",
        solo: { type: "text", text: "À fournir" },
        split: { type: "text", text: "À coordonner" },
        complete: "Graphiste partenaire si besoin",
    },
    {
        label: "Parcours pensé conversion",
        icon: "touch",
        tone: "teal",
        solo: { type: "text", text: "Variable" },
        split: { type: "text", text: "Dépend du brief" },
        complete: "Objectif priorisé",
    },
    {
        label: "Design responsive",
        icon: "ux",
        tone: "sky",
        solo: { type: "text", text: "Souvent basique" },
        split: { type: "text", text: "Selon profil" },
        complete: "Sur mesure",
    },
    {
        label: "Performance et accessibilité",
        icon: "performance",
        tone: "green",
        solo: { type: "text", text: "Souvent option" },
        split: { type: "text", text: "Souvent à part" },
        complete: "Vérifiées avant mise en ligne",
    },
    {
        label: "SEO technique initial",
        icon: "search",
        tone: "orange",
        solo: { type: "text", text: "Léger" },
        split: { type: "text", text: "À part" },
        complete: "Inclus",
    },
    {
        label: "Formulaire, CMS ou tracking",
        icon: "form",
        tone: "pink",
        solo: { type: "text", text: "Option" },
        split: { type: "text", text: "À connecter" },
        complete: "Prévu au cadrage",
    },
    {
        label: "Interlocuteur unique",
        icon: "user",
        tone: "indigo",
        solo: { type: "text", text: "Oui, mais limité" },
        split: { type: "x" },
        complete: "Oui, du cadrage à la mise en ligne",
    },
];

// Coût sur 3 ans. Colonne « Site à 600 € » : relevé d'offres publiques de
// sites à bas prix et par abonnement, consulté le 14 octobre 2026, aucune
// agence nommée. Valeurs brutes : mise en place de 0 à 1 190 € HT, mensualités
// de 29 à 169 € HT, engagement de 12 à 48 mois (24 mois le plus souvent,
// selon les offres), modifications souvent incluses tant que l'abonnement court,
// propriété du site variable selon le contrat. Scénario retenu : 600 € HT de
// mise en place + 36 mensualités de 30 à 100 € HT (scénario, pas une moyenne).
// Colonne William : uniquement ce que publie /tarifs/.
const nbsp = "\u00a0";
const euro = (value: number) =>
    `${new Intl.NumberFormat("fr-FR").format(value)}${nbsp}€${nbsp}HT`;
const lowCost = { setup: 600, monthlyMin: 30, monthlyMax: 100, months: 36 };
const subscriptionMin = lowCost.monthlyMin * lowCost.months;
const subscriptionMax = lowCost.monthlyMax * lowCost.months;

const costRows: ComparisonRow[] = [
    {
        label: "Création",
        icon: "budget",
        tone: "cyan",
        solo: { type: "text", text: `Environ ${euro(lowCost.setup)} de mise en place` },
        split: { type: "text", text: "Un devis par prestataire" },
        complete: `Dès ${euro(2000)}, une fois`,
    },
    {
        label: "Abonnement sur 3 ans",
        icon: "repeat",
        tone: "teal",
        solo: {
            type: "text",
            text: `Souvent ${lowCost.monthlyMin} à ${euro(lowCost.monthlyMax)} par mois, engagement de 12 à 48 mois selon l'offre, soit ${euro(subscriptionMin)} à ${euro(subscriptionMax)} sur 3${nbsp}ans`,
        },
        split: { type: "text", text: "Hébergement et maintenance à part" },
        complete:
            "Pas d'abonnement imposé : domaine, hébergement et outils payés à votre nom",
    },
    {
        label: "Modifications",
        icon: "code",
        tone: "slate",
        solo: {
            type: "text",
            text: "Souvent incluses, tant que l'abonnement est payé",
        },
        split: { type: "text", text: "Facturées par chaque intervenant" },
        complete: "Sur devis, sans forfait ni engagement",
    },
    {
        label: "Propriété du site et du domaine",
        icon: "globe",
        tone: "indigo",
        solo: {
            type: "text",
            text: "Pas toujours, selon le contrat : le site peut être mis hors ligne à l'arrêt",
        },
        split: { type: "text", text: "Selon chaque contrat" },
        complete: "Domaine, hébergement et outils à votre nom",
    },
];

const costTotal = {
    label: "Coût estimé sur 3 ans",
    soloAnchor: euro(lowCost.setup),
    solo: `${euro(lowCost.setup + subscriptionMin)} à ${euro(lowCost.setup + subscriptionMax)}`,
    split: "Très variable",
    complete: `Dès ${euro(2000)} de création`,
    completeNote: "hors domaine, hébergement, outils et maintenance, payés à votre nom",
};

const displayedRows = isCosts ? costRows : [...rows, ...costRows];
---

<section
    class="relative left-1/2 w-[calc(100dvw-2rem)] max-w-7xl -translate-x-1/2 rounded-4xl bg-gray-100 px-4 py-12 sm:px-8 md:py-16"
    aria-labelledby={headingId}
>
    <FadeRevealOnScroll>
        <div class="mx-auto flex max-w-3xl flex-col items-center gap-4 text-center">
            <span class="rounded-full bg-snow-50 px-4 py-2 text-sm font-normal text-gray-900 shadow-lg">
                Comparaison
            </span>
            <h2 id={headingId} class="section-heading max-w-3xl">
                {
                    isCosts
                        ? "Site à 600 € : ce qu'il peut coûter sur 3 ans."
                        : "Pourquoi un accompagnement complet évite les angles morts."
                }
            </h2>
            <p class="section-subheading max-w-xl">
                {
                    isCosts
                        ? "Le prix affiché n'est pas le prix payé : l'abonnement change le total, et la propriété décide de ce que vous gardez en partant."
                        : "Un site à 600 €, plusieurs prestataires à coordonner, ou une présence claire avec le bon cadrage dès le départ : poste par poste, puis coût estimé sur 3 ans."
                }
            </p>
        </div>
    </FadeRevealOnScroll>

    <FadeRevealOnScroll class="mx-auto mt-12 max-w-6xl" delay={0.08}>
        <div class="overflow-hidden rounded-3xl bg-snow-50 shadow-[0_34px_90px_-64px_rgba(34,42,55,0.6)] ring-1 ring-gray-200">
            <div class="overflow-x-auto">
                <table class="w-full min-w-[58rem] border-separate border-spacing-0 text-left">
                    <caption class="sr-only">
                        Comparaison entre un site à 600 €, plusieurs prestataires
                        séparés et un accompagnement complet, poste par poste,
                        avec le coût estimé sur 3 ans.
                    </caption>
                    <thead>
                        <tr>
                            <th
                                class="sticky left-0 z-10 w-32 lg:w-[26%] border-b border-r border-gray-200 bg-snow-50 px-5 py-5 align-bottom"
                                scope="col"
                            >
                                <span class="text-sm font-normal leading-tight text-gray-500">
                                    Ce que le budget doit couvrir
                                </span>
                            </th>
                            {
                                otherColumns.map((column) => (
                                    <th
                                        class="lg:w-[21%] border-b border-r border-gray-200 px-5 py-5 text-center align-bottom"
                                        scope="col"
                                    >
                                        <span class="block text-sm font-normal text-gray-500">
                                            {column.eyebrow}
                                        </span>
                                        <strong class="mt-1 block text-base font-medium leading-tight text-gray-900">
                                            {column.title}
                                        </strong>
                                        <span class="mt-1.5 block text-xs font-light leading-snug text-gray-500">
                                            {column.note}
                                        </span>
                                    </th>
                                ))
                            }
                            <th
                                class="comparison-highlight lg:w-[32%] border-b px-5 py-5 text-center align-bottom text-snow-50"
                                scope="col"
                            >
                                <span class="inline-flex rounded-full bg-snow-50/15 px-3 py-1 text-[0.68rem] font-medium uppercase tracking-widest text-snow-50 ring-1 ring-snow-50/25">
                                    Recommandé
                                </span>
                                <strong class="mt-2 block text-lg font-semibold leading-tight">
                                    William + partenaires
                                </strong>
                                <span class="mt-1.5 block text-xs font-light leading-snug text-snow-50/80">
                                    Cadrage, site, identité si besoin
                                </span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {
                            displayedRows.map((row, rowIndex) => (
                                <tr
                                    class="comparison-row group"
                                    style={`--row-index: ${rowIndex}`}
                                >
                                    <th
                                        class="sticky left-0 z-10 bg-snow-50 px-5 py-4 text-sm font-normal leading-tight text-gray-900 transition-colors group-hover:bg-snow-200"
                                        scope="row"
                                    >
                                        <span class="flex items-center gap-3">
                                            <span
                                                class:list={[
                                                    "inline-flex size-8 shrink-0 items-center justify-center rounded-lg text-snow-50",
                                                    iconToneClasses[row.tone],
                                                ]}
                                                aria-hidden="true"
                                            >
                                                {row.icon === "target" && (
                                                    <Target class="size-5" />
                                                )}
                                                {row.icon === "identity" && (
                                                    <WindowPaintbrush class="size-5" />
                                                )}
                                                {row.icon === "touch" && (
                                                    <TouchClick class="size-5" />
                                                )}
                                                {row.icon === "ux" && (
                                                    <WindowLayout class="size-5" />
                                                )}
                                                {row.icon === "performance" && (
                                                    <Gauge class="size-5" />
                                                )}
                                                {row.icon === "search" && (
                                                    <SearchContent class="size-5" />
                                                )}
                                                {row.icon === "form" && (
                                                    <Msgs class="size-5" />
                                                )}
                                                {row.icon === "user" && (
                                                    <UserHeart class="size-5" />
                                                )}
                                                {row.icon === "code" && (
                                                    <CodeEditor class="size-5" />
                                                )}
                                                {row.icon === "repeat" && (
                                                    <AnimationRepeat class="size-5" />
                                                )}
                                                {row.icon === "globe" && (
                                                    <Globe class="size-5" />
                                                )}
                                                {row.icon === "budget" && (
                                                    <BadgeDollar class="size-5" />
                                                )}
                                                {row.icon === "ia" && (
                                                    <Sparkle class="size-5" />
                                                )}
                                            </span>
                                            <span>{row.label}</span>
                                        </span>
                                    </th>
                                    {[row.solo, row.split].map((cell) => (
                                        <td class="px-5 py-4 text-center text-sm font-normal leading-tight text-gray-600 transition-colors group-hover:bg-snow-200">
                                            {cell.type === "check" && (
                                                <span
                                                    class="inline-flex size-8 items-center justify-center rounded-full bg-blue-50 text-blue-500"
                                                    aria-label="Oui"
                                                >
                                                    <CheckIcon class="size-4" />
                                                </span>
                                            )}
                                            {cell.type === "x" && (
                                                <span
                                                    class="inline-flex size-8 items-center justify-center rounded-full bg-gray-100 text-gray-900"
                                                    aria-label="Non"
                                                >
                                                    <XMarkIcon class="size-3" />
                                                </span>
                                            )}
                                            {cell.type === "text" && (
                                                <span>{cell.text}</span>
                                            )}
                                        </td>
                                    ))}
                                    <td class="comparison-highlight px-5 py-4 text-sm font-normal leading-tight text-snow-50">
                                        <span class="flex items-center gap-3">
                                            <span
                                                class="inline-flex size-7 flex-none items-center justify-center rounded-full bg-snow-50 text-blue-500 shadow-[0_10px_20px_-12px_rgba(14,23,37,0.55)]"
                                                aria-hidden="true"
                                            >
                                                <CheckIcon class="size-3.5" />
                                            </span>
                                            <span>{row.complete}</span>
                                        </span>
                                    </td>
                                </tr>
                            ))
                        }
                    </tbody>
                    <tfoot>
                        <tr
                            class="comparison-row"
                            style={`--row-index: ${displayedRows.length}`}
                        >
                            <th
                                class="sticky left-0 z-10 bg-snow-50 px-5 py-5 text-sm font-medium leading-tight text-gray-900"
                                scope="row"
                            >
                                {costTotal.label}
                            </th>
                            <td class="px-5 py-5 text-center text-sm font-medium leading-tight text-gray-600">
                                <span class="block">
                                    <span class="sr-only">Prix affiché :</span>
                                    <s class="decoration-gray-600 decoration-2">
                                        {costTotal.soloAnchor}
                                    </s>
                                </span>
                                <span class="mt-1 block text-gray-900">
                                    {costTotal.solo}
                                </span>
                                <span class="mt-1 block text-xs font-normal">
                                    abonnement en cours
                                </span>
                            </td>
                            <td class="px-5 py-5 text-center text-sm font-normal leading-tight text-gray-600">
                                {costTotal.split}
                            </td>
                            <td class="comparison-highlight px-5 py-5 text-snow-50">
                                <strong class="block text-lg font-semibold leading-tight">
                                    {costTotal.complete}
                                </strong>
                                <span class="mt-1 block text-sm font-normal leading-snug text-snow-50">
                                    {costTotal.completeNote}
                                </span>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
        <p class="mt-3 text-center text-xs font-normal text-gray-500 lg:hidden">
            Faites défiler le tableau horizontalement pour comparer les trois
            options.
        </p>
        <dl class="mt-4 grid gap-3 lg:hidden">
            <div class="rounded-2xl bg-snow-50 px-5 py-4 ring-1 ring-gray-200">
                <dt class="text-sm font-normal text-gray-600">
                    Site à 600 €, {costTotal.label.toLowerCase()}
                </dt>
                <dd class="mt-1 text-base font-medium text-gray-900">
                    {costTotal.solo}
                    <span class="block text-sm font-normal text-gray-600">
                        mise en place + abonnement en cours
                    </span>
                </dd>
            </div>
            <div class="rounded-2xl bg-blue-500 px-5 py-4 text-snow-50">
                <dt class="text-sm font-normal">Avec moi</dt>
                <dd class="mt-1 text-base font-medium">
                    {costTotal.complete}
                    <span class="block text-sm font-normal">
                        {costTotal.completeNote}
                    </span>
                </dd>
            </div>
        </dl>
    </FadeRevealOnScroll>

    <FadeRevealOnScroll delay={0.12}>
        <p class="mx-auto mt-8 max-w-2xl text-center text-sm font-normal leading-relaxed text-gray-600">
            Fourchettes indicatives relevées sur des offres publiques de sites à
            bas prix et par abonnement (octobre 2026) : elles varient selon les
            prestataires et la durée d'engagement. Pour voir ce que recouvre chaque niveau d'offre, lisez l'article{" "}
            <a
                class="text-gray-900 underline decoration-gray-300 underline-offset-4 transition-colors hover:decoration-gray-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                href="/articles/site-600-euros-vs-site-2000-euros/"
                >site à 600 € ou site à 2 000 €</a
            >.
        </p>
        <div class="mt-6 flex justify-center">
            <CalButton
                class="rounded-xl text-base font-normal"
                label="Vérifier ce qui compte pour votre projet"
                location={isCosts ? "service-creation-site-vitrine-comparaison" : "tarifs-comparaison"}
            />
        </div>
    </FadeRevealOnScroll>
</section>

<style>
    /* Per-cell borders (border-separate keeps the sticky column clean). */
    tbody th,
    tbody td {
        border-bottom: 1px solid var(--color-gray-200);
    }

    tbody th {
        border-right: 1px solid var(--color-gray-200);
    }

    tbody tr:last-child th,
    tbody tr:last-child td {
        border-bottom: 0;
    }

    tfoot th,
    tfoot td {
        border-top: 2px solid var(--color-gray-200);
    }

    tfoot .comparison-highlight {
        border-top-color: rgba(255, 255, 255, 0.22);
    }

    tfoot th {
        border-right: 1px solid var(--color-gray-200);
    }

    .comparison-highlight {
        background: var(--color-blue-500);
        box-shadow: inset 1px 0 0 rgba(255, 255, 255, 0.14);
    }

    thead .comparison-highlight {
        border-bottom-color: rgba(255, 255, 255, 0.22);
    }

    tbody .comparison-highlight {
        border-bottom-color: rgba(255, 255, 255, 0.16);
        transition: background-color 200ms ease;
    }

    tbody tr:hover .comparison-highlight {
        background: var(--color-blue-600);
    }

    /* Staggered row reveal, driven by the FadeRevealOnScroll wrapper state.
       Gated on (scripting: enabled) so rows stay visible without JS and in
       browsers that do not support the scripting media feature. */
    @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
        .comparison-row {
            transition: opacity 700ms cubic-bezier(0.2, 0, 0, 1);
            transition-delay: calc(var(--row-index, 0) * 55ms);
        }

        :global(.fade-reveal-on-scroll.is-reveal-ready:not(.is-visible))
            .comparison-row {
            opacity: 0;
            transition: none;
        }
    }
</style>
