---
import BoltSpeed from "./icons/nucleo/bolt-speed-fill.svg";
import CodeEditor from "./icons/nucleo/code-editor-fill.svg";
import TouchClick from "./icons/nucleo/touch-click-fill.svg";
import WindowPaintbrush from "./icons/nucleo/window-paintbrush-fill.svg";
import WindowPointer from "./icons/nucleo/window-pointer-fill.svg";

export type ExpertiseShowcaseItem = {
  description: readonly string[];
  icon: "site" | "refresh" | "code" | "ux" | "performance";
  id: string;
  label: string;
  pills: readonly string[];
  title: string;
};

interface Props {
  description: string;
  items: readonly ExpertiseShowcaseItem[];
  title: string;
}

const { description, items, title } = Astro.props;
const firstId = items[0]?.id ?? "";
const titleWords = title.split(" ");
---

<section
  class="expertise-showcase flex w-full flex-col gap-14 lg:gap-16"
  data-expertise-showcase
  data-section-reveal="false"
>
  <div class="expertise-showcase__intro mx-auto flex max-w-4xl flex-col items-center gap-4 text-center">
    <h2
      aria-label={title}
      class="section-heading flex flex-wrap justify-center gap-x-[0.18em]"
    >
      {
        titleWords.map((word, index) => (
          <Fragment>
            <span
              aria-hidden="true"
              class="expertise-showcase__heading-word"
              data-expertise-heading-word
            >
              {word}
            </span>
            {index < titleWords.length - 1 && " "}
          </Fragment>
        ))
      }
    </h2>
    <p class="section-subheading" data-expertise-description>{description}</p>
  </div>
  <div class="expertise-showcase__body grid gap-10">
    <div
      aria-label="Expertises"
      class="expertise-showcase__tabs"
      data-expertise-tabs
      role="tablist"
    >
      <span
        aria-hidden="true"
        class="expertise-showcase__tab-indicator"
        data-expertise-indicator
      ></span>
      {
        items.map((item) => (
          <button
            aria-controls={`expertise-panel-${item.id}`}
            aria-selected={item.id === firstId ? "true" : "false"}
            class:list={[
              "expertise-showcase__tab",
              item.id === firstId && "is-active",
            ]}
            data-expertise-tab={item.id}
            id={`expertise-tab-${item.id}`}
            role="tab"
            tabindex={item.id === firstId ? undefined : -1}
            type="button"
          >
            <span class="expertise-showcase__tab-icon" aria-hidden="true">
              {item.icon === "site" && (
                <WindowPointer class="size-5" />
              )}
              {item.icon === "refresh" && (
                <WindowPaintbrush class="size-5" />
              )}
              {item.icon === "code" && (
                <CodeEditor class="size-5" />
              )}
              {item.icon === "ux" && (
                <TouchClick class="size-5" />
              )}
              {item.icon === "performance" && (
                <BoltSpeed class="size-5" />
              )}
            </span>
            <span>{item.label}</span>
          </button>
        ))
      }
    </div>
    <div class="expertise-showcase__panels min-w-0">
      {
        items.map((item) => (
          <div
            aria-labelledby={`expertise-tab-${item.id}`}
            class:list={[
              "expertise-showcase__panel grid gap-10",
              item.id === firstId && "is-active",
            ]}
            data-expertise-panel={item.id}
            hidden={item.id === firstId ? undefined : true}
            id={`expertise-panel-${item.id}`}
            role="tabpanel"
          >
            <div
              class="expertise-showcase__visual"
              aria-hidden="true"
              data-expertise-visual
            >
              <div class="expertise-showcase__browser">
                <div class="expertise-showcase__browser-dots">
                  <span />
                  <span />
                  <span />
                </div>
                <div class="expertise-showcase__visual-list">
                  {[...item.pills, ...item.pills].map((pill) => (
                    <div class="expertise-showcase__visual-item">
                      <span class="expertise-showcase__visual-icon">
                        {item.icon === "site" && (
                          <WindowPointer class="size-5" />
                        )}
                        {item.icon === "refresh" && (
                          <WindowPaintbrush class="size-5" />
                        )}
                        {item.icon === "code" && (
                          <CodeEditor class="size-5" />
                        )}
                        {item.icon === "ux" && (
                          <TouchClick class="size-5" />
                        )}
                        {item.icon === "performance" && (
                          <BoltSpeed class="size-5" />
                        )}
                      </span>
                      <span>{pill}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
            <div class="expertise-showcase__content order-first flex min-w-0 flex-col gap-5 self-center lg:order-none">
              <h3
                class="m-0 text-balance text-[clamp(1.9rem,2.9vw,3rem)] leading-[1.02] font-medium text-gray-900"
                data-expertise-content-title
                style="--reveal-delay: 320ms"
              >
                {item.title}
              </h3>
              <div class="expertise-showcase__copy flex flex-col gap-4">
                {
                  item.description.map((paragraph, paragraphIndex) => (
                    <p
                      class="m-0 text-[0.95rem] leading-[1.55] font-light text-coffee-300"
                      data-expertise-content-copy
                      style={`--reveal-delay: ${460 + paragraphIndex * 120}ms`}
                    >
                      {paragraph}
                    </p>
                  ))
                }
              </div>
              <div class="expertise-showcase__pills flex flex-wrap gap-3 pt-1" aria-label="Points clés">
                {
                  item.pills.map((pill, pillIndex) => (
                    <span
                      class="inline-flex min-h-9 items-center rounded-full border px-3.5 py-[0.45rem] text-[0.8rem] leading-[1.2] font-normal text-coffee-300"
                      data-expertise-content-pill
                      style={`--reveal-delay: ${720 + pillIndex * 70}ms`}
                    >
                      {pill}
                    </span>
                  ))
                }
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import {
    createScrollReveal,
    queryAll,
    type ScrollReveal,
  } from "@/scripts/motion";

  function initExpertiseShowcase(root: Element) {
    if (!(root instanceof HTMLElement) || root.dataset.expertiseReady) return;

    const tabs = Array.from(
      root.querySelectorAll("[data-expertise-tab]"),
    ).filter((tab) => tab instanceof HTMLButtonElement);
    const panels = Array.from(root.querySelectorAll("[data-expertise-panel]"));
    const indicator = root.querySelector("[data-expertise-indicator]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const visualStackClasses = [
      "is-stack-0",
      "is-stack-1",
      "is-stack-2",
      "is-stack-3",
      "is-exiting",
    ];
    const visualStackTimers = new WeakMap<
      HTMLElement,
      { intervalId: number; timeoutId: number | undefined }
    >();
    const visualSwitchTimers = new WeakMap<HTMLElement, number>();
    let activePanel: HTMLElement | undefined;
    let canRunVisualStack = reducedMotion.matches;
    let hasEnteredViewport = reducedMotion.matches;
    let motion: ScrollReveal | undefined;

    const getVisualItems = (panel: HTMLElement) =>
      Array.from(panel.querySelectorAll(".expertise-showcase__visual-item"))
        .filter((item) => item instanceof HTMLElement);

    const clearVisualStack = (items: HTMLElement[]) => {
      items.forEach((item) => item.classList.remove(...visualStackClasses));
    };

    const renderVisualStack = (
      panel: HTMLElement,
      startIndex = 0,
      {
        exitingIndex,
        visibleDepth = 4,
      }: { exitingIndex?: number; visibleDepth?: number } = {},
    ) => {
      const visualItems = getVisualItems(panel);
      if (visualItems.length === 0) return;

      clearVisualStack(visualItems);

      const depth = Math.min(visibleDepth, visualItems.length);
      for (let offset = 0; offset < depth; offset += 1) {
        visualItems[(startIndex + offset) % visualItems.length]?.classList.add(
          `is-stack-${offset}`,
        );
      }

      if (exitingIndex !== undefined && Number.isInteger(exitingIndex)) {
        visualItems[exitingIndex % visualItems.length]?.classList.add(
          "is-exiting",
        );
      }
    };

    const stopVisualStack = (panel: HTMLElement) => {
      const timers = visualStackTimers.get(panel);
      if (timers?.intervalId) window.clearInterval(timers.intervalId);
      if (timers?.timeoutId) window.clearTimeout(timers.timeoutId);
      visualStackTimers.delete(panel);
      const switchTimer = visualSwitchTimers.get(panel);
      if (switchTimer) window.clearTimeout(switchTimer);
      visualSwitchTimers.delete(panel);
      panel.classList.remove("is-switching");
      clearVisualStack(getVisualItems(panel));
    };

    const playVisualSwitch = (panel: HTMLElement) => {
      panel.classList.remove("is-switching");
      void panel.offsetWidth;
      panel.classList.add("is-switching");

      const switchTimer = window.setTimeout(() => {
        panel.classList.remove("is-switching");
        visualSwitchTimers.delete(panel);
      }, 760);

      visualSwitchTimers.set(panel, switchTimer);
    };

    const startVisualStack = (panel: Element) => {
      if (!(panel instanceof HTMLElement)) return;

      stopVisualStack(panel);

      const visualItems = getVisualItems(panel);
      if (visualItems.length === 0) return;

      let startIndex = 0;
      renderVisualStack(panel, startIndex);

      if (reducedMotion.matches || visualItems.length < 4) return;

      const intervalId = window.setInterval(() => {
        const timers = visualStackTimers.get(panel);
        if (timers?.timeoutId) window.clearTimeout(timers.timeoutId);

        const exitingIndex = startIndex;
        startIndex = (startIndex + 1) % visualItems.length;

        renderVisualStack(panel, startIndex, {
          exitingIndex,
          visibleDepth: 4,
        });

        const timeoutId = window.setTimeout(() => {
          renderVisualStack(panel, startIndex);
          const currentTimers = visualStackTimers.get(panel);
          if (currentTimers) currentTimers.timeoutId = undefined;
        }, 360);

        if (timers) timers.timeoutId = timeoutId;
      }, 1850);

      visualStackTimers.set(panel, { intervalId, timeoutId: undefined });
    };

    const stopAllVisualStacks = () => {
      panels.forEach((panel) => {
        if (panel instanceof HTMLElement) stopVisualStack(panel);
      });
    };

    const moveIndicator = (tab: Element | undefined) => {
      if (!(indicator instanceof HTMLElement) || !(tab instanceof HTMLElement))
        return;

      indicator.style.setProperty("--indicator-y", `${tab.offsetTop}px`);
      indicator.style.setProperty("--indicator-h", `${tab.offsetHeight}px`);
    };

    const activate = (id: string, animateSwitch = hasEnteredViewport) => {
      let activeTab: HTMLButtonElement | undefined;
      activePanel = undefined;

      tabs.forEach((tab) => {
        const isActive = tab.dataset.expertiseTab === id;
        tab.classList.toggle("is-active", isActive);
        tab.setAttribute("aria-selected", String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
        if (isActive) activeTab = tab;
      });

      panels.forEach((panel) => {
        if (!(panel instanceof HTMLElement)) return;
        const isActive = panel.dataset.expertisePanel === id;
        panel.hidden = !isActive;
        panel.classList.toggle("is-active", isActive);
        if (isActive) {
          activePanel = panel;
        } else {
          stopVisualStack(panel);
        }
      });

      if (activePanel) {
        if (canRunVisualStack) {
          startVisualStack(activePanel);
        } else {
          renderVisualStack(activePanel);
        }

        if (animateSwitch && hasEnteredViewport) {
          playVisualSwitch(activePanel);
        }
      }
      moveIndicator(activeTab);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        const id = tab.dataset.expertiseTab;
        if (id) activate(id);
      });

      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;

        event.preventDefault();
        const nextIndex =
          event.key === "ArrowDown"
            ? (index + 1) % tabs.length
            : (index - 1 + tabs.length) % tabs.length;
        tabs[nextIndex]?.focus();
        const id = tabs[nextIndex]?.dataset.expertiseTab;
        if (id) activate(id);
      });
    });

    const initialId = tabs.find((tab) => tab.classList.contains("is-active"))
      ?.dataset.expertiseTab;
    if (initialId) activate(initialId, false);
    root.dataset.expertiseReady = "true";

    if (!reducedMotion.matches) {
      motion = createScrollReveal(
        root,
        [
          {
            at: 0,
            duration: 0.5,
            from: { opacity: 0, scale: 0.985, y: 18 },
            stagger: 0.025,
            targets: queryAll(root, "[data-expertise-heading-word]"),
          },
          {
            at: 0.1,
            duration: 0.44,
            from: { opacity: 0, y: 14 },
            targets: root.querySelector<HTMLElement>(
              "[data-expertise-description]",
            ),
          },
          {
            at: 0.14,
            duration: 0.44,
            from: { opacity: 0, x: -12 },
            targets: root.querySelector<HTMLElement>("[data-expertise-tabs]"),
          },
          {
            at: 0.16,
            duration: 0.52,
            from: { opacity: 0, scale: 0.985, y: 20 },
            targets: activePanel?.querySelector<HTMLElement>(
              "[data-expertise-visual]",
            ),
          },
          {
            at: 0.18,
            duration: 0.5,
            from: { opacity: 0, x: 16 },
            targets: activePanel?.querySelector<HTMLElement>(
              "[data-expertise-content-title]",
            ),
          },
          {
            at: 0.22,
            duration: 0.46,
            from: { opacity: 0, x: 14 },
            stagger: 0.06,
            targets: activePanel
              ? queryAll(activePanel, "[data-expertise-content-copy]")
              : [],
          },
          {
            at: 0.28,
            duration: 0.42,
            from: { opacity: 0, scale: 0.97, y: 10 },
            stagger: 0.05,
            targets: activePanel
              ? queryAll(activePanel, "[data-expertise-content-pill]")
              : [],
          },
        ],
        {
          onBegin: () => {
            hasEnteredViewport = true;
          },
          onComplete: () => {
            canRunVisualStack = true;
            if (activePanel) startVisualStack(activePanel);
          },
        },
      );
    }

    const cleanupShowcase = () => {
      motion?.revert();
      stopAllVisualStacks();
      delete root.dataset.expertiseReady;
    };

    document.addEventListener("astro:before-swap", cleanupShowcase, {
      once: true,
    });
  }

  function initExpertiseShowcases() {
    document
      .querySelectorAll("[data-expertise-showcase]")
      .forEach(initExpertiseShowcase);
  }

  initExpertiseShowcases();
  document.addEventListener("astro:page-load", initExpertiseShowcases);
</script>

<style>
  .expertise-showcase__heading-word {
    display: inline-block;
  }

  .expertise-showcase__tabs {
    align-self: start;
    align-content: start;
    background: var(--color-surface-100);
    border-radius: 2em;
    display: grid;
    gap: 0.85rem;
    max-height: 13.9rem;
    overflow-y: auto;
    padding: 1rem;
    position: relative;
  }

  .expertise-showcase__tab-indicator {
    background: var(--color-snow-50);
    border-radius: 1em;
    box-shadow: 0 18px 36px -30px rgba(34, 42, 55, 0.32);
    height: var(--indicator-h, 3rem);
    left: 1rem;
    opacity: 0;
    position: absolute;
    right: 1rem;
    top: 0;
    transform: translateY(var(--indicator-y, 1rem));
    transition:
      transform 420ms cubic-bezier(0.2, 0, 0, 1),
      height 420ms cubic-bezier(0.2, 0, 0, 1),
      opacity 180ms cubic-bezier(0.2, 0, 0, 1);
  }

  .expertise-showcase[data-expertise-ready] .expertise-showcase__tab-indicator {
    opacity: 1;
  }

  .expertise-showcase__tab {
    align-items: center;
    background: transparent;
    border: 0;
    border-radius: 1em;
    color: var(--color-gray-900);
    display: flex;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 400;
    gap: 0.75em;
    min-height: 3rem;
    opacity: 0.5;
    padding: 0.5em 1.5em 0.5em 0.5em;
    position: relative;
    text-align: left;
    transition:
      color 220ms cubic-bezier(0.2, 0, 0, 1),
      opacity 220ms cubic-bezier(0.2, 0, 0, 1),
      transform 220ms cubic-bezier(0.2, 0, 0, 1);
    width: 100%;
    z-index: 1;
  }

  .expertise-showcase__tab.is-active {
    color: var(--color-gray-900);
    opacity: 1;
  }

  .expertise-showcase:not([data-expertise-ready])
    .expertise-showcase__tab.is-active {
    background: var(--color-snow-50);
    box-shadow: 0 18px 36px -30px rgba(34, 42, 55, 0.32);
  }

  .expertise-showcase__tab:focus-visible {
    outline: 2px solid var(--color-blue-400);
    outline-offset: 3px;
  }

  .expertise-showcase__tab:active {
    transform: scale(0.98);
  }

  .expertise-showcase__tab:nth-of-type(1) {
    --tab-icon-bg: #4169e1;
    --tab-icon-shadow: rgba(65, 105, 225, 0.65);
  }

  .expertise-showcase__tab:nth-of-type(2) {
    --tab-icon-bg: #3aa4d8;
    --tab-icon-shadow: rgba(58, 164, 216, 0.62);
  }

  .expertise-showcase__tab:nth-of-type(3) {
    --tab-icon-bg: #6957df;
    --tab-icon-shadow: rgba(105, 87, 223, 0.64);
  }

  .expertise-showcase__tab:nth-of-type(4) {
    --tab-icon-bg: #32aeb4;
    --tab-icon-shadow: rgba(50, 174, 180, 0.6);
  }

  .expertise-showcase__tab:nth-of-type(5) {
    --tab-icon-bg: #557ee8;
    --tab-icon-shadow: rgba(85, 126, 232, 0.64);
  }

  .expertise-showcase__tab:nth-of-type(6) {
    --tab-icon-bg: #5367d8;
    --tab-icon-shadow: rgba(83, 103, 216, 0.64);
  }

  .expertise-showcase__tab-icon {
    align-items: center;
    background: var(--tab-icon-bg, var(--color-blue-500));
    border-radius: 0.875em;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      0 12px 24px -16px var(--tab-icon-shadow, rgba(62, 96, 212, 0.7));
    color: var(--color-snow-50);
    display: inline-flex;
    flex: 0 0 auto;
    height: 2rem;
    justify-content: center;
    width: 2rem;
  }

  .expertise-showcase__tab-icon svg {
    height: 1.05rem;
    width: 1.05rem;
  }

  .expertise-showcase__panel[hidden] {
    display: none;
  }

  .expertise-showcase__visual {
    align-items: center;
    align-self: start;
    background: var(--color-surface-100);
    border-radius: 2rem;
    display: flex;
    height: 20rem;
    justify-content: center;
    min-height: 20rem;
    overflow: hidden;
    padding: 2rem;
  }

  .expertise-showcase__browser {
    align-items: center;
    background: rgba(255, 255, 255, 0.14);
    border: 2px solid var(--color-snow-50);
    border-radius: 1.75rem;
    display: flex;
    flex-direction: column;
    min-height: 17rem;
    padding: 1.5rem 0;
    position: relative;
    width: min(21rem, 100%);
  }

  .expertise-showcase__browser::before {
    background: rgba(255, 255, 255, 0.32);
    border-bottom: 2px solid var(--color-snow-50);
    border-radius: 1.65rem 1.65rem 0 0;
    content: "";
    height: 3.2rem;
    inset: 0 0 auto;
    position: absolute;
  }

  .expertise-showcase__browser-dots {
    align-items: center;
    background: rgba(255, 255, 255, 0.68);
    border: 1px solid var(--color-snow-50);
    border-radius: 9999px;
    display: flex;
    gap: 0.38rem;
    left: 1rem;
    min-height: 1.35rem;
    padding: 0 0.55rem;
    position: absolute;
    top: 0.9rem;
    z-index: 1;
  }

  .expertise-showcase__browser-dots span {
    border-radius: 9999px;
    height: 0.38rem;
    width: 0.38rem;
  }

  .expertise-showcase__browser-dots span:nth-child(1) {
    background: #ff4b55;
  }

  .expertise-showcase__browser-dots span:nth-child(2) {
    background: #ffca28;
  }

  .expertise-showcase__browser-dots span:nth-child(3) {
    background: #2fc75a;
  }

  .expertise-showcase__visual-list {
    --visual-gap: 0.8rem;
    --visual-item-size: 3rem;
    --visual-step: calc(var(--visual-item-size) + var(--visual-gap));

    height: calc(var(--visual-item-size) * 4 + var(--visual-gap) * 3);
    margin-top: 2.95rem;
    position: relative;
    width: min(24rem, 112%);
    z-index: 1;
  }

  .expertise-showcase__visual-item {
    align-items: center;
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid var(--color-gray-200);
    border-radius: 0.875rem;
    box-shadow: 0 16px 34px -28px rgba(34, 42, 55, 0.32);
    color: var(--color-gray-800);
    display: flex;
    font-size: 0.86rem;
    font-weight: 500;
    gap: 0.65rem;
    height: var(--visual-item-size);
    inset: 0 0 auto;
    filter: blur(4px);
    opacity: 0;
    padding: 0.65rem 0.9rem;
    position: absolute;
    transform: translateY(calc(var(--visual-step) * 3)) scale(0.88);
    transform-origin: center top;
    transition:
      opacity 420ms cubic-bezier(0.2, 0, 0, 1),
      transform 520ms cubic-bezier(0.2, 0, 0, 1),
      filter 420ms cubic-bezier(0.2, 0, 0, 1);
    white-space: nowrap;
    will-change: opacity, transform, filter;
  }

  .expertise-showcase:not([data-expertise-ready])
    .expertise-showcase__visual-item:nth-child(1),
  .expertise-showcase__visual-item.is-stack-0 {
    filter: none;
    opacity: 1;
    transform: translateY(0) scale(1);
    z-index: 3;
  }

  .expertise-showcase:not([data-expertise-ready])
    .expertise-showcase__visual-item:nth-child(2),
  .expertise-showcase__visual-item.is-stack-1 {
    filter: none;
    opacity: 0.64;
    transform: translateY(var(--visual-step)) scale(0.95);
    z-index: 2;
  }

  .expertise-showcase:not([data-expertise-ready])
    .expertise-showcase__visual-item:nth-child(3),
  .expertise-showcase__visual-item.is-stack-2 {
    filter: none;
    opacity: 0.4;
    transform: translateY(calc(var(--visual-step) * 2)) scale(0.9);
    z-index: 1;
  }

  .expertise-showcase:not([data-expertise-ready])
    .expertise-showcase__visual-item:nth-child(4),
  .expertise-showcase__visual-item.is-stack-3 {
    filter: none;
    opacity: 0.22;
    transform: translateY(calc(var(--visual-step) * 3)) scale(0.86);
    z-index: 0;
  }

  .expertise-showcase__visual-item.is-exiting {
