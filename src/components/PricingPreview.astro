---
import AnimationRepeat from "./icons/nucleo/animation-repeat-fill.svg";
import BadgeDollar from "./icons/nucleo/badge-dollar-fill.svg";
import Msgs from "./icons/nucleo/msgs-fill.svg";
import ViewAll from "./icons/nucleo/view-all-fill.svg";
import WaveText from "./ui/WaveText.astro";

const formatEuro = (value: number) =>
    new Intl.NumberFormat("fr-FR").format(value);

const sitePricingOptions = [
    { icon: "paint", label: "Animations", price: 500 },
    { icon: "message", label: "Formulaire contact personnalisé", price: 500 },
    { icon: "cms", label: "CMS / contenus modifiables", price: 1000 },
    { icon: "ads", label: "Google Ads", quote: true },
] as const;

const pricingCards = [
    {
        title: "Site web",
        subtitle:
            "Pour lancer, clarifier ou moderniser une présence web qui inspire confiance.",
        priceValue: 2000,
        delay: "Livré en 10 jours à 5 semaines selon périmètre",
        cta: "Parlons de votre site web",
        variant: "blue",
        features: [
            "Architecture et parcours de conversion",
            "Design responsive sur mesure",
            "Développement front-end propre",
            "SEO technique et performance",
            "Mise en ligne",
        ],
    },
    {
        title: "Interface produit",
        subtitle:
            "Pour construire ou améliorer un SaaS, dashboard, espace client ou outil métier.",
        price: "Sur devis",
        budget: "Cadrage possible dès 900 € HT",
        delay: "Planning défini après lecture du périmètre",
        cta: "Cadrer votre interface",
        footnote:
            "Le prix dépend surtout des écrans, états, rôles, données et intégrations.",
        variant: "dark",
        features: [
            "Intégration Figma ou design système",
            "React / Next.js",
            "Authentification ou espace client",
            "Dashboard ou back-office",
            "IA, paiement ou API externe",
            "Mise en ligne",
        ],
    },
] as const;
---

<section
    id="tarifs"
    class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-8 md:py-16"
    aria-labelledby="pricing-title"
>
    <div class="mx-auto flex max-w-4xl flex-col items-center gap-4 text-center">
        <h2 id="pricing-title" class="section-heading">
            Un site clair à lancer. Simple à faire évoluer.
        </h2>
        <p class="section-subheading">
            Chaque projet dépend du nombre de pages, du contenu, du niveau de
            design, des animations et des fonctionnalités attendues. Voici des
            budgets de départ pour vous aider à vous situer avant un premier
            échange.
        </p>
    </div>

    <div
        class="mx-auto mt-12 grid max-w-lg grid-cols-1 gap-4 lg:max-w-4xl lg:grid-cols-2"
    >
        {
            pricingCards.map((card) => (
                <article
                    class:list={[
                        "flex min-h-0 flex-col overflow-hidden rounded-4xl text-snow-50",
                        card.variant === "blue"
                            ? "border-white/10 bg-blue-500 shadow-[0_28px_70px_-48px_rgba(66,102,219,0.85)]"
                            : "border-white/10 bg-coffee-300 shadow-[0_28px_70px_-50px_rgba(34,42,55,0.8)]",
                    ]}
                    data-pricing-card={
                        "priceValue" in card ? "site" : undefined
                    }
                >
                    <div class="mx-1 mt-1 min-h-0 rounded-3xl bg-white/10 p-8 ring ring-white/5">
                        <h3 class="mb-4 text-2xl font-normal leading-none tracking-tight text-inherit">
                            {card.title}
                        </h3>
                        <p class="text-xl font-light tracking-tight text-snow-50">
                            {card.subtitle}
                        </p>
                    </div>

                    <div class="mx-8 my-10 flex flex-col">
                        {"priceValue" in card ? (
                            <strong class="flex flex-col gap-1 font-semibold leading-none tracking-tight text-inherit">
                                <span
                                    class="text-sm font-light leading-none tracking-tight text-snow-50/90"
                                    data-pricing-prefix
                                >
                                    À partir de
                                </span>
                                <span class="inline-flex items-baseline whitespace-nowrap text-5xl font-semibold tracking-tight text-snow-50 [font-variant-numeric:tabular-nums]">
                                    <span
                                        class="inline-block min-w-[4.25ch] [font-variant-numeric:tabular-nums]"
                                        data-pricing-price
                                        data-value={card.priceValue}
                                    >
                                        {formatEuro(card.priceValue)}
                                    </span>
                                    <span data-pricing-suffix>€ HT</span>
                                </span>
                            </strong>
                        ) : (
                            <strong class="text-5xl font-semibold leading-none tracking-tight text-inherit">
                                {card.price}
                            </strong>
                        )}
                        {"budget" in card && (
                            <span class="text-sm font-light tracking-tight text-snow-50/90">
                                {card.budget}
                            </span>
                        )}
                        <span class="text-sm font-light tracking-tight text-snow-50/90">
                            {card.delay}
                        </span>
                    </div>

                    {"priceValue" in card && (
                        <div class="grid px-8" data-pricing-site>
                            {sitePricingOptions.map((option) => (
                                <label class="relative flex min-h-10 cursor-pointer items-center justify-between gap-4 text-inherit">
                                    <span class="inline-flex min-w-0 items-center gap-3">
                                        <span
                                            class="inline-flex size-6 flex-none items-center justify-center text-snow-50/80 [&>svg]:size-full"
                                            aria-hidden="true"
                                        >
                                            {option.icon === "paint" && (
                                                <AnimationRepeat />
                                            )}
                                            {option.icon === "message" && <Msgs />}
                                            {option.icon === "cms" && <ViewAll />}
                                            {option.icon === "ads" && <BadgeDollar />}
                                        </span>
                                        <span class="text-base font-normal tracking-tight">
                                            {option.label}
                                        </span>
                                    </span>
                                    <input
                                        class="relative z-1 h-5 w-9 flex-none cursor-pointer appearance-none rounded-full bg-white/20 transition-colors after:absolute after:left-0.5 after:top-0.5 after:size-4 after:rounded-full after:bg-snow-50 after:shadow-[0_0.2rem_0.5rem_rgba(34,42,55,0.18)] after:transition-transform after:content-[''] checked:bg-snow-50 checked:after:translate-x-4 checked:after:bg-blue-500 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-snow-50"
                                        type="checkbox"
                                        data-pricing-option
                                        data-price={"price" in option ? option.price : undefined}
                                        data-quote={"quote" in option ? "true" : undefined}
                                    />
                                </label>
                            ))}
                        </div>
                    )}

                    <ul class="mx-8 my-10 flex flex-col gap-2">
                        {card.features.map((feature) => (
                            <li class="flex items-baseline gap-4 text-sm font-normal tracking-tight text-snow-50">
                                <span
                                    class="mt-[0.08em] h-[0.72rem] w-[0.38rem] flex-none rotate-45 border-r-[1.8px] border-b-[1.8px] border-current"
                                    aria-hidden="true"
                                />
                                <span>{feature}</span>
                            </li>
                        ))}
                    </ul>

                    {"footnote" in card && (
                        <p class="mx-8 mb-10 text-sm leading-normal tracking-tight text-snow-50/80">
                            {card.footnote}
                        </p>
                    )}

                    <button
                        aria-controls="cal-drawer"
                        aria-haspopup="dialog"
                        class="mx-8 mb-8 mt-auto inline-flex min-h-14 cursor-pointer items-center justify-center rounded-xl border-0 bg-snow-50 px-5 font-medium text-coffee-300 shadow-[0_24px_46px_-22px_rgba(14,23,37,0.58),inset_0_-2px_5px_rgba(34,42,55,0.08),inset_0_0_0_1px_rgba(34,42,55,0.06)] transition-shadow hover:shadow-[0_30px_58px_-22px_rgba(14,23,37,0.72),inset_0_-2px_7px_rgba(34,42,55,0.1),inset_0_0_0_1px_rgba(34,42,55,0.08)] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-blue-500"
                        data-cal-location={`pricing-${card.title.toLowerCase().replaceAll(" ", "-")}`}
                        data-cal-open
                        type="button"
                    >
                        <WaveText text={card.cta} trigger="parent" />
                    </button>
                </article>
            ))
        }
    </div>

    <a
        class="group relative mx-auto mt-12 table text-base font-normal text-gray-900 no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
        href="#faq"
    >
        Voir ce qui fait varier un devis
        <span
            class="absolute left-0 bottom-0 h-px w-full origin-left scale-x-0 bg-gray-900 transition-transform duration-300 ease-out group-hover:scale-x-100 group-focus-visible:scale-x-100"
            aria-hidden="true"></span>
    </a>
</section>

<script>
    import { animate, utils } from "animejs";

    const pricingFormatter = new Intl.NumberFormat("fr-FR");
    const activePricingControllers = new WeakMap<HTMLElement, () => void>();

    const cleanupPricingCalculators = () => {
        document
            .querySelectorAll<HTMLElement>('[data-pricing-card="site"]')
            .forEach((root) => {
                activePricingControllers.get(root)?.();
                activePricingControllers.delete(root);
            });
    };

    const initPricingCalculators = () => {
        document
            .querySelectorAll<HTMLElement>('[data-pricing-card="site"]')
            .forEach((root) => {
                if (root.dataset.pricingReady === "true") return;

                const priceTarget = root.querySelector<HTMLElement>(
                    "[data-pricing-price]",
                );
                const options = Array.from(
                    root.querySelectorAll<HTMLInputElement>(
                        "[data-pricing-option]",
                    ),
                );
                const prefixTarget = root.querySelector<HTMLElement>(
                    "[data-pricing-prefix]",
                );
                const suffixTarget = root.querySelector<HTMLElement>(
                    "[data-pricing-suffix]",
                );

                if (!priceTarget) return;

                const baseValue = Number(priceTarget.dataset.value) || 0;
                const state = { value: baseValue };
                let animation: ReturnType<typeof animate> | undefined;
                const controller = new AbortController();

                const renderPrice = (value: number) => {
                    const roundedValue = Math.round(value);
                    priceTarget.textContent =
                        pricingFormatter.format(roundedValue);
                    priceTarget.dataset.value = String(roundedValue);
                };

                const getPrice = () =>
                    baseValue +
                    options.reduce(
                        (total, option) =>
                            total +
                            (option.checked
                                ? Number(option.dataset.price) || 0
                                : 0),
                        0,
                    );

                const updatePrice = () => {
                    const hasQuoteOption = options.some(
                        (option) =>
                            option.checked && option.dataset.quote === "true",
                    );

                    if (hasQuoteOption) {
                        animation?.cancel();
                        prefixTarget?.setAttribute("hidden", "");
                        suffixTarget?.setAttribute("hidden", "");
                        priceTarget.textContent = "Sur devis";
                        return;
                    }

                    const nextValue = getPrice();

                    animation?.cancel();
                    prefixTarget?.removeAttribute("hidden");
                    suffixTarget?.removeAttribute("hidden");

                    if (
                        window.matchMedia("(prefers-reduced-motion: reduce)")
                            .matches
                    ) {
                        state.value = nextValue;
                        renderPrice(nextValue);
                        return;
                    }

                    animation = animate(state, {
                        value: nextValue,
                        duration: 720,
                        ease: "out(4)",
                        modifier: utils.round(0),
                        onRender: () => renderPrice(state.value),
                    });
                };

                options.forEach((option) => {
                    option.addEventListener("change", updatePrice, {
                        signal: controller.signal,
                    });
                });

                root.dataset.pricingReady = "true";
                updatePrice();
                activePricingControllers.set(root, () => {
                    animation?.cancel();
                    controller.abort();
                    delete root.dataset.pricingReady;
                });
            });
    };

    const pricingWindow = window as Window & {
        __wuiPricingPreviewReady?: boolean;
    };

    initPricingCalculators();

    if (!pricingWindow.__wuiPricingPreviewReady) {
        pricingWindow.__wuiPricingPreviewReady = true;
        document.addEventListener(
            "astro:before-swap",
            cleanupPricingCalculators,
        );
        document.addEventListener("astro:page-load", initPricingCalculators);
    }
</script>
