---
import ChevronUp from "@/components/icons/nucleo/chevron-up-fill.svg";

export type TableOfContentsItem = {
    depth: number;
    slug: string;
    text: string;
};

interface Props {
    class?: string;
    items: TableOfContentsItem[];
    title?: string;
}

const {
    class: className = "",
    items,
    title = "Table des matières",
} = Astro.props;
const visibleItems = items.filter((item) => item.slug && item.text);
const listId = "page-toc-list";
---

{
    visibleItems.length > 0 && (
        <nav
            aria-label={title}
            class:list={["page-toc", className]}
            data-page-toc
            data-toc-open="false"
        >
            <button
                aria-controls={listId}
                aria-expanded="false"
                class="page-toc__toggle"
                data-page-toc-toggle
                type="button"
            >
                <span class="page-toc__toggle-label">
                    {title}
                    <span class="page-toc__count">({visibleItems.length})</span>
                </span>
                <ChevronUp
                    aria-hidden="true"
                    class="page-toc__chevron size-3.5"
                />
            </button>
            <p class="page-toc__title">{title}</p>
            <ol class="page-toc__list" id={listId}>
                {visibleItems.map((item) => (
                    <li
                        class:list={[
                            "page-toc__item",
                            item.depth > 2 && "page-toc__item--nested",
                        ]}
                    >
                        <a
                            class="page-toc__link"
                            href={`#${item.slug}`}
                            data-page-toc-link
                            data-page-toc-target={item.slug}
                        >
                            {item.text}
                        </a>
                    </li>
                ))}
            </ol>
        </nav>
    )
}

<script>
    const pageTocWindow = window as Window & {
        __wuiPageTocReady?: boolean;
    };

    const initTocToggles = () => {
        document.querySelectorAll<HTMLElement>("[data-page-toc]").forEach((toc) => {
            if (toc.dataset.tocToggleReady === "true") return;
            toc.dataset.tocToggleReady = "true";
            toc.dataset.tocJs = "true";

            const toggle = toc.querySelector<HTMLButtonElement>(
                "[data-page-toc-toggle]",
            );
            if (!toggle) return;

            const setOpen = (open: boolean) => {
                toc.dataset.tocOpen = open ? "true" : "false";
                toggle.setAttribute("aria-expanded", String(open));
            };

            toggle.addEventListener("click", () => {
                setOpen(toc.dataset.tocOpen !== "true");
            });

            // Sur mobile, referme le sommaire après un clic sur une section.
            toc.querySelectorAll<HTMLAnchorElement>("[data-page-toc-link]").forEach(
                (link) => {
                    link.addEventListener("click", () => {
                        if (window.matchMedia("(max-width: 1023px)").matches) {
                            setOpen(false);
                        }
                    });
                },
            );
        });
    };

    const keepActiveLinkVisible = (
        toc: HTMLElement,
        activeLink: HTMLAnchorElement,
    ) => {
        const scroller = toc.closest<HTMLElement>(
            ".article-toc-column, .realisation-toc-column",
        );
        if (!scroller || scroller.scrollHeight <= scroller.clientHeight + 2) {
            return;
        }

        const scrollerRect = scroller.getBoundingClientRect();
        const linkRect = activeLink.getBoundingClientRect();
        const pad = 28;

        if (linkRect.top < scrollerRect.top + pad) {
            scroller.scrollTop += linkRect.top - (scrollerRect.top + pad);
        } else if (linkRect.bottom > scrollerRect.bottom - pad) {
            scroller.scrollTop += linkRect.bottom - (scrollerRect.bottom - pad);
        }
    };

    const updatePageTocs = () => {
        document.querySelectorAll<HTMLElement>("[data-page-toc]").forEach((toc) => {
            const links = Array.from(
                toc.querySelectorAll<HTMLAnchorElement>("[data-page-toc-link]"),
            );

            if (links.length === 0) return;

            const sections: {
                id: string;
                link: HTMLAnchorElement;
                section: HTMLElement;
            }[] = [];

            links.forEach((link) => {
                const id = link.dataset.pageTocTarget;
                const section = id ? document.getElementById(id) : null;

                if (id && section) {
                    sections.push({ id, link, section });
                }
            });

            if (sections.length === 0) return;

            const activationY = Math.min(window.innerHeight * 0.36, 240);
            let activeId = sections[0]?.id;

            for (const item of sections) {
                if (item.section.getBoundingClientRect().top <= activationY) {
                    activeId = item.id;
                } else {
                    break;
                }
            }

            let activeLink: HTMLAnchorElement | undefined;
            links.forEach((link) => {
                const isActive = link.dataset.pageTocTarget === activeId;
                link.toggleAttribute("aria-current", isActive);
                if (isActive) {
                    activeLink = link;
                }
            });

            if (activeLink && toc.dataset.lastActiveId !== activeId) {
                toc.dataset.lastActiveId = activeId ?? "";
                keepActiveLinkVisible(toc, activeLink);
            }
        });
    };

    const initAll = () => {
        initTocToggles();
        updatePageTocs();
    };

    if (!pageTocWindow.__wuiPageTocReady) {
        pageTocWindow.__wuiPageTocReady = true;
        window.addEventListener("scroll", updatePageTocs, { passive: true });
        window.addEventListener("resize", updatePageTocs);
        document.addEventListener("astro:after-swap", initAll);
        document.addEventListener("astro:page-load", initAll);
    }

    initAll();
</script>

<style>
    .page-toc {
        color: var(--color-gray-600);
        font-size: 0.9rem;
    }

    .page-toc__toggle {
        align-items: center;
        background: var(--color-surface-muted);
        border: 1px solid var(--color-gray-200);
        border-radius: 1rem;
        color: var(--color-gray-900);
        display: none;
        font-size: 0.875rem;
        font-weight: 500;
        justify-content: space-between;
        min-height: 3rem;
        padding: 0.75rem 1rem;
        text-align: left;
        width: 100%;
    }

    .page-toc__toggle:focus-visible {
        outline: 2px solid var(--color-blue-500);
        outline-offset: 3px;
    }

    .page-toc__toggle-label {
        align-items: baseline;
        display: inline-flex;
        gap: 0.4rem;
    }

    .page-toc__count {
        color: var(--color-gray-600);
        font-size: 0.8125rem;
        font-weight: 400;
    }

    .page-toc__chevron {
        color: var(--color-gray-600);
        flex: none;
        transform: rotate(180deg);
        transition: transform 180ms ease;
    }

    .page-toc[data-toc-open="true"] .page-toc__chevron {
        transform: rotate(0deg);
    }

    .page-toc__title {
        color: var(--color-gray-600);
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        margin: 0 0 1.25rem;
        text-transform: uppercase;
    }

    .page-toc__list {
        border-left: 1px solid var(--color-gray-200);
        display: grid;
        gap: 0.65rem;
        list-style: none;
        margin: 0;
        padding: 0 0 0 1.1rem;
    }

    /* Sur mobile (< 1024 px), une fois le script actif, le sommaire devient un
       panneau repliable fermé par défaut (compatible tous navigateurs, y compris
       Safari < 17). Sans JS, le titre et la liste restent directement visibles. */
    @media (max-width: 1023px) {
        .page-toc[data-toc-js="true"] .page-toc__toggle {
            display: flex;
        }

        .page-toc[data-toc-js="true"] .page-toc__title {
            display: none;
        }

        .page-toc[data-toc-js="true"] .page-toc__list {
            margin-top: 0.9rem;
        }

        .page-toc[data-toc-js="true"][data-toc-open="false"] .page-toc__list {
            display: none;
        }
    }

    .page-toc__item {
        margin: 0;
        position: relative;
    }

    .page-toc__item::before {
        background: var(--color-gray-200);
        content: "";
        height: 1px;
        left: -1.1rem;
        position: absolute;
        top: 0.72em;
        transition: background-color 180ms ease;
        width: 0.72rem;
    }

    .page-toc__item:has(.page-toc__link[aria-current])::before {
        background: var(--color-blue-500);
    }

    .page-toc__item--nested {
        padding-left: 0.8rem;
    }

    .page-toc__link {
        color: inherit;
        display: inline-flex;
        font-weight: 400;
        line-height: 1.35;
        max-width: 100%;
        text-decoration: none;
        transition:
            color 180ms ease,
            transform 180ms ease;
    }

    @media (min-width: 1024px) {
        .page-toc__link {
            max-width: 13.5rem;
        }
    }

    .page-toc__item--nested .page-toc__link {
        font-size: 0.82rem;
    }

    .page-toc__link[aria-current] {
        color: var(--color-blue-500);
        transform: translateX(0.18rem);
    }

    @media (hover: hover) {
        .page-toc__link:hover {
            color: var(--color-gray-900);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .page-toc__chevron,
        .page-toc__link,
        .page-toc__item::before {
            transition: none;
        }
    }
</style>
