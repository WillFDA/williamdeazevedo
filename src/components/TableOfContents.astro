---
import ChevronUp from "./icons/nucleo/chevron-up-fill.svg";
import TableOfContentsList from "./TableOfContentsList.astro";

export type TableOfContentsItem = {
    depth: number;
    slug: string;
    text: string;
};

interface Props {
    items: TableOfContentsItem[];
    title?: string;
}

const { items, title = "Table des matières" } = Astro.props;
const visibleItems = items.filter((item) => item.slug && item.text);
---

{/* Sous lg, sommaire replié par défaut (<details> natif, sans JS) ; dès lg,
    colonne latérale. Une seule des deux navs est affichée à chaque largeur. */}
{
    visibleItems.length > 0 && (
        <>
            <details class="page-toc-details">
                <summary class="page-toc-details__summary">
                    Sommaire
                    <span class="page-toc-details__icon" aria-hidden="true">
                        <ChevronUp class="size-3.5" />
                    </span>
                </summary>
                <nav aria-label={title} class="page-toc">
                    <TableOfContentsList items={visibleItems} />
                </nav>
            </details>
            <nav aria-label={title} class="page-toc page-toc--sidebar">
                <p class="page-toc__title">{title}</p>
                <TableOfContentsList items={visibleItems} />
            </nav>
        </>
    )
}

<script>
    const pageTocWindow = window as Window & {
        __wuiPageTocReady?: boolean;
    };

    // Liens des deux sommaires et titres ciblés (ordre du document), relus à
    // chaque page.
    let links: HTMLAnchorElement[] = [];
    let headings: HTMLElement[] = [];
    let frame = 0;

    const collectPageToc = () => {
        links = Array.from(
            document.querySelectorAll<HTMLAnchorElement>("[data-page-toc-link]"),
        );
        const ids = new Set(links.map((link) => link.dataset.pageTocTarget));
        headings = [...ids].flatMap((id) => {
            const heading = id ? document.getElementById(id) : null;
            return heading ? [heading] : [];
        });
    };

    // Une passe par frame : toutes les lectures de position d'abord, puis les
    // écritures, pour ne forcer qu'une mise en page.
    const updatePageToc = () => {
        frame = 0;
        const activationY = Math.min(window.innerHeight * 0.36, 240);
        let activeId = headings[0]?.id;

        for (const heading of headings) {
            if (heading.getBoundingClientRect().top > activationY) break;
            activeId = heading.id;
        }

        for (const link of links) {
            link.toggleAttribute(
                "aria-current",
                link.dataset.pageTocTarget === activeId,
            );
        }
    };

    const schedulePageToc = () => {
        if (frame || links.length === 0) return;
        frame = requestAnimationFrame(updatePageToc);
    };

    const setupPageToc = () => {
        collectPageToc();
        schedulePageToc();
    };

    if (!pageTocWindow.__wuiPageTocReady) {
        pageTocWindow.__wuiPageTocReady = true;
        window.addEventListener("scroll", schedulePageToc, { passive: true });
        window.addEventListener("resize", schedulePageToc);
        document.addEventListener("astro:page-load", setupPageToc);
    }

    setupPageToc();
</script>

<style>
    .page-toc {
        color: var(--color-gray-600);
        font-size: 0.9rem;
    }

    .page-toc__title {
        color: var(--color-gray-600);
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        margin: 0 0 1.25rem;
        text-transform: uppercase;
    }

    .page-toc-details {
        background: var(--color-surface-muted);
        border-radius: 1rem;
    }

    .page-toc-details__summary {
        align-items: center;
        border-radius: inherit;
        color: var(--color-gray-900);
        cursor: pointer;
        display: flex;
        font-weight: 500;
        gap: 1rem;
        justify-content: space-between;
        line-height: 1.5rem;
        list-style: none;
        padding: 1rem 1.25rem;
    }

    .page-toc-details__summary::-webkit-details-marker {
        display: none;
    }

    .page-toc-details__summary:focus-visible {
        outline: 2px solid var(--color-blue-500);
        outline-offset: 2px;
    }

    .page-toc-details__icon {
        display: inline-flex;
        transform: rotate(180deg);
        transition: transform 150ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .page-toc-details[open] .page-toc-details__icon {
        transform: none;
    }

    .page-toc-details .page-toc {
        padding: 0 1.25rem 1.25rem;
    }

    .page-toc--sidebar {
        display: none;
    }

    @media (min-width: 1024px) {
        .page-toc-details {
            display: none;
        }

        .page-toc--sidebar {
            display: block;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .page-toc-details__icon {
            transition: none;
        }
    }
</style>
