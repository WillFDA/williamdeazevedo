---
import { Image } from "astro:assets";
import Msgs from "./icons/nucleo/msgs-fill.svg";
import UserHeart from "./icons/nucleo/user-heart-fill.svg";
import ViewAll from "./icons/nucleo/view-all-fill.svg";
import WindowLayout from "./icons/nucleo/window-layout-fill.svg";
import DarkCalloutShell from "./ui/DarkCalloutShell.astro";
import williamPortrait from "../assets/williamdeazevedo.webp";

interface Props {
    title: string;
}

const { title } = Astro.props;
const titleWords = title.replace("design !", "design\u00A0!").split(" ");
const aboutPoints = [
    {
        description:
            "Design graphique, motion design puis développement web : un parcours complet au service d'interfaces claires.",
        icon: "window-layout",
        title: "+10 ans d'expérience",
    },
    {
        description:
            "Des collaborations cadrées, avec des décisions lisibles et des livraisons fiables.",
        icon: "users",
        title: "+10 clients satisfaits",
    },
    {
        description:
            "Une approche B2B et produit qui relie clarté, usage et contraintes techniques.",
        icon: "product",
        title: "Culture produit SaaS",
    },
];
---

<DarkCalloutShell
    class="about-callout"
    data-about-callout
    data-section-reveal="false"
>
        <div class="mx-auto flex max-w-4xl flex-col items-center gap-6 text-center md:gap-7">
            <h2 class="section-heading section-heading--inverse flex flex-wrap justify-center gap-x-[0.18em]">
                {
                    titleWords.map((word, index) => {
                        const cleanWord = word.replace("\u00A0", " ");
                        const normalizedWord = cleanWord
                            .replace(/[,.!]+$/, "")
                            .trim();
                        const isWilliam = cleanWord === "William,";
                        const isPill =
                            normalizedWord === "développeur" ||
                            normalizedWord === "design";

                        return (
                            <Fragment>
                                <span
                                    class:list={[
                                        "about-callout-title-word",
                                        isPill && "title-pill",
                                        isWilliam &&
                                            "about-callout-title-word--with-avatar",
                                        isWilliam
                                            ? "inline-flex items-center"
                                            : "inline-block",
                                        "text-snow-50",
                                    ]}
                                    data-about-callout-word
                                >
                                    {isWilliam ? (
                                        <>
                                            William
                                            <span
                                                class="about-callout-avatar"
                                                aria-hidden="true"
                                            >
                                                <Image
                                                    class="block size-full object-contain"
                                                    src={williamPortrait}
                                                    alt=""
                                                    width={72}
                                                    height={72}
                                                    loading="eager"
                                                />
                                            </span>
                                            ,
                                        </>
                                    ) : (
                                        cleanWord
                                    )}
                                </span>
                                {index < titleWords.length - 1 && " "}
                            </Fragment>
                        );
                    })
                }
            </h2>
            <p
                class="section-subheading section-subheading--inverse"
                data-about-callout-copy
            >
                J'aide à transformer un site daté, une première présence ou une
                idée produit en interface claire, accessible et crédible, avec un
                accompagnement qui relie design, front-end et logique métier.
                Basé à Achères, je travaille notamment pour les indépendants et TPE
                qui cherchent une
                <a
                    class="text-snow-50 underline decoration-coffee-50/50 underline-offset-4 hover:decoration-snow-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                    href="/creation-site-internet-yvelines/"
                    >création de site internet dans les Yvelines</a
                >.
            </p>
        </div>
        <ul class="mx-auto grid w-full max-w-5xl gap-4 sm:grid-cols-3">
            {
                aboutPoints.map((point) => (
                    <li
                        class="flex flex-col gap-4 rounded-xl bg-gray-800 p-4 text-snow-50 shadow-[0_18px_44px_-30px_rgba(14,20,32,0.55)]"
                        data-about-callout-card
                    >
                        <div class="flex items-center gap-3">
                            <span class="about-callout-proof-card__icon inline-flex size-8 shrink-0 items-center justify-center rounded-lg bg-blue-500 text-snow-50">
                                {point.icon === "window-layout" && (
                                    <WindowLayout
                                        aria-hidden="true"
                                        class="size-5"
                                    />
                                )}
                                {point.icon === "users" && (
                                    <UserHeart
                                        aria-hidden="true"
                                        class="size-5"
                                    />
                                )}
                                {point.icon === "product" && (
                                    <ViewAll
                                        aria-hidden="true"
                                        class="size-5"
                                    />
                                )}
                            </span>
                            <h3 class="text-base font-medium leading-tight text-snow-50">
                                {point.title}
                            </h3>
                        </div>
                        <p class="text-sm font-light leading-6 text-coffee-50">
                            {point.description}
                        </p>
                    </li>
                ))
            }
        </ul>
        <button
            aria-controls="cal-drawer"
            aria-haspopup="dialog"
            class="about-callout-cta mx-auto inline-flex min-h-14 w-fit max-w-full items-center justify-center gap-5 rounded-xl px-8 py-3 text-base font-normal focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-blue-500"
            data-about-callout-cta
            data-cal-location="about"
            data-cal-open
            type="button"
        >
            <Msgs
                aria-hidden="true"
                class="about-callout-cta__icon size-5"
            />
            <span>Me contacter</span>
        </button>
        <slot />
</DarkCalloutShell>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const activeAboutCalloutMotion = new WeakMap<HTMLElement, () => void>();

    const cleanupAboutCallouts = () => {
        document
            .querySelectorAll<HTMLElement>("[data-about-callout]")
            .forEach((callout) => {
                activeAboutCalloutMotion.get(callout)?.();
                activeAboutCalloutMotion.delete(callout);
                delete callout.dataset.aboutCalloutReady;
            });
    };

    const initAboutCallouts = () => {
        let didCreateMotion = false;

        document
            .querySelectorAll<HTMLElement>("[data-about-callout]")
            .forEach((callout) => {
                if (callout.dataset.aboutCalloutReady === "true") return;
                callout.dataset.aboutCalloutReady = "true";

                if (
                    window.matchMedia("(prefers-reduced-motion: reduce)")
                        .matches
                ) {
                    return;
                }

                const context = gsap.context(() => {
                    const words = gsap.utils.toArray<HTMLElement>(
                        "[data-about-callout-word]",
                        callout,
                    );
                    const copy = callout.querySelector<HTMLElement>(
                        "[data-about-callout-copy]",
                    );
                    const cards = gsap.utils.toArray<HTMLElement>(
                        "[data-about-callout-card]",
                        callout,
                    );
                    const cta = callout.querySelector<HTMLElement>(
                        "[data-about-callout-cta]",
                    );
                    const animatedElements = [
                        ...words,
                        ...(copy ? [copy] : []),
                        ...cards,
                        ...(cta ? [cta] : []),
                    ];

                    const timeline = gsap.timeline({
                        defaults: { ease: "power3.out" },
                        scrollTrigger: {
                            trigger: callout,
                            start: "top 80%",
                            once: true,
                            toggleActions: "play none none none",
                        },
                        onComplete: () => {
                            gsap.set(animatedElements, {
                                clearProps: "opacity,transform,visibility",
                            });
                        },
                    });

                    timeline.fromTo(
                        words,
                        { autoAlpha: 0, y: 18, scale: 0.985 },
                        {
                            autoAlpha: 1,
                            y: 0,
                            scale: 1,
                            duration: 0.5,
                            stagger: 0.025,
                        },
                        0,
                    );

                    if (copy) {
                        timeline.fromTo(
                            copy,
                            { autoAlpha: 0, y: 14 },
                            { autoAlpha: 1, y: 0, duration: 0.44 },
                            0.1,
                        );
                    }

                    timeline.fromTo(
                        cards,
                        { autoAlpha: 0, y: 22, scale: 0.985 },
                        {
                            autoAlpha: 1,
                            y: 0,
                            scale: 1,
                            duration: 0.52,
                            stagger: 0.07,
                        },
                        0.16,
                    );

                    if (cta) {
                        timeline.fromTo(
                            cta,
                            { autoAlpha: 0, y: 14, scale: 0.985 },
                            {
                                autoAlpha: 1,
                                y: 0,
                                scale: 1,
                                duration: 0.46,
                            },
                            0.24,
                        );
                    }
                }, callout);

                activeAboutCalloutMotion.set(callout, () => context.revert());
                didCreateMotion = true;
            });

        if (didCreateMotion) ScrollTrigger.refresh();
    };

    initAboutCallouts();

    document.addEventListener("astro:before-swap", cleanupAboutCallouts);
    document.addEventListener("astro:page-load", initAboutCallouts);
</script>

<style>
    .about-callout-avatar {
        align-self: center;
        aspect-ratio: 1;
        background: var(--color-snow-600);
        border: 0.06em solid #fff;
        border-radius: 9999px;
        box-shadow:
            0 18px 38px -18px rgba(0, 0, 0, 0.72),
            0 4px 14px rgba(0, 0, 0, 0.24);
        display: inline-flex;
        height: 1.08em;
        margin-inline: 0.08em;
        overflow: hidden;
    }

    .about-callout-proof-card__icon {
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.22),
            inset 0 -1px 0 rgba(31, 54, 130, 0.14),
            0 12px 26px -20px rgba(141, 165, 247, 0.55),
            0 5px 12px -10px rgba(62, 96, 212, 0.58);
    }

    .about-callout-cta {
        background: transparent;
        border: 0;
        box-shadow: none;
        color: var(--color-snow-50);
        isolation: isolate;
        overflow: hidden;
        position: relative;
        text-decoration: none;
        transition: box-shadow 280ms cubic-bezier(0.2, 0, 0, 1);
    }

    .about-callout-cta::before {
        background: var(--color-blue-500);
        border: 1px solid
            color-mix(in srgb, var(--color-blue-500) 70%, var(--color-blue-600));
        border-radius: inherit;
        box-shadow: inset 0 2px rgba(184, 200, 255, 0.18);
        content: "";
        inset: 0;
        position: absolute;
        transform: scale(1);
        transition: transform 520ms
            var(--wui-ease-standard, cubic-bezier(0.2, 0, 0, 1));
        z-index: -1;
    }

    .about-callout-cta:focus-visible {
        box-shadow: none;
    }

    .about-callout-cta:focus-visible::before {
        transform: scale(0.95);
    }

    .about-callout-cta:focus-visible .about-callout-cta__icon {
        animation: phone-ring 620ms cubic-bezier(0.2, 0, 0, 1);
        transform-origin: 50% 80%;
    }

    @media (hover: hover) {
        .about-callout-cta:hover {
            box-shadow: none;
        }

        .about-callout-cta:hover::before {
            transform: scale(0.95);
        }

        .about-callout-cta:hover .about-callout-cta__icon {
            animation: phone-ring 620ms cubic-bezier(0.2, 0, 0, 1);
            transform-origin: 50% 80%;
        }
    }

    @keyframes phone-ring {
        0%,
        100% {
            transform: rotate(0deg);
        }

        15% {
            transform: rotate(-12deg);
        }

        30% {
            transform: rotate(10deg);
        }

        45% {
            transform: rotate(-7deg);
        }

        60% {
            transform: rotate(5deg);
        }

        75% {
            transform: rotate(-2deg);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .about-callout-cta__icon {
            animation: none !important;
            transform: none;
        }

        .about-callout-cta,
        .about-callout-cta::before {
            transition: none;
        }
    }
</style>
