---
import { Image } from "astro:assets";
import Carousel from "./Carousel.astro";
import ProjectIntro from "./ProjectIntro.astro";
import { projects } from "@/data/projects";

interface Props {
    class?: string;
    description?: string;
    id?: string;
    title?: string;
}

const {
    class: className,
    description = "Chaque projet montre comment clarifier une offre, rassurer les visiteurs et transformer une première impression en parcours crédible.",
    id = "projects",
    title = "Des projets pensés pour inspirer confiance",
} = Astro.props;
---

<section
    id={id}
    class:list={["project-showcase", className]}
    data-project-showcase
    aria-labelledby={`${id}-title`}
>
    <div
        class="mx-auto mb-12 flex max-w-5xl flex-col items-start gap-4 px-4 text-left"
    >
        <h2 id={`${id}-title`} class="section-heading section-heading--left">
            {title}
        </h2>
        <p class="section-subheading mx-0 max-w-3xl text-left text-gray-700">
            {description}
        </p>
    </div>
    <Carousel compactControls>
        {
            projects.map((project) => (
                <div class="embla__slide">
                    <div
                        class="aspect-video h-full w-full overflow-hidden rounded-md bg-gray-100"
                        data-project-name={project.title}
                        aria-hidden="true"
                    >
                        {project.media.type !== "placeholder" && (
                            <Image
                                src={project.media.poster}
                                alt=""
                                class="block h-full w-full object-cover"
                                widths={[480, 800, 1200]}
                                sizes="(min-width: 1024px) 40rem, 90vw"
                                loading="lazy"
                            />
                        )}
                    </div>
                </div>
            ))
        }
    </Carousel>

    <div class="project-copy mx-auto grid max-w-5xl px-4 pt-8 md:pt-10">
        {
            projects.map((project, index) => (
                <article
                    class:list={[
                        "project-copy__panel",
                        index === 0 && "is-active",
                    ]}
                    data-project-panel
                    data-project-index={index}
                    aria-hidden={index === 0 ? undefined : "true"}
                    inert={index === 0 ? undefined : true}
                >
                    <ProjectIntro href={project.href} title={project.title}>
                        {project.summary}
                    </ProjectIntro>
                </article>
            ))
        }
    </div>
</section>

<script>
    const windowWithProjectShowcases = window as Window & {
        __wuiProjectShowcaseLifecycleReady?: boolean;
    };

    const replayProjectPanelAnimation = (panel: HTMLElement) => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        delete panel.dataset.projectPanelAnimate;
        void panel.offsetWidth;
        panel.dataset.projectPanelAnimate = "true";
    };

    const initProjectShowcases = () => {
        document
            .querySelectorAll<HTMLElement>("[data-project-showcase]")
            .forEach((root) => {
                if (root.dataset.projectShowcaseReady === "true") return;

                const panels = root.querySelectorAll<HTMLElement>(
                    "[data-project-panel]",
                );

                const setActivePanel = (
                    index: number,
                    direction = "next",
                    shouldAnimate = true,
                ) => {
                    root.dataset.projectDirection = direction;
                    let activePanel: HTMLElement | undefined;

                    panels.forEach((panel) => {
                        const isActive =
                            Number(panel.dataset.projectIndex) === index;

                        delete panel.dataset.projectPanelAnimate;
                        panel.classList.toggle("is-active", isActive);
                        panel.setAttribute("aria-hidden", String(!isActive));
                        panel.toggleAttribute("inert", !isActive);
                        if (isActive) activePanel = panel;
                    });

                    if (shouldAnimate && activePanel) {
                        replayProjectPanelAnimation(activePanel);
                    }
                };

                root.dataset.projectShowcaseReady = "true";
                setActivePanel(0, "next", false);
                root.addEventListener("carousel:select", (event) => {
                    const { direction, index } = (
                        event as CustomEvent<{
                            direction?: string;
                            index: number;
                        }>
                    ).detail;

                    setActivePanel(index, direction);
                });
            });
    };

    initProjectShowcases();

    if (
        windowWithProjectShowcases.__wuiProjectShowcaseLifecycleReady !== true
    ) {
        windowWithProjectShowcases.__wuiProjectShowcaseLifecycleReady = true;
        document.addEventListener("astro:page-load", initProjectShowcases);
    }
</script>

<style>
    .project-copy__panel {
        filter: blur(6px);
        grid-area: 1 / 1;
        opacity: 0;
        pointer-events: none;
        transition:
            opacity 320ms cubic-bezier(0.2, 0, 0, 1),
            filter 420ms cubic-bezier(0.2, 0, 0, 1);
    }

    .project-copy__panel.is-active {
        filter: none;
        opacity: 1;
        pointer-events: auto;
    }

    .project-showcase {
        --project-panel-from-y: -1.15rem;
    }

    .project-showcase[data-project-direction="prev"] {
        --project-panel-from-y: 1.15rem;
    }

    .project-copy__panel[data-project-panel-animate="true"]
        :global(.project-intro__title),
    .project-copy__panel[data-project-panel-animate="true"]
        :global(.project-intro__description),
    .project-copy__panel[data-project-panel-animate="true"]
        :global(.project-intro__button) {
        animation: project-panel-copy-reveal 760ms
            cubic-bezier(0.34, 1.2, 0.64, 1) backwards;
    }

    .project-copy__panel[data-project-panel-animate="true"]
        :global(.project-intro__description) {
        animation-delay: 130ms;
    }

    .project-copy__panel[data-project-panel-animate="true"]
        :global(.project-intro__button) {
        animation-delay: 260ms;
    }

    @keyframes project-panel-copy-reveal {
        from {
            filter: blur(8px);
            opacity: 0;
            transform: translateY(var(--project-panel-from-y));
        }

        to {
            filter: none;
            opacity: 1;
            transform: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .project-copy__panel,
        .project-copy__panel[data-project-panel-animate="true"]
            :global(.project-intro__title),
        .project-copy__panel[data-project-panel-animate="true"]
            :global(.project-intro__description),
        .project-copy__panel[data-project-panel-animate="true"]
            :global(.project-intro__button) {
            animation: none;
            filter: none;
            transform: none;
            transition: none;
        }
    }
</style>
