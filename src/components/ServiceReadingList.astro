---
import ArticleImage from "@/components/articles/ArticleImage.astro";
import ArticleTag from "@/components/articles/ArticleTag.astro";
import { formatArticleDate, getVisibleArticles } from "@/lib/articles";
import { serviceReadings } from "@/data/serviceArticles";

interface Props {
    serviceSlug: string;
}

const { serviceSlug } = Astro.props;
const reading = serviceReadings[serviceSlug];
const MAX_ITEMS = 3;
const MIN_ITEMS = 2;

const visible = reading ? await getVisibleArticles() : [];
const byId = new Map(visible.map((article) => [article.id, article]));
const picked = (reading?.articles ?? [])
    .map((id) => byId.get(id))
    .filter((article) => article !== undefined)
    .slice(0, MAX_ITEMS);

if (reading && picked.length < MIN_ITEMS) {
    for (const article of visible) {
        if (picked.length >= MIN_ITEMS) break;
        if (picked.includes(article)) continue;
        if (article.data.tags.some((tag) => reading.fallbackTags.includes(tag))) {
            picked.push(article);
        }
    }
}

const headingId = `${serviceSlug}-reading`;
---

{
    picked.length >= MIN_ITEMS && (
        <section
            class="flex flex-col gap-8 sm:gap-10"
            aria-labelledby={headingId}
        >
            <div class="flex flex-col gap-3 text-center">
                <h2 class="section-heading" id={headingId}>
                    À lire avant de vous lancer
                </h2>
                <p class="section-subheading">
                    Quelques articles pour préparer votre projet et poser les
                    bonnes questions.
                </p>
            </div>
            <ul
                class:list={[
                    "grid gap-4 lg:gap-8",
                    picked.length === 2 ? "lg:grid-cols-2" : "lg:grid-cols-3",
                ]}
            >
                {picked.map((article) => (
                    <li>
                        <a
                            class="group flex h-full flex-col rounded-2xl bg-surface-muted p-5 text-gray-900 no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500 sm:p-6 lg:rounded-none lg:bg-transparent lg:p-0"
                            href={`/articles/${article.id}/`}
                        >
                            {article.data.image && (
                                <span class="mb-5 hidden aspect-video w-full overflow-hidden rounded-lg bg-gray-200 lg:block">
                                    <ArticleImage
                                        class="size-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-[1.02]"
                                        src={article.data.image.src}
                                        alt=""
                                        sizes={
                                            picked.length === 2
                                                ? "(min-width: 1024px) 30rem, 100vw"
                                                : "(min-width: 1024px) 20rem, 100vw"
                                        }
                                        widths={[480, 800]}
                                    />
                                </span>
                            )}
                            <span class="flex flex-wrap items-center gap-3">
                                {article.data.tags[0] && (
                                    <ArticleTag tag={article.data.tags[0]} />
                                )}
                                <time
                                    class="text-sm font-normal text-gray-600"
                                    datetime={article.data.pubDate.toISOString()}
                                >
                                    {formatArticleDate(article.data.pubDate)}
                                </time>
                            </span>
                            <h3 class="mt-4 text-xl font-normal leading-snug text-gray-900 text-pretty">
                                {article.data.title}
                            </h3>
                            <p class="mt-2 line-clamp-2 text-sm font-normal leading-6 text-gray-600">
                                {article.data.description}
                            </p>
                        </a>
                    </li>
                ))}
            </ul>
        </section>
    )
}
