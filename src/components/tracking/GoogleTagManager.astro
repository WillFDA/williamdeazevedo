---
// Google Tag Manager en mode « basique » de Consent Mode v2 : rien n'est
// chargé depuis Google tant que le visiteur n'a pas accepté au moins une
// finalité dans le bandeau (CookieBanner.astro). La logique est dans
// src/scripts/consent.ts. Pas de <noscript> GTM : l'iframe se chargerait sans
// consentement possible.
// Zaraz (Cloudflare) n'est PAS touché ici : il est géré côté dashboard.
---

{/* 1. Choix mémorisé : recharge GTM seulement si une finalité est acceptée. */}
<script>
    import { applyConsent, readConsent } from "../../scripts/consent";

    const choice = readConsent();
    if (choice) applyConsent(choice);
</script>

{/* 2. Pages virtuelles + clics contact (listeners délégués, posés une seule fois). */}
<script is:inline>
    if (!window.__wuiGtmListenersReady) {
        window.__wuiGtmListenersReady = true;
        // Rien n'est empilé tant que GTM n'est pas chargé (pas de consentement) :
        // ces événements ne doivent pas être rejoués après un accord ultérieur.
        // Chaque événement exige aussi sa finalité : page vue = audience,
        // clics contact (conversions Google Ads) = publicité.
        const push = (purpose, data) => {
            if (!window.__wuiGtmLoaded || !window.__wuiConsent?.[purpose]) return;
            window.dataLayer ||= [];
            window.dataLayer.push(data);
        };

        // astro:page-load se déclenche aussi au chargement initial : on l'ignore,
        // car la page vue initiale est déjà couverte par le déclencheur
        // "All Pages / Initialisation" de GTM. Seules les navigations
        // ClientRouter suivantes poussent page_view_virtual.
        // page_location / page_referrer : la doc GA4 SPA insiste sur un referrer
        // correct entre pages virtuelles.
        let isFirstLoad = true;
        let lastUrl = window.location.href;
        document.addEventListener("astro:page-load", () => {
            if (isFirstLoad) {
                isFirstLoad = false;
                return;
            }
            const referrer = lastUrl;
            lastUrl = window.location.href;
            push("analytics", {
                event: "page_view_virtual",
                page_location: window.location.href,
                page_referrer: referrer,
                page_path: window.location.pathname + window.location.search,
                page_title: document.title,
            });
        });

        document.addEventListener(
            "click",
            (event) => {
                const target = event.target;
                if (!(target instanceof Element)) return;
                const link = target.closest("a[href]");
                if (!link) return;
                const href = (link.getAttribute("href") || "").trim().toLowerCase();
                if (href.startsWith("tel:")) push("ads", { event: "clic_telephone" });
                else if (href.startsWith("mailto:")) push("ads", { event: "clic_email" });
            },
            { capture: true },
        );
    }
</script>
