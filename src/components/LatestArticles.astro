---
import ArticleTag from "@/components/articles/ArticleTag.astro";
import ArrowRight from "@/components/icons/nucleo/arrow-right-fill.svg";
import WaveIcon from "@/components/ui/WaveIcon.astro";
import WaveText from "@/components/ui/WaveText.astro";
import { formatArticleDate, getVisibleArticles } from "@/lib/articles";

const articles = await getVisibleArticles();
const [featured, ...rest] = articles.slice(0, 5);
---

{
    featured && (
        <section
            class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-8 md:py-16"
            aria-labelledby="latest-articles-title"
        >
            <div class="mx-auto max-w-6xl">
                <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
                    <h2
                        id="latest-articles-title"
                        class="section-heading max-w-3xl text-left text-[clamp(2.35rem,3.9vw,3.45rem)]"
                    >
                        Conseils concrets pour un site plus clair, plus rapide
                        et mieux référencé
                    </h2>
                    <a
                        class="service-method-button flex min-h-14 w-full max-w-full shrink-0 items-center justify-center gap-4 rounded-xl px-8 py-3 text-base font-normal sm:w-auto sm:px-10"
                        href="/articles/"
                    >
                        <WaveText
                            class="relative z-10"
                            text="Voir tous les articles"
                            trigger="parent"
                        />
                        <WaveIcon
                            class="relative z-10"
                            style="--wui-wave-icon-size: 1rem;"
                            direction="right"
                            trigger="parent"
                        >
                            <ArrowRight class="size-full" aria-hidden="true" />
                        </WaveIcon>
                    </a>
                </div>

                <div class="mt-10 grid gap-12 md:mt-14 lg:grid-cols-2">
                    <article>
                        <a
                            class="group block text-gray-900 no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                            href={`/articles/${featured.id}/`}
                        >
                            <span class="block aspect-video w-full overflow-hidden rounded-lg bg-gray-200">
                                {featured.data.image && (
                                    <img
                                        class="size-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-[1.02]"
                                        src={featured.data.image.src}
                                        alt=""
                                        loading="lazy"
                                        decoding="async"
                                    />
                                )}
                            </span>
                            <span class="mt-5 flex flex-wrap items-center gap-3">
                                {featured.data.tags[0] && (
                                    <ArticleTag tag={featured.data.tags[0]} />
                                )}
                                <time
                                    class="text-sm font-normal text-gray-500"
                                    datetime={featured.data.pubDate.toISOString()}
                                >
                                    {formatArticleDate(featured.data.pubDate)}
                                </time>
                            </span>
                            <h3 class="mt-4 text-2xl font-medium leading-tight text-gray-900 text-pretty sm:text-3xl">
                                {featured.data.title}
                            </h3>
                            <p class="mt-3 line-clamp-2 text-base font-light leading-normal text-gray-600">
                                {featured.data.description}
                            </p>
                            <span class="mt-5 inline-flex items-center gap-3 text-base font-normal text-gray-900">
                                <WaveText text="Lire l'article" trigger="parent" />
                                <WaveIcon
                                    style="--wui-wave-icon-size: 1rem;"
                                    direction="right"
                                    trigger="parent"
                                >
                                    <ArrowRight class="size-full" aria-hidden="true" />
                                </WaveIcon>
                            </span>
                        </a>
                    </article>

                    {rest.length > 0 && (
                        <ul class="divide-y divide-dashed divide-gray-300">
                            {rest.map((article, index) => (
                                <li>
                                    <a
                                        class:list={[
                                            "group flex items-center gap-6 py-7 text-gray-900 no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500",
                                            index === 0 && "lg:pt-0",
                                            index === rest.length - 1 && "pb-0",
                                        ]}
                                        href={`/articles/${article.id}/`}
                                    >
                                        <div class="min-w-0 flex-1">
                                            {article.data.tags[0] && (
                                                <ArticleTag tag={article.data.tags[0]} />
                                            )}
                                            <h3 class="mt-4 text-xl font-normal leading-snug text-gray-900 text-pretty sm:text-2xl">
                                                {article.data.title}
                                            </h3>
                                            <time
                                                class="mt-3 block text-sm font-normal text-gray-500"
                                                datetime={article.data.pubDate.toISOString()}
                                            >
                                                {formatArticleDate(article.data.pubDate)}
                                            </time>
                                        </div>
                                        <span
                                            class="latest-articles__arrow hidden size-11 shrink-0 items-center justify-center rounded-xl bg-gray-100 text-gray-900 sm:inline-flex"
                                            aria-hidden="true"
                                        >
                                            <ArrowRight class="size-4" />
                                        </span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    )}
                </div>
            </div>
        </section>
    )
}

<style>
    @media (hover: hover) {
        .latest-articles__arrow {
            filter: blur(5px);
            opacity: 0;
            transform: translateX(-1.25rem);
            transition:
                opacity 260ms ease,
                transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1),
                filter 260ms ease;
        }

        .group:hover .latest-articles__arrow,
        .group:focus-visible .latest-articles__arrow {
            filter: blur(0);
            opacity: 1;
            transform: translateX(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .latest-articles__arrow {
            filter: none;
            opacity: 1;
            transform: none;
            transition: none;
        }
    }
</style>
