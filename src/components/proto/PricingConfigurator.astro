---
import { Image } from "astro:assets";
import CapabilityIcon from "@/components/ui/CapabilityIcon.astro";
import WaveIcon from "@/components/ui/WaveIcon.astro";
import WaveText from "@/components/ui/WaveText.astro";
import AnimationRepeat from "@/components/icons/nucleo/animation-repeat-fill.svg";
import ArrowRight from "@/components/icons/nucleo/arrow-right-fill.svg";
import BadgeDollar from "@/components/icons/nucleo/badge-dollar-fill.svg";
import Check from "@/components/icons/nucleo/check-2-outline.svg";
import Msgs from "@/components/icons/nucleo/msgs-fill.svg";
import ViewAll from "@/components/icons/nucleo/view-all-fill.svg";
import Xmark from "@/components/icons/nucleo/xmark-fill.svg";
import lefellicHome from "@/assets/projects/lefellic-home.webp";
import quentinPhoto from "@/assets/temoignages/quentin-le-fellic.webp";
import { temoignages } from "@/data/temoignage";
import { iconToneClasses } from "@/lib/iconTones";

const fr = (n: number) => new Intl.NumberFormat("fr-FR").format(n);

const formats = [
    {
        id: "landing",
        name: "Landing page",
        icon: "conversion",
        tone: "blue",
        text: "Une page centrée sur une offre, une campagne ou une prise de rendez-vous.",
        base: 1200,
        included: 1,
        pages: "fixed",
        sub: "1 page",
    },
    {
        id: "vitrine",
        name: "Site vitrine",
        icon: "ux",
        tone: "violet",
        text: "Plusieurs pages pour présenter vos services, vos preuves et faciliter le contact.",
        base: 2000,
        included: 5,
        pages: "extra",
        sub: "5 pages incluses",
    },
    {
        id: "refonte",
        name: "Refonte",
        icon: "refonte",
        tone: "cyan",
        text: "On reprend l'existant : structure, contenus, design, performance et redirections.",
        base: 2500,
        included: 5,
        pages: "extra",
        sub: "5 pages incluses",
    },
    {
        id: "interface",
        name: "Interface produit",
        icon: "cms",
        tone: "indigo",
        text: "SaaS, dashboard, espace client ou outil métier.",
        base: null,
        included: 0,
        pages: "none",
        sub: "Cadrage dès 900 € HT",
    },
] as const;

const maxIncluded = Math.max(...formats.map((f) => f.included));

const options = [
    {
        id: "animations",
        title: "Animations",
        short: "Animations",
        text: "Transitions, apparitions au scroll et micro-interactions soignées.",
        price: 500,
    },
    {
        id: "form",
        title: "Formulaire de contact personnalisé",
        short: "Formulaire",
        text: "Champs sur mesure, envoi par e-mail et anti-spam.",
        price: 500,
    },
    {
        id: "cms",
        title: "CMS / contenus modifiables",
        short: "CMS",
        text: "Vous publiez textes, projets et articles sans toucher au code.",
        price: 1000,
    },
    {
        id: "ads",
        title: "Google Ads",
        short: "Google Ads",
        text: "Pages et suivi de conversion prêts pour vos campagnes.",
        price: null,
    },
] as const;

const included = [
    "Cadrage du besoin et des objectifs",
    "Structure des pages et hiérarchie des contenus",
    "Design responsive",
    "Développement front-end",
    "SEO technique initial",
    "Performance et accessibilité de base",
    "Formulaire ou action de contact",
    "Mise en ligne et vérifications",
];

const quentin = temoignages.find((t) => t.id === "quentin-le-fellic")!;
const vitrine = formats[1];
---

<section
    id="tarifs"
    class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-8 md:py-16"
    aria-labelledby="pc-title"
    data-pc
>
    <div class="flex flex-col gap-4 xl:flex-row xl:justify-between xl:gap-12">
        <div>
            <p class="inline-flex rounded-lg bg-gray-100 px-3 py-1 text-sm text-gray-600">
                Tarifs
            </p>
            <h2
                id="pc-title"
                class="mt-4 text-[2rem] leading-[1.15] font-[450] tracking-[-0.015em] text-gray-900 md:text-[2.875rem] xl:mt-5 xl:text-[3.5rem] xl:leading-[4rem]"
            >
                Choisissez votre projet.{" "}<br class="max-md:hidden" />Voyez
                ce qu'il coûte.
            </h2>
        </div>
        <div class="max-w-[27.5rem] xl:shrink-0 xl:pt-[50px]">
            <p class="text-base leading-normal text-gray-700 md:text-lg md:leading-[27px] md:tracking-[-0.01em]">
                Prix hors taxes, indicatifs. Le devis final confirme le
                périmètre après un premier échange.
            </p>
            <p class="mt-3 text-[13px] text-gray-500">
                Prix indicatifs en cours de validation.
            </p>
        </div>
    </div>

    <div
        class="mt-7 grid items-start gap-4 md:mt-10 lg:mt-16 lg:grid-cols-[minmax(0,1fr)_21rem]"
    >
        <div
            class="rounded-[1.75rem] bg-snow-50 px-4 py-1 inset-ring inset-ring-gray-200 sm:rounded-[2.25rem] sm:px-7 sm:py-2"
            data-pc-steps
        >
            <div class="pc-step relative py-6 sm:py-8 sm:pl-12">
                <div class="flex items-center gap-3">
                    <span class="pc-num relative z-1 sm:absolute sm:top-8 sm:left-0">01</span>
                    <h3 class="text-xl leading-[26px] font-[450] tracking-[-0.02em] text-gray-900 sm:mt-0.5 sm:text-2xl sm:leading-7">
                        Votre format
                    </h3>
                </div>
                <p class="mt-2 max-w-[32.5rem] text-sm leading-normal text-gray-500 sm:text-[15px]">
                    Le point de départ du budget. Les pages et les options
                    s'ajoutent ensuite.
                </p>

                <div
                    class="mt-5 grid grid-cols-2 gap-2 sm:mt-7 sm:gap-2.5 xl:grid-cols-4"
                    role="radiogroup"
                    aria-label="Format du projet"
                >
                    {
                        formats.map((f) => (
                            <label class="pc-tile flex cursor-pointer flex-col rounded-[18px] bg-snow-50 p-3.5 inset-ring inset-ring-gray-200 hover:bg-gray-50 has-checked:bg-snow-50 has-checked:inset-ring-transparent has-checked:ring-[1.5px] has-checked:ring-coffee-300 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-blue-500 sm:rounded-3xl sm:p-[18px]">
                                <input
                                    class="sr-only"
                                    type="radio"
                                    name="pc-format"
                                    value={f.id}
                                    checked={f.id === "vitrine"}
                                    data-name={f.name}
                                    data-text={f.text}
                                    data-base={f.base ?? ""}
                                    data-included={f.included}
                                    data-pages={f.pages}
                                    data-sub={f.sub}
                                />
                                <span class="flex items-center justify-between">
                                    <span
                                        class:list={[
                                            "pc-icon inline-flex size-[26px] items-center justify-center rounded-lg text-snow-50 sm:size-8 sm:rounded-[10px]",
                                            iconToneClasses[f.tone],
                                        ]}
                                        aria-hidden="true"
                                    >
                                        <CapabilityIcon icon={f.icon} class="size-4 sm:size-[18px]" />
                                    </span>
                                    <span class="pc-radio" aria-hidden="true" />
                                </span>
                                <span class="mt-3 text-[15px] leading-[21px] font-[450] text-gray-900 sm:mt-3.5 sm:text-base">
                                    {f.name}
                                </span>
                                <span class="text-[26px] leading-8 font-[450] tracking-[-0.03em] whitespace-nowrap text-gray-900 tabular-nums sm:text-[2rem] sm:leading-[44px]">
                                    {f.base === null ? "Sur devis" : `${fr(f.base)} €`}
                                </span>
                                <span class="text-xs leading-[21px] text-gray-500 sm:text-[13px]">
                                    {f.base === null ? f.sub : "prix de départ HT"}
                                </span>
                                <span class="mt-auto flex justify-between gap-2 pt-3.5 text-[11px] leading-[21px] whitespace-nowrap text-gray-500 sm:text-xs">
                                    Pages incluses
                                    <b class="font-[450] text-gray-900">
                                        {f.pages === "none" ? "à définir" : f.included}
                                    </b>
                                </span>
                                <span class="pc-meter mt-2 h-[3px] rounded-full bg-gray-100" aria-hidden="true">
                                    <i style={`width: ${(f.included / maxIncluded) * 100}%`} />
                                </span>
                            </label>
                        ))
                    }
                </div>

                <p class="mt-3 text-[13px] leading-5 text-gray-500" data-pc-desc>{vitrine.text}</p>

                <details class="pc-included group mt-5 rounded-2xl bg-snow-50 inset-ring inset-ring-gray-200">
                    <summary class="flex cursor-pointer list-none items-center gap-3 rounded-2xl px-3.5 py-3.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 sm:px-[18px] sm:py-4 [&::-webkit-details-marker]:hidden">
                        <span class="text-sm leading-[21px] font-[450] text-gray-900 sm:text-[15px]">
                            Inclus dans chaque site
                            <small class="ml-2 text-[13px] font-normal text-gray-500">
                                {included.length} éléments
                            </small>
                        </span>
                        <span class="ml-auto inline-flex size-7 items-center justify-center rounded-[9px] bg-gray-100 text-gray-900 transition-colors duration-200 group-hover:bg-gray-200">
                            <Xmark
                                class="pc-toggle size-3 rotate-45 group-open:rotate-90"
                                aria-hidden="true"
                            />
                        </span>
                    </summary>
                    <ul class="pc-included-list grid gap-x-4 gap-y-3.5 border-t border-gray-100 px-3.5 pt-4 pb-[18px] sm:grid-cols-2 sm:px-[18px] xl:grid-cols-3">
                        {
                            included.map((item) => (
                                <li class="flex items-start gap-1.5 text-[13px] leading-5 text-gray-700">
                                    <Check class="mt-0.5 size-4 shrink-0 text-gray-500" aria-hidden="true" />
                                    {item}
                                </li>
                            ))
                        }
                    </ul>
                </details>

                <div
                    class="mt-5 flex flex-wrap items-center justify-between gap-4 rounded-2xl px-3.5 py-3.5 inset-ring inset-ring-gray-200 transition-opacity data-disabled:opacity-55 sm:px-[18px] sm:py-4"
                    data-pc-counter
                >
                    <div class="min-w-0 flex-[1_1_10rem]">
                        <p class="text-[15px] leading-[21px] font-[450] text-gray-900">
                            Nombre de pages
                        </p>
                        <p
                            class="mt-0.5 text-xs leading-[21px] text-gray-500 sm:text-[13px]"
                            data-pc-counter-text
                        >
                            5 pages incluses, puis +200 € HT par page.
                        </p>
                    </div>
                    <div class="flex shrink-0 items-center gap-0.5 rounded-xl bg-gray-100 p-[3px]">
                        <button
                            class="pc-step-btn"
                            type="button"
                            aria-label="Retirer une page"
                            data-pc-minus
                        >
                            <span class="h-[1.5px] w-3 rounded-full bg-current" />
                        </button>
                        <output
                            class="pc-out min-w-8 text-center text-[15px] leading-[21px] font-[450] text-gray-900 tabular-nums"
                            aria-live="polite"
                            data-pc-pages
                        >
                            5
                        </output>
                        <button
                            class="pc-step-btn"
                            type="button"
                            aria-label="Ajouter une page"
                            data-pc-plus
                        >
                            <span class="relative h-[1.5px] w-3 rounded-full bg-current after:absolute after:inset-0 after:rotate-90 after:rounded-full after:bg-current" />
                        </button>
                    </div>
                </div>
            </div>

            <div class="pc-step group/opts relative py-6 sm:py-8 sm:pl-12">
                <div class="flex items-center gap-3">
                    <span class="pc-num relative z-1 sm:absolute sm:top-8 sm:left-0">02</span>
                    <h3 class="flex flex-wrap items-center gap-2.5 text-xl leading-[26px] font-[450] tracking-[-0.02em] text-gray-900 sm:mt-0.5 sm:text-2xl sm:leading-7">
                        Vos options
                        <span class="rounded-full px-2 py-[3px] text-xs font-normal tracking-normal text-gray-500 inset-ring inset-ring-gray-200">
                            Optionnel
                        </span>
                    </h3>
                </div>
                <p class="mt-2 max-w-[32.5rem] text-sm leading-normal text-gray-500 sm:text-[15px]">
                    <span class="group-has-[fieldset:disabled]/opts:hidden">
                        À ajouter maintenant ou plus tard, sans refaire le site.
                    </span>
                    <span class="hidden group-has-[fieldset:disabled]/opts:inline">
                        Pour une interface produit, tout se chiffre au cadrage.
                    </span>
                </p>

                <fieldset
                    class="mt-5 flex flex-col gap-3 transition-opacity disabled:opacity-50 sm:mt-7"
                    data-pc-options
                >
                    <legend class="sr-only">Options</legend>
                    {
                        options.map((o) => (
                            <label class="pc-row grid cursor-pointer grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-3 rounded-[18px] bg-snow-50 p-4 inset-ring inset-ring-gray-200 hover:bg-gray-50 has-checked:bg-snow-50 has-checked:inset-ring-transparent has-checked:ring-[1.5px] has-checked:ring-coffee-300 has-disabled:cursor-not-allowed has-disabled:hover:bg-snow-50 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-blue-500 sm:grid-cols-[auto_auto_minmax(0,1fr)_auto] sm:gap-x-5 sm:rounded-3xl sm:px-6 sm:py-5">
                                <input
                                    class="sr-only"
                                    type="checkbox"
                                    name="pc-option"
                                    value={o.id}
                                    data-price={o.price ?? ""}
                                />
                                <span class="pc-check" aria-hidden="true">
                                    <Check class="size-3" />
                                </span>
                                <span
                                    class="pc-opt-icon hidden size-10 items-center justify-center rounded-xl bg-gray-100 text-gray-500 sm:inline-flex"
                                    aria-hidden="true"
                                >
                                    {o.id === "animations" && <AnimationRepeat class="size-5" />}
                                    {o.id === "form" && <Msgs class="size-5" />}
                                    {o.id === "cms" && <ViewAll class="size-5" />}
                                    {o.id === "ads" && <BadgeDollar class="size-5" />}
                                </span>
                                <span class="flex min-w-0 flex-col gap-0.5">
                                    <span class="text-[15px] leading-[21px] font-[450] text-gray-900 sm:text-base">
                                        {o.title}
                                    </span>
                                    <span class="text-[13px] leading-[1.45] text-gray-500 sm:text-sm">
                                        {o.text}
                                    </span>
                                </span>
                                <span class="flex items-baseline justify-end gap-2 whitespace-nowrap">
                                    <strong class="text-xl leading-8 font-[450] tracking-[-0.02em] text-gray-900 tabular-nums sm:text-2xl">
                                        {o.price === null ? "Sur devis" : `+${fr(o.price)}`}
                                    </strong>
                                    {o.price !== null && <span class="text-sm text-gray-500">€ HT</span>}
                                </span>
                            </label>
                        ))
                    }
                </fieldset>
            </div>
        </div>

        <div class="flex flex-col gap-3.5 lg:sticky lg:top-24">
            <aside
                class="relative flex flex-col overflow-hidden rounded-[1.75rem] bg-snow-50 after:pointer-events-none after:absolute after:inset-0 after:z-20 after:rounded-[inherit] after:inset-ring after:inset-ring-gray-200 sm:rounded-[2.25rem]"
                aria-label="Récapitulatif"
                data-pc-summary
            >
                <div class="relative z-10 flex flex-col px-5 pt-6 sm:px-8 sm:pt-8">
                    <p class="text-xl leading-[21px] font-[450] tracking-[-0.02em] text-gray-900">
                        Votre projet
                    </p>
                    <p class="mt-1.5 text-sm leading-normal text-gray-500">
                        Tout ce que vous avez choisi, en un devis.
                    </p>

                    <dl class="mt-6">
                        <div class="pc-line">
                            <dt>
                                Format
                                <small data-pc-format-sub>{vitrine.sub}</small>
                            </dt>
                            <dd>
                                <span class="pc-l">
                                    <span data-pc-format-name>{vitrine.name}</span>
                                    <b data-pc-format-price>{fr(vitrine.base)} €</b>
                                </span>
                            </dd>
                        </div>
                        <div class="pc-line" data-pc-line-pages hidden>
                            <dt>
                                Pages en plus
                                <small>200 € HT la page</small>
                            </dt>
                            <dd>
                                <span class="pc-l">
                                    <span data-pc-pages-count>× 1</span>
                                    <b data-pc-pages-price>200 €</b>
                                </span>
                            </dd>
                        </div>
                        <div class="pc-line">
                            <dt>
                                Options
                                <small data-pc-options-sub>Optionnel</small>
                            </dt>
                            <dd>
                                {
                                    options.map((o) => (
                                        <span class="pc-l" data-pc-line-option={o.id} hidden>
                                            <span>{o.short}</span>
                                            <b>{o.price === null ? "Sur devis" : `${fr(o.price)} €`}</b>
                                        </span>
                                    ))
                                }
                                <span data-pc-line-none>—</span>
                            </dd>
                        </div>
                    </dl>

                    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-t border-gray-100 pt-5">
                        <span class="text-[15px] text-gray-700">Total</span>
                        <strong
                            class="ml-auto flex items-baseline gap-1.5 text-[2.25rem] leading-[44px] font-[450] tracking-[-0.03em] whitespace-nowrap text-gray-900 tabular-nums sm:text-[2.75rem] sm:leading-[52px]"
                            data-pc-total-wrap
                        >
                            <span data-pc-total>{fr(vitrine.base)}</span>
                            <small class="text-[15px] font-[450] tracking-normal text-gray-500" data-pc-unit>€ HT</small>
                        </strong>
                    </div>
                    <p class="text-right text-[13px] text-gray-500" data-pc-total-hint hidden></p>
                    <p class="mt-2 min-h-[42px] text-[13px] leading-[1.6] text-gray-500" data-pc-note>
                        Livré en 10 jours à 5 semaines selon périmètre. Prix
                        indicatif hors taxes.
                    </p>

                    <button
                        aria-controls="cal-drawer"
                        aria-haspopup="dialog"
                        class="pc-cta mt-5 flex h-[52px] w-full items-center justify-center gap-3 rounded-xl px-6 text-[15px] font-[450]"
                        data-cal-location="pricing-configurator"
                        data-cal-open
                        type="button"
                    >
                        <WaveText text="Parlons de votre projet" trigger="parent" />
                        <WaveIcon style="--wui-wave-icon-size: 0.875rem;" direction="right" trigger="parent">
                            <ArrowRight class="size-full" aria-hidden="true" />
                        </WaveIcon>
                    </button>
                </div>

                <div class="relative">
                    <div class="absolute inset-x-0 bottom-0 h-[230px] overflow-hidden" aria-hidden="true">
                        <Image
                            src={lefellicHome}
                            alt=""
                            widths={[420, 840]}
                            sizes="420px"
                            class="size-full object-cover object-right-bottom"
                        />
                        <span class="absolute inset-x-0 top-0 h-20 bg-linear-to-b from-snow-50 from-30% to-transparent" />
                    </div>
                    <figure class="relative mx-3 mt-20 mb-3 flex items-center gap-2.5 rounded-2xl bg-white/80 px-4 py-3 inset-ring inset-ring-gray-900/5 backdrop-blur-lg sm:mt-[120px]">
                        <Image
                            src={quentinPhoto}
                            alt={quentin.imageAlt ?? ""}
                            width={48}
                            height={48}
                            class="size-6 shrink-0 rounded-full object-cover"
                        />
                        <figcaption class="text-[13px] leading-[1.5] text-gray-500">
                            <strong class="block font-[450] text-gray-900">
                                «&nbsp;Des échanges fluides et constructifs&nbsp;»
                            </strong>
                            SARL Le Fellic
                        </figcaption>
                    </figure>
                </div>
            </aside>

            <a
                class="inline-flex items-center gap-1.5 self-center text-sm font-[450] text-gray-900 underline-offset-[3px] hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                href="#faq"
            >
                Voir ce qui fait varier un devis
                <ArrowRight class="size-3.5" aria-hidden="true" />
            </a>
        </div>
    </div>

    <div
        class="pc-bar fixed inset-x-2 bottom-2 z-40 flex items-center justify-between gap-3 rounded-[20px] bg-snow-50/95 py-2.5 pr-2.5 pl-4 inset-ring inset-ring-gray-200 backdrop-blur-lg lg:hidden"
        data-pc-bar
        aria-hidden="true"
    >
        <span class="min-w-0">
            <span class="block text-xs text-gray-500">Total estimé</span>
            <span class="flex items-baseline gap-1 whitespace-nowrap" data-pc-bar-wrap>
                <strong class="text-xl font-[450] tracking-tight text-gray-900 tabular-nums" data-pc-bar-total>{fr(vitrine.base)}</strong>
                <small class="text-xs font-[450] text-gray-500" data-pc-bar-unit>€ HT</small>
            </span>
        </span>
        <button
            class="pc-cta flex min-h-12 shrink-0 items-center justify-center gap-3 rounded-xl px-5 text-[15px] font-[450]"
            data-cal-location="pricing-configurator-bar"
            data-cal-open
            aria-controls="cal-drawer"
            aria-haspopup="dialog"
            tabindex="-1"
            type="button"
        >
            <WaveText text="Parlons-en" trigger="parent" />
            <WaveIcon style="--wui-wave-icon-size: 0.875rem;" direction="right" trigger="parent">
                <ArrowRight class="size-full" aria-hidden="true" />
            </WaveIcon>
        </button>
    </div>
</section>

<script>
    const fr = new Intl.NumberFormat("fr-FR");
    const EXTRA_PAGE = 200;
    const MAX_PAGES = 30;

    const init = () => {
        const root = document.querySelector<HTMLElement>("[data-pc]");
        if (!root || root.dataset.ready) return;
        root.dataset.ready = "true";

        const $ = <T extends Element = HTMLElement>(sel: string) =>
            root.querySelector<T>(sel)!;
        const formats = [
            ...root.querySelectorAll<HTMLInputElement>('input[name="pc-format"]'),
        ];
        const opts = [
            ...root.querySelectorAll<HTMLInputElement>('input[name="pc-option"]'),
        ];
        const optionsSet = $<HTMLFieldSetElement>("[data-pc-options]");
        const counter = $("[data-pc-counter]");
        const minus = $<HTMLButtonElement>("[data-pc-minus]");
        const plus = $<HTMLButtonElement>("[data-pc-plus]");
        const pagesOut = $("[data-pc-pages]");
        const totals = [$("[data-pc-total]"), $("[data-pc-bar-total]")];
        const units = [$("[data-pc-unit]"), $("[data-pc-bar-unit]")];
        const totalWraps = [$("[data-pc-total-wrap]"), $("[data-pc-bar-wrap]")];
        const hint = $("[data-pc-total-hint]");
        const note = $("[data-pc-note]");
        const desc = $("[data-pc-desc]");

        let pages = 5;
        const reduce = () =>
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        const update = () => {
            const f = formats.find((i) => i.checked)!;
            const d = f.dataset;
            const base = d.base ? Number(d.base) : null;
            const includedPages = Number(d.included);
            const mode = d.pages;

            pages = Math.max(pages, includedPages || 1);
            const extra = mode === "extra" ? pages - includedPages : 0;
            counter.toggleAttribute("data-disabled", mode !== "extra");
            counter.toggleAttribute("data-extra", extra > 0);
            minus.disabled = mode !== "extra" || pages <= includedPages;
            plus.disabled = mode !== "extra" || pages >= MAX_PAGES;
            pagesOut.textContent =
                mode === "fixed" ? "1" : mode === "none" ? "—" : String(pages);
            $("[data-pc-counter-text]").textContent =
                mode === "extra"
                    ? `${d.name} : ${includedPages} pages incluses, puis +${EXTRA_PAGE} € HT par page.`
                    : mode === "fixed"
                      ? "Une landing page tient sur une seule page."
                      : "Le nombre d'écrans se définit pendant le cadrage.";
            const descChanged = desc.textContent !== d.text;
            desc.textContent = d.text!;

            optionsSet.disabled = base === null;
            const active = base === null ? [] : opts.filter((o) => o.checked);

            $("[data-pc-format-name]").textContent = d.name!;
            $("[data-pc-format-sub]").textContent = d.sub!;
            $("[data-pc-format-price]").textContent =
                base === null ? "Sur devis" : `${fr.format(base)} €`;
            $("[data-pc-line-pages]").hidden = extra <= 0;
            $("[data-pc-pages-count]").textContent = `× ${extra}`;
            $("[data-pc-pages-price]").textContent = `${fr.format(extra * EXTRA_PAGE)} €`;
            opts.forEach((o) => {
                $(`[data-pc-line-option="${o.value}"]`).hidden = !active.includes(o);
            });
            $("[data-pc-line-none]").hidden = active.length > 0;
            $("[data-pc-options-sub]").textContent =
                active.length === 0
                    ? "Optionnel"
                    : `${active.length} choisie${active.length > 1 ? "s" : ""}`;

            const sum =
                (base ?? 0) +
                extra * EXTRA_PAGE +
                active.reduce((s, o) => s + (Number(o.dataset.price) || 0), 0);
            const isQuote = base === null || active.some((o) => !o.dataset.price);

            hint.hidden = !isQuote;
            hint.textContent =
                base === null
                    ? "Cadrage dès 900 € HT"
                    : `${fr.format(sum)} € HT + Google Ads sur devis`;
            note.textContent =
                base === null
                    ? "Planning défini après lecture du périmètre. Prix hors taxes."
                    : "Livré en 10 jours à 5 semaines selon périmètre. Prix indicatif hors taxes.";

            const next = isQuote ? "Sur devis" : fr.format(sum);
            const totalChanged = totals[0].textContent !== next;
            totals.forEach((t) => (t.textContent = next));
            units.forEach((u) => (u.hidden = isQuote));
            if (reduce()) return;
            const fade = (el: HTMLElement) =>
                el.animate(
                    [{ opacity: 0, transform: "translateY(4px)" }, { opacity: 1, transform: "none" }],
                    { duration: 400, easing: "ease" },
                );
            if (totalChanged) totalWraps.forEach(fade);
            if (descChanged) fade(desc);
        };

        root.addEventListener("change", update);
        minus.addEventListener("click", () => {
            pages -= 1;
            update();
        });
        plus.addEventListener("click", () => {
            pages += 1;
            update();
        });
        update();

        const bar = $("[data-pc-bar]");
        const seen = new Map<Element, boolean>();
        const steps = $("[data-pc-steps]");
        const summary = $("[data-pc-summary]");
        const io = new IntersectionObserver((entries) => {
            entries.forEach((e) => seen.set(e.target, e.isIntersecting));
            bar.toggleAttribute(
                "data-visible",
                !!seen.get(steps) && !seen.get(summary),
            );
        });
        io.observe(steps);
        io.observe(summary);
    };

    document.addEventListener("astro:page-load", init);
</script>

