---
const icons = [
    { src: "/icons/figma-icon.svg", name: "Figma" },
    { src: "/icons/react-icon.svg", name: "React" },
    { src: "/icons/react-query.svg", name: "React Query" },
    { src: "/icons/material-ui.svg", name: "Material UI" },
    { src: "/icons/zustand.webp", name: "Zustand" },
    { src: "/icons/typescript.svg", name: "TypeScript" },
    { src: "/icons/shadcn-ui.svg", name: "shadcn/ui" },
    { src: "/icons/next.svg", name: "Next.js" },
    { src: "/icons/tailwindcss.svg", name: "Tailwind CSS" },
    { src: "/icons/prisma.svg", name: "Prisma" },
    { src: "/icons/Drizzle.svg", name: "Drizzle" },
    { src: "/icons/Astro.svg", name: "Astro" },
    { src: "/icons/linear-dark-logo.svg", name: "Linear" },
    { src: "/icons/claude-logo.svg", name: "Claude" },
    { src: "/icons/neon-logomark-light-color.svg", name: "Neon" },
];

const visibleSlotCount = 7;
const visibleIcons = icons.slice(0, visibleSlotCount);
---

<section
    aria-label="Technologies utilisées"
    class="wui-logo-shuffle wui-logo-shuffle--lg mx-auto my-8 w-full max-w-5xl max-sm:my-4"
    data-wui-logo-shuffle
    data-wui-logo-shuffle-items={JSON.stringify(icons)}
    data-wui-logo-shuffle-slot-count={visibleSlotCount}
    data-wui-logo-shuffle-min-delay="800"
    data-wui-logo-shuffle-max-delay="1400"
>
    <ul class="wui-logo-shuffle__list m-0 flex list-none items-center justify-between gap-[var(--wui-logo-shuffle-gap)] p-0 max-sm:justify-center">
        {
            visibleIcons.map((icon) => (
                <li
                    class="wui-logo-shuffle__slot grid min-w-[var(--wui-logo-shuffle-item-size)] flex-[0_1_var(--wui-logo-shuffle-item-size)] place-items-center"
                    data-wui-logo-shuffle-slot
                >
                    <span class="inline-flex size-[var(--wui-logo-shuffle-item-size)] items-center justify-center overflow-hidden rounded-lg">
                        <img
                            class="wui-logo-shuffle__image size-[var(--wui-logo-shuffle-logo-size)] object-contain"
                            src={icon.src}
                            alt=""
                            loading="eager"
                        />
                        <span
                            class="wui-logo-shuffle__initials inline-flex size-full items-center justify-center rounded-[inherit] border text-xs leading-none font-bold tracking-normal text-[var(--wui-color-accent,#3e60d4)]"
                            hidden
                        >
                            {icon.name.slice(0, 2)}
                        </span>
                        <span class="wui-logo-shuffle__label sr-only">
                            {icon.name}
                        </span>
                    </span>
                </li>
            ))
        }
    </ul>
</section>

<script>
    type LogoItem = {
        name: string;
        src?: string;
    };

    type LogoShuffleState = {
        animations: Set<Animation>;
        autoplay: boolean;
        destroyed: boolean;
        indexes: number[];
        introPlayed: boolean;
        isVisible: boolean;
        items: LogoItem[];
        lastSlotIndex?: number;
        maxDelay: number;
        minDelay: number;
        reducedMotion: boolean;
        replayListener: () => void;
        root: HTMLElement;
        slotQueue: number[];
        slots: HTMLElement[];
        timeout?: number;
        visibilityObserver?: IntersectionObserver;
        visibleSlotCount: number;
    };

    const windowWithLogoShuffle = window as Window & {
        __wuiLogoShuffleStates?: Set<LogoShuffleState>;
    };
    const activeLogoShuffleStates =
        windowWithLogoShuffle.__wuiLogoShuffleStates ?? new Set<LogoShuffleState>();
    windowWithLogoShuffle.__wuiLogoShuffleStates = activeLogoShuffleStates;
    const stateByRoot = new WeakMap<HTMLElement, LogoShuffleState>();

    // `animation.finished` rejette quand l'animation est annulée (navigation,
    // reduced-motion) : ce rejet est attendu et sans conséquence.
    const ignoreCancelledAnimation = () => {
        // Rejet attendu, rien à faire.
    };

    function parseInteger(value: string | undefined, fallback: number) {
        const parsed = Number.parseInt(value ?? "", 10);
        return Number.isFinite(parsed) ? parsed : fallback;
    }

    function parseItems(value: string | undefined): LogoItem[] {
        if (!value) return [];

        try {
            const parsed = JSON.parse(value);
            if (!Array.isArray(parsed)) return [];

            return parsed.filter(
                (item): item is LogoItem =>
                    item &&
                    typeof item === "object" &&
                    typeof item.name === "string",
            );
        } catch {
            return [];
        }
    }

    function randomInt(min: number, max: number) {
        return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    function createSlotQueue(count: number, previous: number | undefined) {
        const queue = Array.from({ length: count }, (_, index) => index);

        for (let index = queue.length - 1; index > 0; index -= 1) {
            const swapIndex = randomInt(0, index);
            [queue[index], queue[swapIndex]] = [queue[swapIndex], queue[index]];
        }

        if (queue.length > 1 && queue[0] === previous) {
            [queue[0], queue[1]] = [queue[1], queue[0]];
        }

        return queue;
    }

    function getNextSlotIndex(state: LogoShuffleState) {
        if (state.slotQueue.length === 0) {
            state.slotQueue = createSlotQueue(
                state.visibleSlotCount,
                state.lastSlotIndex,
            );
        }

        const slotIndex = state.slotQueue.shift() ?? 0;
        state.lastSlotIndex = slotIndex;
        return slotIndex;
    }

    function getNextItemIndex(state: LogoShuffleState) {
        const visibleIndexes = new Set(state.indexes);
        const candidates = state.items
            .map((_, index) => index)
            .filter((index) => !visibleIndexes.has(index));

        if (candidates.length === 0) return undefined;

        return candidates[randomInt(0, candidates.length - 1)];
    }

    function renderSlot(slot: HTMLElement, item: LogoItem) {
        const image = slot.querySelector<HTMLImageElement>(
            ".wui-logo-shuffle__image",
        );
        const initials = slot.querySelector<HTMLElement>(
            ".wui-logo-shuffle__initials",
        );
        const label = slot.querySelector<HTMLElement>(
            ".wui-logo-shuffle__label",
        );

        if (image) {
            image.src = item.src ?? "";
            image.hidden = !item.src;
        }

        if (initials) {
            initials.textContent = item.name.slice(0, 2);
            initials.hidden = Boolean(item.src);
        }

        if (label) label.textContent = item.name;
    }

    function runSlotAnimation(
        slot: HTMLElement,
        state: LogoShuffleState,
        keyframes: Keyframe[],
        options: KeyframeAnimationOptions,
    ) {
        const animation = slot.animate(keyframes, options);

        state.animations.add(animation);
        animation.finished
            .catch(ignoreCancelledAnimation)
            .finally(() => state.animations.delete(animation));

        return animation;
    }

    async function swapSlot(
        slot: HTMLElement,
        item: LogoItem,
        state: LogoShuffleState,
    ) {
        if (state.destroyed || !document.contains(slot)) return;

        if (state.reducedMotion) {
            renderSlot(slot, item);
            return;
        }

        await runSlotAnimation(
            slot,
            state,
                [
                    { filter: "blur(0px)", opacity: 1, transform: "translateY(0)" },
                    { filter: "blur(8px)", opacity: 0, transform: "translateY(8px)" },
                ],
                { duration: 140, easing: "cubic-bezier(0.4, 0, 0.2, 1)" },
        ).finished.catch(ignoreCancelledAnimation);

        if (state.destroyed || !document.contains(slot)) return;

        renderSlot(slot, item);

        await runSlotAnimation(
            slot,
            state,
                [
                    { filter: "blur(8px)", opacity: 0, transform: "translateY(-8px)" },
                    { filter: "blur(0px)", opacity: 1, transform: "translateY(0)" },
                ],
                { duration: 260, easing: "cubic-bezier(0.2, 0, 0, 1)" },
        ).finished.catch(ignoreCancelledAnimation);
    }

    function schedule(root: HTMLElement, state: LogoShuffleState) {
        window.clearTimeout(state.timeout);
        state.timeout = undefined;

        if (
            state.destroyed ||
            state.reducedMotion ||
            !state.autoplay ||
            !state.isVisible ||
            !document.contains(root)
        ) {
            return;
        }

        state.timeout = window.setTimeout(
            () => tick(root, state),
            randomInt(state.minDelay, state.maxDelay),
        );
    }

    function tick(root: HTMLElement, state: LogoShuffleState) {
        if (state.destroyed || !state.isVisible || !document.contains(root)) {
            return;
        }

        const slotIndex = getNextSlotIndex(state);
        const nextItemIndex = getNextItemIndex(state);
        const slot = state.slots[slotIndex];

        if (nextItemIndex === undefined || !slot) {
            schedule(root, state);
            return;
        }

        state.indexes[slotIndex] = nextItemIndex;
        void swapSlot(slot, state.items[nextItemIndex], state);
        schedule(root, state);
    }

    function replayIntro(root: HTMLElement, state: LogoShuffleState) {
        if (
            state.destroyed ||
            state.reducedMotion ||
            !state.isVisible ||
            !document.contains(root)
        ) {
            return;
        }

        state.introPlayed = true;
        state.slots.forEach((slot, index) => {
            runSlotAnimation(
                slot,
                state,
                [
                    { filter: "blur(8px)", opacity: 0, transform: "translateY(8px)" },
                    { filter: "blur(0px)", opacity: 1, transform: "translateY(0)" },
                ],
                {
                    delay: index * 45,
                    duration: 280,
                    easing: "cubic-bezier(0.2, 0, 0, 1)",
                },
            );
        });
    }

    function destroyLogoShuffle(state: LogoShuffleState) {
        if (state.destroyed) return;

        state.destroyed = true;
        window.clearTimeout(state.timeout);
        state.visibilityObserver?.disconnect();
        state.animations.forEach((animation) => animation.cancel());
        state.animations.clear();
        state.root.removeEventListener(
            "willui:logo-shuffle:replay",
            state.replayListener,
        );
        delete state.root.dataset.wuiLogoShuffleReady;
        stateByRoot.delete(state.root);
        activeLogoShuffleStates.delete(state);
    }

    function resetLogoShuffles() {
        Array.from(activeLogoShuffleStates).forEach(destroyLogoShuffle);
    }

    function bindLogoShuffle(root: HTMLElement) {
        if (stateByRoot.has(root)) return;
        if (root.dataset.wuiLogoShuffleReady === "true") return;

        const items = parseItems(root.dataset.wuiLogoShuffleItems);
        const visibleSlotCount = Math.min(
            Math.max(
                0,
                parseInteger(root.dataset.wuiLogoShuffleSlotCount, 0),
            ),
            items.length,
        );
        const slots = Array.from(
            root.querySelectorAll<HTMLElement>("[data-wui-logo-shuffle-slot]"),
        );

        if (items.length === 0 || visibleSlotCount === 0 || slots.length === 0) {
            return;
        }

        const minDelay = Math.max(
            0,
            parseInteger(root.dataset.wuiLogoShuffleMinDelay, 900),
        );
        const maxDelay = Math.max(
            minDelay,
            parseInteger(root.dataset.wuiLogoShuffleMaxDelay, 1600),
        );
        const media = window.matchMedia("(prefers-reduced-motion: reduce)");
        const state: LogoShuffleState = {
            animations: new Set(),
            autoplay:
                root.dataset.wuiLogoShuffleAutoplay !== "false" &&
                items.length > visibleSlotCount,
            destroyed: false,
            indexes: Array.from(
                { length: visibleSlotCount },
                (_, index) => index,
            ),
            introPlayed: false,
            isVisible: !("IntersectionObserver" in window),
            items,
            lastSlotIndex: undefined,
            maxDelay,
            minDelay,
            reducedMotion: media.matches,
            replayListener: () => replayIntro(root, state),
            root,
            slotQueue: createSlotQueue(visibleSlotCount, undefined),
            slots: slots.slice(0, visibleSlotCount),
            timeout: undefined,
            visibleSlotCount,
        };

        stateByRoot.set(root, state);
        activeLogoShuffleStates.add(state);
        root.dataset.wuiLogoShuffleReady = "true";
        root.addEventListener("willui:logo-shuffle:replay", state.replayListener);

        if ("IntersectionObserver" in window) {
            const visibilityObserver = new IntersectionObserver(
                (entries) => {
                    const isVisible = entries[0]?.isIntersecting ?? false;

                    if (state.isVisible === isVisible) return;

                    state.isVisible = isVisible;

                    if (!isVisible) {
                        window.clearTimeout(state.timeout);
                        state.timeout = undefined;
                        return;
                    }

                    state.introPlayed = true;
                    schedule(root, state);
                },
                { rootMargin: "160px 0px", threshold: 0.01 },
            );

            state.visibilityObserver = visibilityObserver;
            visibilityObserver.observe(root);
        } else {
            state.introPlayed = true;
            schedule(root, state);
        }
    }

    function initLogoShuffles() {
        document
            .querySelectorAll<HTMLElement>("[data-wui-logo-shuffle]")
            .forEach((root) => bindLogoShuffle(root));
    }

    const replayListenerKey = "__wuiLogoShuffleReplayListener";
    const lifecycleListenerKey = "__wuiLogoShuffleLifecycleListener";

    if (!(replayListenerKey in window)) {
        Object.defineProperty(window, replayListenerKey, { value: true });

        document.addEventListener("click", (event) => {
            const trigger = (
                event.target as Element | null
            )?.closest<HTMLElement>("[data-wui-logo-shuffle-replay]");

            if (!trigger) return;

            const targetId =
                trigger.getAttribute("aria-controls") ??
                trigger.dataset.wuiLogoShuffleReplay;
            const root = targetId
                ? document.getElementById(targetId)
                : trigger
                      .closest<HTMLElement>("[data-wui-logo-shuffle-demo]")
                      ?.querySelector<HTMLElement>("[data-wui-logo-shuffle]");

            root?.dispatchEvent(
                new CustomEvent("willui:logo-shuffle:replay"),
            );
        });
    }

    if (!(lifecycleListenerKey in window)) {
        Object.defineProperty(window, lifecycleListenerKey, { value: true });

        document.addEventListener("astro:before-swap", resetLogoShuffles);
        document.addEventListener("astro:page-load", initLogoShuffles);
    }

    initLogoShuffles();
</script>

<style>
    .wui-logo-shuffle {
        --wui-logo-shuffle-gap: var(--wui-space-4, 1rem);
        --wui-logo-shuffle-item-size: 3rem;
        --wui-logo-shuffle-logo-size: 1.75rem;

        color: var(--wui-color-text, #15171a);
    }

    .wui-logo-shuffle--lg {
        --wui-logo-shuffle-gap: var(--wui-space-5, 1.5rem);
        --wui-logo-shuffle-item-size: 3.5rem;
        --wui-logo-shuffle-logo-size: 2rem;
    }

    .wui-logo-shuffle__image[hidden],
    .wui-logo-shuffle__initials[hidden] {
        display: none;
    }

    .wui-logo-shuffle__initials {
        align-items: center;
        background: color-mix(
            in oklab,
            var(--wui-color-accent, #3e60d4),
            transparent 90%
        );
        border: 1px solid
            color-mix(in oklab, var(--wui-color-accent, #3e60d4), transparent 72%);
    }

    @media (max-width: 640px) {
        .wui-logo-shuffle {
            --wui-logo-shuffle-gap: 0.75rem;
            --wui-logo-shuffle-item-size: 2.75rem;
            --wui-logo-shuffle-logo-size: 1.625rem;
        }

        .wui-logo-shuffle__slot:nth-child(n + 6) {
            display: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .wui-logo-shuffle__slot {
            filter: none !important;
            opacity: 1 !important;
            transform: none !important;
        }
    }
</style>
