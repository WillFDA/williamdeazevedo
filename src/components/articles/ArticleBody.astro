---
import type { ComponentProps } from "astro/types";
import FadeReveal from "@/components/animations/FadeReveal.astro";
import FaqSection from "@/components/FaqSection.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import {
    articleFaqJsonLd,
    FAQ_SECTION_TITLE,
    splitArticleFaq,
} from "@/lib/articleFaq";

interface Props {
    articleId: string;
    tocItems: ComponentProps<typeof TableOfContents>["items"];
}

const { articleId, tocItems } = Astro.props;
// Default slot: the article's <Content />. Its FAQ is laid out like the
// homepage one, across the full width, so the body is split around it and the
// sticky table of contents stops above it.
const { after, before, faq } = splitArticleFaq(
    (await Astro.slots.render("default")) ?? "",
);
const shellClass =
    "article-body-shell mx-auto grid max-w-6xl gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,42rem)_minmax(13rem,16rem)] lg:gap-12";
---

<div class={shellClass}>
    {/* L'aside est en premier dans le DOM pour que l'ordre du focus clavier
        corresponde à l'ordre visuel sur mobile (WCAG 2.4.3), puis placé en
        colonne 3 sur grand écran. */}
    <aside class="article-toc-column lg:col-start-3 lg:row-start-1">
        <TableOfContents items={tocItems} />
    </aside>

    <FadeReveal class="lg:col-start-2 lg:row-start-1" delay={0.3}>
        <div class="article-prose min-w-0" set:html={before} />
    </FadeReveal>
</div>

{
    faq && (
        <>
            <script
                type="application/ld+json"
                is:inline
                set:html={JSON.stringify(articleFaqJsonLd(faq))}
            />
            <FaqSection
                class="article-faq"
                ctaLocation={`article-${articleId}-faq`}
                headingLevel={3}
                items={faq.items}
                padded={false}
                title={FAQ_SECTION_TITLE}
                titleId={faq.titleId}
            />
            {after && (
                <div class={shellClass}>
                    <div class="hidden lg:block" aria-hidden="true" />
                    <div class="article-prose min-w-0" set:html={after} />
                </div>
            )}
        </>
    )
}
