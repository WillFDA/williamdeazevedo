---
import ArticleImage from "@/components/articles/ArticleImage.astro";
import ArticleTag from "@/components/articles/ArticleTag.astro";
import { type Article, formatArticleDate } from "@/lib/articles";

interface Props {
    articles: readonly Article[];
}

const { articles } = Astro.props;
---

{
    articles.length > 0 && (
        <section
            class="mx-auto mt-16 flex max-w-6xl flex-col gap-8"
            aria-labelledby="related-articles-title"
        >
            <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                <h2
                    id="related-articles-title"
                    class="section-heading section-heading--left"
                >
                    À lire aussi
                </h2>
                <a
                    class="text-sm font-medium text-gray-900 underline decoration-gray-300 underline-offset-4 transition-colors hover:text-blue-500 hover:decoration-blue-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                    href="/articles/"
                >
                    Tous les articles&nbsp;<span aria-hidden="true">→</span>
                </a>
            </div>
            <ul class="grid gap-4 lg:grid-cols-3 lg:gap-8">
                {articles.map((item) => (
                    <li class="group relative flex h-full flex-col rounded-2xl bg-surface-muted p-5 text-gray-900 sm:p-6 lg:rounded-none lg:bg-transparent lg:p-0">
                        {item.data.image && (
                            <span class="mb-5 hidden aspect-video w-full overflow-hidden rounded-lg bg-gray-200 lg:block">
                                <ArticleImage
                                    class="size-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-[1.02]"
                                    src={item.data.image.src}
                                    alt=""
                                    sizes="(min-width: 1024px) 20rem, 100vw"
                                    widths={[480, 800]}
                                />
                            </span>
                        )}
                        <span class="flex flex-wrap items-center gap-3">
                            {item.data.tags[0] && (
                                <ArticleTag tag={item.data.tags[0]} />
                            )}
                            <time
                                class="text-sm font-normal text-gray-600"
                                datetime={item.data.pubDate.toISOString()}
                            >
                                {formatArticleDate(item.data.pubDate)}
                            </time>
                        </span>
                        <h3 class="mt-4 text-xl font-normal leading-snug text-gray-900 text-pretty">
                            <a
                                class="text-inherit no-underline after:absolute after:inset-0 after:content-[''] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                                href={`/articles/${item.id}/`}
                            >
                                {item.data.title}
                            </a>
                        </h3>
                        <p class="mt-2 line-clamp-2 text-sm font-normal leading-6 text-gray-600">
                            {item.data.description}
                        </p>
                    </li>
                ))}
            </ul>
        </section>
    )
}
