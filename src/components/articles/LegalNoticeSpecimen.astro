---
/**
 * Spécimen interactif d'une page de mentions légales pour une entreprise
 * fictive. Le sélecteur EI / société change les lignes qui dépendent du
 * statut, sans JavaScript (radios + :has). Sans :has, la version EI reste lisible.
 */
const rows = [
  {
    group: "Éditeur",
    label: "Identité",
    ei: "Julien Martin, entrepreneur individuel (EI)",
    sas: "Atelier Martin SARL, capital de 5 000 €",
    varies: true,
  },
  {
    group: "Éditeur",
    label: "Adresse",
    ei: "12 rue des Artisans, 44000 Nantes",
    sas: "Siège social : 12 rue des Artisans, 44000 Nantes",
    varies: true,
  },
  {
    group: "Éditeur",
    label: "Immatriculation",
    ei: "SIREN 123 456 789",
    sas: "RCS Nantes 123 456 789",
    varies: true,
  },
  { group: "Éditeur", label: "TVA", ei: "FR 00 123456789", sas: "FR 00 123456789", varies: false },
  {
    group: "Contact",
    label: "Téléphone et e-mail",
    ei: "02 00 00 00 00 · contact@atelier-martin.fr",
    sas: "02 00 00 00 00 · contact@atelier-martin.fr",
    varies: false,
  },
  {
    group: "Publication",
    label: "Directeur de la publication",
    ei: "Julien Martin",
    sas: "Julien Martin, gérant",
    varies: true,
  },
  {
    group: "Hébergeur",
    label: "Nom, adresse, téléphone",
    ei: "Hébergeur Exemple SAS · 1 avenue du Serveur, 75000 Paris · 01 00 00 00 00",
    sas: "Hébergeur Exemple SAS · 1 avenue du Serveur, 75000 Paris · 01 00 00 00 00",
    varies: false,
    note: "Celui de la facture d’hébergement, pas forcément votre agence web.",
  },
];
---

<div class="legal-specimen">
  <fieldset class="specimen-switch">
    <legend>Votre statut</legend>
    <label><input type="radio" name="specimen-status" value="ei" checked /><span>Entreprise individuelle</span></label>
    <label><input type="radio" name="specimen-status" value="sas" /><span>Société</span></label>
  </fieldset>

  <div class="specimen-window">
    <div class="specimen-bar" aria-hidden="true">
      <span class="specimen-dots"><i></i><i></i><i></i></span>
      <span class="specimen-url">atelier-martin.fr/mentions-legales</span>
    </div>
    <div class="specimen-page">
      <p class="specimen-title">Mentions légales</p>
      <p class="specimen-fiction">Exemple fictif : remplacez chaque valeur par vos propres données.</p>
      <dl>
        {rows.map((row) => (
          <div class:list={["specimen-row", { "specimen-row--varies": row.varies }]}>
            <dt><span class="specimen-group">{row.group}</span>{row.label}</dt>
            <dd>
              {row.varies ? (
                <>
                  <span class="specimen-value specimen-value--ei">{row.ei}</span>
                  <span class="specimen-value specimen-value--sas">{row.sas}</span>
                </>
              ) : (
                <span>{row.ei}</span>
              )}
              {row.note && <span class="specimen-note">{row.note}</span>}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <div class="specimen-footer">
    <p class="specimen-legend"><span aria-hidden="true"></span>Lignes qui changent selon le statut</p>
    <p class="specimen-risk">
      Absence de mentions&nbsp;:&#32;<strong class="specimen-value specimen-value--ei">1 an de prison et 75 000 € d’amende</strong><strong class="specimen-value specimen-value--sas">375 000 € d’amende</strong>
    </p>
  </div>
</div>

<style>
  .legal-specimen { display: block; padding: clamp(1rem, 3.5vw, 1.75rem); border: 1px solid var(--color-gray-200); border-radius: 1.25rem; background: radial-gradient(120% 90% at 100% 0%, var(--color-blue-50), transparent 60%), var(--color-snow-50); color: var(--color-gray-600); }

  .specimen-switch { display: inline-flex; gap: .25rem; margin: 0 0 1rem; padding: .25rem; border: 0; border-radius: .8rem; background: var(--color-surface-muted); }
  .specimen-switch legend { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .specimen-switch label { position: relative; cursor: pointer; }
  .specimen-switch input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .specimen-switch span { display: block; padding: .5rem .85rem; border-radius: .6rem; color: var(--color-gray-600); font-size: .875rem; font-weight: 500; line-height: 1.2; transition: background-color 200ms ease, color 200ms ease, box-shadow 200ms ease; }
  .specimen-switch input:checked + span { background: var(--color-snow-50); color: var(--color-gray-900); box-shadow: 0 6px 16px -10px rgba(34, 42, 55, .45); }
  .specimen-switch input:focus-visible + span { outline: 2px solid var(--color-blue-500); outline-offset: 2px; }

  .specimen-window { overflow: hidden; border: 1px solid rgba(226, 232, 240, .9); border-radius: 1rem; background: var(--color-snow-50); box-shadow: 0 22px 44px -30px rgba(34, 42, 55, .48); }
  .specimen-bar { display: flex; align-items: center; gap: .75rem; padding: .6rem .8rem; border-bottom: 1px solid var(--color-gray-100); background: var(--color-snow-200); }
  .specimen-dots { display: flex; gap: .3rem; }
  .specimen-dots i { width: .5rem; height: .5rem; border-radius: 999px; background: var(--color-gray-200); }
  .specimen-url { flex: 1; min-width: 0; overflow: hidden; padding: .3rem .6rem; border-radius: .45rem; background: var(--color-snow-50); color: var(--color-gray-500); font-size: .75rem; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }

  .specimen-page { padding: 1.1rem clamp(1rem, 3vw, 1.5rem) .6rem; }
  .legal-specimen .specimen-title { margin: 0; color: var(--color-gray-900); font-size: 1.125rem; font-weight: 500; letter-spacing: -.01em; }
  .legal-specimen .specimen-fiction { margin: .2rem 0 .6rem; color: var(--color-gray-500); font-size: .75rem; }
  .legal-specimen dl { margin: 0; }
  .specimen-row { position: relative; display: grid; grid-template-columns: minmax(0, 11rem) minmax(0, 1fr); gap: 1rem; padding: .7rem 0 .7rem .75rem; border-top: 1px solid var(--color-gray-100); font-size: .875rem; line-height: 1.5; }
  .specimen-row::before { content: ""; position: absolute; top: .7rem; bottom: .7rem; left: 0; width: 3px; border-radius: 999px; background: transparent; transition: background-color 240ms ease; }
  .specimen-row--varies::before { background: var(--color-blue-500); }
  .specimen-row dt { color: var(--color-gray-900); font-weight: 500; }
  .specimen-group { display: block; color: var(--color-gray-400); font-size: .6875rem; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; }
  .specimen-row dd { margin: 0; color: var(--color-gray-700); }
  .specimen-note { display: inline-block; margin-top: .4rem; padding: .25rem .55rem; border-radius: .45rem; background: #fff7e6; color: #8a5a00; font-size: .75rem; line-height: 1.4; }

  .specimen-value--sas { display: none; }
  .legal-specimen:has(input[value="sas"]:checked) .specimen-value--ei { display: none; }
  .legal-specimen:has(input[value="sas"]:checked) .specimen-value--sas { display: inline; }
  .specimen-row--varies .specimen-value { animation: specimen-swap 420ms ease; }

  .specimen-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .6rem 1rem; margin-top: 1rem; }
  .legal-specimen .specimen-legend { display: flex; align-items: center; gap: .5rem; margin: 0; font-size: .8125rem; }
  .specimen-legend span { width: 3px; height: 1rem; border-radius: 999px; background: var(--color-blue-500); }
  .legal-specimen .specimen-risk { margin: 0; padding: .45rem .75rem; border-radius: 999px; background: #fdecec; color: #9b1c1c; font-size: .8125rem; line-height: 1.35; }
  .specimen-risk strong { color: #9b1c1c; font-weight: 500; }

  @keyframes specimen-swap { from { opacity: 0; transform: translateY(3px); } to { opacity: 1; transform: none; } }
  @media (max-width: 560px) { .specimen-row { grid-template-columns: minmax(0, 1fr); gap: .15rem; } }
  @media (prefers-reduced-motion: reduce) { .specimen-row--varies .specimen-value { animation: none; } .specimen-switch span, .specimen-row::before { transition: none; } }
</style>
