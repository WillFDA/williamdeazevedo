---
import { getTagIconSvg } from "@/lib/articleTagIcons";

interface Props {
    active?: boolean;
    tag: string;
}

const { active = false, tag } = Astro.props;
---

<span
    class:list={[
        "inline-flex items-center gap-2 rounded-xl px-3.5 py-2 text-sm font-normal leading-none shadow-[0_10px_24px_-18px_rgba(34,42,55,0.45)]",
        active ? "bg-blue-500 text-snow-50" : "bg-snow-50 text-gray-900",
    ]}
>
    <span
        class:list={[
            "inline-flex size-4 shrink-0 items-center justify-center *:size-full",
            active ? "text-snow-50" : "text-blue-500",
        ]}
        set:html={getTagIconSvg(tag)}
    />
    {tag}
</span>
