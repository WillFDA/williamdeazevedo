---
import RelatedServicesBento from "@/components/RelatedServicesBento.astro";
import { articleServices } from "@/data/serviceArticles";
import { getServiceBySlug, type Service } from "@/data/services";

interface Props {
    articleId: string;
}

const { articleId } = Astro.props;
const isService = (item: Service | undefined): item is Service =>
    item !== undefined;
const service = (articleServices[articleId] ?? [])
    .map((slug) => getServiceBySlug(slug))
    .find(isService);
// The article's service leads the bento, then the services it relates to.
const services = service
    ? [
          service,
          ...service.relatedServices
              .map((slug) => getServiceBySlug(slug))
              .filter(isService),
      ].slice(0, 3)
    : [];
---

{
    services.length > 0 && (
        <aside class="mt-16">
            <RelatedServicesBento services={services} />
        </aside>
    )
}
