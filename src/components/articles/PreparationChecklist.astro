---
interface Props {
  items?: string[];
  legend?: string;
  note?: string;
  countLabel?: string;
  doneLabel?: string;
}

const defaultItems = [
  "L’objectif principal est formulé en une phrase concrète.",
  "Chaque page a un rôle et un responsable de contenu.",
  "Les options sont séparées du lancement.",
  "Budget initial et frais récurrents sont distingués.",
  "Les dates tiennent compte de vos propres validations.",
  "La livraison comporte des tests et une remise des accès.",
  "L’identité est prête à transmettre, ou sa création et son budget distinct sont prévus.",
];
const {
  items = defaultItems,
  legend = "Votre brief est-il prêt à partir ?",
  note = "Cochez les points déjà clarifiés. Cette liste reste sur cette page : aucune réponse n’est enregistrée ni transmise. Elle n’est pas jointe à votre prise de contact.",
  countLabel = "points clarifiés",
  doneLabel = "Prêt à en discuter !",
} = Astro.props;
---

<preparation-checklist class="preparation-checklist" data-count-label={countLabel} data-done-label={doneLabel}>
  <fieldset>
    <legend>{legend}</legend>
    <p class="checklist-note">{note}</p>
    <ul class="checklist-items">
      {items.map((item) => (
        <li><label><input type="checkbox" /><span>{item}</span></label></li>
      ))}
    </ul>
  </fieldset>
  <div class="checklist-tools" hidden>
    <div class="checklist-progress">
      <p class="checklist-count" role="status" aria-live="polite" aria-atomic="true"></p>
      <span class="checklist-bar" aria-hidden="true"><span></span></span>
    </div>
    <button type="button">Tout décocher</button>
  </div>
</preparation-checklist>

<script>
  class PreparationChecklist extends HTMLElement {
    private controller?: AbortController;

    connectedCallback() {
      if (this.controller) return;
      this.controller = new AbortController();
      const inputs = [...this.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];
      const tools = this.querySelector<HTMLElement>(".checklist-tools");
      const status = this.querySelector<HTMLElement>(".checklist-count");
      const reset = this.querySelector<HTMLButtonElement>("button");
      const bar = this.querySelector<HTMLElement>(".checklist-bar > span");
      if (!tools || !status || !reset || !bar) return;
      const countLabel = this.dataset.countLabel ?? "";
      const doneLabel = this.dataset.doneLabel ?? "";
      const update = () => {
        const count = inputs.filter((input) => input.checked).length;
        status.textContent = `${count} / ${inputs.length} ${countLabel}${count === inputs.length && doneLabel ? ` · ${doneLabel}` : ""}`;
        reset.disabled = count === 0;
        bar.style.transform = `scaleX(${count / inputs.length})`;
      };
      this.addEventListener("change", update, { signal: this.controller.signal });
      reset.addEventListener("click", () => {
        for (const input of inputs) input.checked = false;
        update();
        inputs[0]?.focus();
      }, { signal: this.controller.signal });
      update();
      tools.hidden = false;
    }

    disconnectedCallback() {
      this.controller?.abort();
      this.controller = undefined;
    }
  }

  // Custom elements reconnect automatically after Astro swaps; no global listeners.
  if (!customElements.get("preparation-checklist")) {
    customElements.define("preparation-checklist", PreparationChecklist);
  }
</script>

<style>
  .preparation-checklist { display: block; padding: clamp(1.25rem, 4vw, 2rem); border: 1px solid var(--color-gray-200); border-radius: 1rem; background: var(--color-snow-50); color: var(--color-gray-600); }
  .preparation-checklist fieldset { min-width: 0; padding: 0; margin: 0; border: 0; }
  .preparation-checklist legend { padding: 0; font-size: 1.25rem; font-weight: 500; letter-spacing: -.01em; color: var(--color-gray-900); }
  .preparation-checklist .checklist-note { margin: .4rem 0 1.25rem; font-size: .875rem; line-height: 1.6; color: var(--color-gray-600); }
  .preparation-checklist .checklist-items { display: grid; gap: .35rem; padding: 0; margin: 0; list-style: none; }
  .preparation-checklist .checklist-items li { margin: 0; }
  .checklist-items label { display: flex; align-items: flex-start; gap: .85rem; padding: .75rem .9rem; min-height: 44px; cursor: pointer; border-radius: .6rem; background: var(--color-surface-muted); font-size: .9375rem; line-height: 1.55; transition: background-color 160ms ease, color 160ms ease; }
  .checklist-items label:hover { background: color-mix(in srgb, var(--color-gray-200) 50%, var(--color-surface-muted)); }
  .checklist-items input { flex: 0 0 auto; width: 1.15rem; height: 1.15rem; margin: .2rem 0 0; accent-color: var(--color-blue-500); cursor: pointer; }
  .checklist-items label:has(input:checked) { background: var(--color-blue-50); color: var(--color-gray-900); }
  .checklist-items label:has(input:focus-visible) { outline: 2px solid var(--color-blue-500); outline-offset: 2px; }
  .checklist-items input:focus-visible, .checklist-tools button:focus-visible { outline: 2px solid var(--color-blue-500); outline-offset: 3px; }
  .checklist-tools:not([hidden]) { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1.25rem; }
  .checklist-progress { flex: 1 1 12rem; }
  .preparation-checklist .checklist-count { margin: 0 0 .45rem; color: var(--color-gray-900); font-size: .875rem; font-weight: 500; font-variant-numeric: tabular-nums; }
  .checklist-bar { display: block; height: .375rem; border-radius: 999px; background: var(--color-gray-100); overflow: hidden; }
  .checklist-bar > span { display: block; height: 100%; border-radius: inherit; background: var(--color-blue-500); transform: scaleX(0); transform-origin: left; transition: transform 240ms cubic-bezier(.2, 0, 0, 1); }
  .checklist-tools button { min-height: 40px; padding: .5rem .9rem; border: 1px solid var(--color-gray-200); border-radius: .6rem; color: var(--color-gray-900); background: var(--color-snow-50); font: inherit; font-size: .875rem; cursor: pointer; transition: background-color 160ms ease; }
  .checklist-tools button:hover:not(:disabled) { background: var(--color-surface-muted); }
  .checklist-tools button:disabled { color: var(--color-gray-400); cursor: default; }
  @media (prefers-reduced-motion: reduce) { .checklist-items label, .checklist-bar > span, .checklist-tools button { transition: none; } }
</style>
