---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { getPublicArticleImage } from "@/lib/articleImages";

// Image d'article passée par le pipeline d'Astro : largeur et hauteur connues
// (pas de décalage de mise en page), variantes AVIF/WebP et srcset responsive.
// `src` accepte une image importée ou une URL publique `/articles/...`.
interface Props {
    alt: string;
    class?: string;
    draggable?: "false" | "true";
    fetchpriority?: "auto" | "high" | "low";
    loading?: "eager" | "lazy";
    sizes: string;
    src: ImageMetadata | string;
    widths?: number[];
}

const {
    alt,
    class: className,
    draggable,
    fetchpriority,
    loading = "lazy",
    sizes,
    src,
    widths = [640, 1024, 1600],
} = Astro.props;

const image = typeof src === "string" ? getPublicArticleImage(src) : src;
if (!image) {
    throw new Error(
        `Image d'article introuvable : « ${String(src)} ». Placez-la dans public/articles/ (formats webp, png, jpg).`,
    );
}
// Pas d'agrandissement : on ne génère que des largeurs <= l'original.
const usableWidths = widths.filter((width) => width <= image.width);
const finalWidths = usableWidths.length > 0 ? usableWidths : [image.width];
---

<Picture
    alt={alt}
    class={className}
    decoding={loading === "eager" ? "auto" : "async"}
    draggable={draggable}
    fallbackFormat="webp"
    fetchpriority={fetchpriority}
    formats={["avif", "webp"]}
    loading={loading}
    sizes={sizes}
    src={image}
    widths={finalWidths}
/>
