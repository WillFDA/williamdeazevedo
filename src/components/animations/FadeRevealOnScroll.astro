---
import type { HTMLAttributes } from "astro/types";
import { buildRevealStyle, joinClasses } from "@/lib/reveal";

type Props = Omit<HTMLAttributes<"div">, "class"> & {
    animate?: boolean;
    class?: string;
    delay?: number | string;
};

const {
    animate = true,
    class: classAttribute,
    delay = 0,
    style,
    ...restProps
} = Astro.props as Props;
---

<div
    {...restProps}
    class={joinClasses(
        animate && "fade-reveal-on-scroll is-reveal-ready",
        classAttribute,
    )}
    data-reveal-on-scroll={animate ? "" : undefined}
    style={buildRevealStyle(delay, style, animate)}
>
    <slot />
</div>

<style>
    .fade-reveal-on-scroll {
        transition:
            opacity 650ms cubic-bezier(0.2, 0, 0, 1),
            transform 650ms cubic-bezier(0.2, 0, 0, 1),
            filter 650ms cubic-bezier(0.2, 0, 0, 1);
        transition-delay: var(--fade-delay, 0s);
    }

    .fade-reveal-on-scroll.is-reveal-ready {
        filter: blur(2px);
        opacity: 0;
        transform: translate3d(0, 1rem, 0);
        will-change: opacity, transform, filter;
    }

    .fade-reveal-on-scroll.is-reveal-ready.is-visible {
        filter: none;
        opacity: 1;
        transform: none;
        will-change: auto;
    }

    .fade-reveal-on-scroll.is-reveal-complete {
        filter: none;
        opacity: 1;
        transform: none;
        transition: none;
        will-change: auto;
    }

    @media (scripting: none), (prefers-reduced-motion: reduce), print {
        .fade-reveal-on-scroll,
        .fade-reveal-on-scroll.is-reveal-ready,
        .fade-reveal-on-scroll.is-reveal-ready.is-visible,
        .fade-reveal-on-scroll.is-reveal-complete {
            filter: none;
            opacity: 1;
            transform: none;
            transition: none;
            will-change: auto;
        }
    }
</style>
