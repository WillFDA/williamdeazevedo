---
import Linkedin from "./icons/nucleo/linkedin-fill.svg";
import XTwitter from "./icons/nucleo/x-twitter-fill.svg";
import WaveText from "./ui/WaveText.astro";
import BrandMark from "./ui/BrandMark.astro";
import { projects } from "@/data/projects";

const year = new Date().getFullYear();
const socialLinks = [
    {
        href: "https://www.linkedin.com/in/william-de-azevedo/",
        icon: Linkedin,
        label: "LinkedIn",
    },
    {
        href: "https://x.com/Williamdazevedo",
        icon: XTwitter,
        label: "X",
    },
];
const linkGroups = [
    {
        title: "Services",
        links: [
            { href: "/creation-site-vitrine/", label: "Création site vitrine" },
            { href: "/refonte-site-internet/", label: "Refonte site internet" },
            {
                href: "/creation-site-internet-artisan/",
                label: "Site internet artisan",
            },
            {
                href: "/creation-site-internet-professionnel/",
                label: "Site professionnel",
            },
            {
                href: "/services/developpeur-web-freelance/",
                label: "Développeur freelance",
            },
            {
                href: "/services/developpement-sur-mesure/",
                label: "Développement sur mesure",
            },
        ],
    },
    {
        title: "Réalisations",
        links: projects.map((project) => ({
            href: `/realisations/${project.id}/`,
            label: project.title,
        })),
    },
    {
        title: "Ressources",
        links: [
            { href: "/about/", label: "À propos" },
            { href: "/articles/", label: "Conseils" },
            { href: "/mentions-legales/", label: "Mentions légales" },
            { href: "/mentions-legales/#confidentialite", label: "Confidentialité" },
            { href: "/mentions-legales/#cookies", label: "Cookies et traceurs" },
        ],
    },
];
---

<footer
    class="relative left-1/2 mt-24 w-[calc(100dvw-1rem)] -translate-x-1/2 mb-2 rounded-3xl bg-coffee-300 px-4 py-14 text-sm text-snow-50 sm:mb-4 sm:w-[calc(100dvw-2rem)] sm:px-8 sm:py-16 md:mt-32 md:rounded-4xl md:py-20"
    data-site-footer
>
    <div class="mx-auto flex max-w-5xl flex-col gap-12">
        <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
            <div class="max-w-xl">
                <p class="flex flex-col items-start gap-4 text-base font-medium text-snow-50">
                    <BrandMark class="h-7 w-auto" />
                    <span>William De Azevedo</span>
                </p>
                <p class="mt-2 max-w-lg text-base font-light leading-relaxed text-snow-50/75">
                    Développeur front-end freelance pour sites clairs, rapides,
                    accessibles et crédibles.
                </p>
                <a
                    class="mt-5 inline-flex text-snow-50/85 transition-colors hover:text-snow-50 focus-visible:text-snow-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-snow-50"
                    href="mailto:william.deazevedopro@gmail.com"
                >
                    william.deazevedopro@gmail.com
                </a>
                <div class="mt-4 flex flex-wrap gap-4">
                    {
                        socialLinks.map((link) => {
                            const Icon = link.icon;

                            return (
                                <a
                                    aria-label={link.label}
                                    class="inline-flex size-8 items-center justify-center text-snow-50/85 transition-colors hover:text-snow-50 focus-visible:text-snow-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-snow-50"
                                    href={link.href}
                                    rel="noreferrer"
                                    target="_blank"
                                >
                                    <Icon class="size-7" aria-hidden="true" />
                                </a>
                            );
                        })
                    }
                </div>
            </div>
            <button
                aria-controls="cal-drawer"
                aria-haspopup="dialog"
                class="footer-cta relative isolate inline-flex min-h-14 w-full cursor-pointer items-center justify-center overflow-hidden rounded-xl border-0 bg-transparent px-8 py-3 text-sm font-medium text-coffee-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-snow-50 sm:w-auto"
                data-cal-location="footer"
                data-cal-open
                data-wui-wave-parent
                type="button"
            >
                <WaveText text="Réserver 15 min" trigger="parent" />
            </button>
        </div>
        <nav aria-label="Navigation pied de page">
            <div class="grid gap-8 border-t border-snow-50/15 pt-10 sm:grid-cols-3">
                {
                    linkGroups.map((group) => (
                        <div>
                            <h2 class="mb-3 text-xs font-medium uppercase tracking-widest text-snow-50/55">
                                {group.title}
                            </h2>
                            <ul class="flex flex-col gap-2">
                                {group.links.map((link) => (
                                    <li>
                                        <a
                                            class="text-snow-50/80 transition-colors hover:text-snow-50 focus-visible:text-snow-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-snow-50"
                                            href={link.href}
                                        >
                                            {link.label}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </nav>
        <div class="flex flex-wrap items-center justify-between gap-4 border-t border-snow-50/15 pt-6 text-xs text-snow-50/60">
            <p>© {year} William De Azevedo</p>
            <button
                class="cursor-pointer underline-offset-4 transition-colors hover:text-snow-50 hover:underline focus-visible:text-snow-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-snow-50"
                aria-controls="cookie-banner"
                data-cookie-settings
                type="button"
            >
                Gérer les cookies
            </button>
        </div>
    </div>
</footer>

<style>
    .footer-cta::before {
        background: var(--color-snow-50);
        border: 1px solid rgba(34, 42, 55, 0.06);
        border-radius: inherit;
        box-shadow:
            0 24px 46px -22px rgba(14, 23, 37, 0.5),
            inset 0 -2px 5px rgba(34, 42, 55, 0.08);
        content: "";
        inset: 0;
        position: absolute;
        transform: scale(1);
        transition: transform 520ms
            var(--wui-ease-standard, cubic-bezier(0.2, 0, 0, 1));
        z-index: -1;
    }

    .footer-cta:focus-visible::before {
        transform: scale(0.95);
    }

    @media (hover: hover) {
        .footer-cta:hover::before {
            transform: scale(0.95);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .footer-cta::before {
            transition: none;
        }

        .footer-cta:hover::before,
        .footer-cta:focus-visible::before {
            transform: scale(1);
        }
    }
</style>
