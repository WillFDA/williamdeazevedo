---
import FadeReveal from "@/components/animations/FadeReveal.astro";
import ArrowUpRight from "@/components/icons/nucleo/arrow-up-right-fill.svg";
import WaveIcon from "@/components/ui/WaveIcon.astro";
import type {
    ServiceBentoItem,
    ServiceBentoVariant,
} from "@/data/serviceBento";
import BentoVisualArtisan from "./BentoVisualArtisan.astro";
import BentoVisualFrontend from "./BentoVisualFrontend.astro";
import BentoVisualProfessional from "./BentoVisualProfessional.astro";
import BentoVisualRefonte from "./BentoVisualRefonte.astro";
import BentoVisualSeo from "./BentoVisualSeo.astro";
import BentoVisualVitrine from "./BentoVisualVitrine.astro";

type Props = {
    class?: string;
    delay?: number;
    eyebrow?: string;
    item: ServiceBentoItem;
    variant?: ServiceBentoVariant;
};

const {
    class: className,
    delay = 0,
    eyebrow,
    item,
    variant = "related",
} = Astro.props as Props;

const cardClasses: Record<ServiceBentoVariant, string> = {
    feature: "lg:min-h-[640px]",
    related: "min-h-[340px] lg:min-h-[360px]",
    relatedCompact: "min-h-[300px] lg:min-h-[260px]",
    relatedFeature: "min-h-[360px] xl:min-h-[540px]",
    small: "lg:min-h-[320px]",
    support: "lg:min-h-[370px]",
    wide: "lg:min-h-[300px]",
};

const visualClasses: Record<ServiceBentoVariant, string> = {
    feature: "h-[26rem] lg:h-[27.5rem]",
    related: "h-44 sm:h-48",
    relatedCompact: "h-40 lg:h-36",
    relatedFeature: "h-48 sm:h-56 xl:h-[21rem]",
    small: "h-40",
    support: "h-56",
    wide: "h-32 sm:h-36",
};

const sceneScaleClasses: Record<ServiceBentoVariant, string> = {
    feature: "lg:[--bento-vitrine-boost:1.16]",
    related: "[--bento-scene-scale:0.78] sm:[--bento-scene-scale:0.85]",
    relatedCompact: "[--bento-scene-scale:0.7] lg:[--bento-scene-scale:0.62]",
    relatedFeature:
        "[--bento-scene-scale:0.78] sm:[--bento-scene-scale:0.9] xl:[--bento-scene-scale:1.12]",
    small: "",
    support: "",
    wide: "",
};

const descriptionWidthClasses: Record<ServiceBentoVariant, string> = {
    feature: "max-w-md",
    related: "max-w-lg",
    relatedCompact: "max-w-lg",
    relatedFeature: "max-w-xl",
    small: "max-w-lg",
    support: "max-w-xl",
    wide: "max-w-lg",
};
const descriptionClasses = descriptionWidthClasses[variant];
---

<FadeReveal class={["flex", className].filter(Boolean).join(" ")} delay={delay}>
    <a
        class:list={[
            "group relative flex w-full flex-col overflow-hidden rounded-4xl border-[0.5px] border-[#ECEDF1] bg-white text-gray-900 no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500",
            cardClasses[variant],
        ]}
        href={item.href}
        aria-label={item.linkLabel}
    >
        <div
            class:list={[
                "relative m-1 shrink-0 overflow-hidden rounded-3xl bg-surface-muted",
                visualClasses[variant],
                sceneScaleClasses[variant],
            ]}
        >
            {item.visual === "artisan" && <BentoVisualArtisan />}
            {item.visual === "frontend" && <BentoVisualFrontend />}
            {item.visual === "professional" && <BentoVisualProfessional />}
            {item.visual === "refonte" && <BentoVisualRefonte />}
            {item.visual === "seo" && <BentoVisualSeo />}
            {item.visual === "vitrine" && <BentoVisualVitrine />}
        </div>

        <div class="relative z-10 flex flex-1 flex-col px-6 pt-6 pb-6 sm:px-7">
            {
                eyebrow && (
                    <p class="mb-3 text-xs font-normal uppercase tracking-widest text-gray-500">
                        {eyebrow}
                    </p>
                )
            }
            <h3 class="inline-flex items-start gap-2 text-xl font-normal leading-tight text-gray-900">
                {item.title}
                <WaveIcon
                    class="mt-1.5 text-gray-400 transition-colors duration-300 ease-out group-hover:text-gray-900 group-focus-visible:text-gray-900"
                    direction="up-right"
                    style="--wui-wave-icon-size: 0.75rem;"
                    trigger="parent"
                >
                    <ArrowUpRight class="size-full" aria-hidden="true" />
                </WaveIcon>
            </h3>
            <p
                class:list={[
                    "mt-4 text-sm font-light leading-relaxed text-gray-600",
                    descriptionClasses,
                ]}
            >
                {item.description}
            </p>
        </div>
    </a>
</FadeReveal>
