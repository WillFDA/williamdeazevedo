---
/**
 * Scène animée "Création de site vitrine" en deux actes : le curseur
 * "William" construit la page bloc par bloc, puis le curseur "Prospect"
 * découvre le site, clique le CTA et un toast "Nouveau message" tombe.
 * Chorégraphie pilotée par src/scripts/animations/bento/vitrine.ts.
 * Sans JS : page construite + toast visible, curseurs masqués.
 */
---

<div
	class="vitrine-scene pointer-events-none relative flex h-full w-full items-center justify-center overflow-hidden px-3 pt-6 pb-7"
	data-bento-visual="vitrine"
	aria-hidden="true"
>
	<div class="scale-[var(--bento-vitrine-boost,1)]">
		<div class="vitrine-stage relative w-[300px] scale-[var(--bento-scene-scale,1)] transition-transform duration-500 ease-out group-hover:scale-[calc(var(--bento-scene-scale,1)*1.03)] sm:w-[328px]">
			<span class="vitrine-glow absolute -inset-x-8 -inset-y-6 rounded-[3rem] bg-[radial-gradient(60%_60%_at_50%_42%,rgba(62,96,212,0.14),rgba(62,96,212,0)_70%)]" data-bento-vitrine-glow></span>

			<div class="relative w-full rounded-xl bg-white shadow-[0_24px_56px_-28px_rgba(34,42,55,0.38)]">
				<div class="flex items-center gap-1.5 px-3.5 py-2 shadow-[inset_0_-1px_0_rgba(226,232,240,0.72)]">
					<span class="size-1.5 rounded-full bg-[#f87171]/70"></span>
					<span class="size-1.5 rounded-full bg-[#fbbf24]/70"></span>
					<span class="size-1.5 rounded-full bg-[#34d399]/70"></span>
					<span class="ml-2 flex h-4 min-w-0 flex-1 items-center gap-1 rounded-full bg-gray-100 px-2">
						<span class="size-1 shrink-0 rounded-full bg-emerald-400/90"></span>
						<span class="truncate text-[7px] font-medium leading-none text-gray-400">votre-domaine.fr</span>
					</span>
				</div>

				<div class="flex min-h-[152px] items-start gap-5 px-5 pt-5 pb-5" data-bento-vitrine-page>
					<div class="flex min-w-0 flex-1 flex-col gap-3">
						<span class="vitrine-row h-3.5 w-[92%] rounded-full bg-gray-200" data-bento-vitrine-row></span>
						<span class="vitrine-row h-3.5 w-[68%] rounded-full bg-gray-200/80" data-bento-vitrine-row></span>
						<span class="vitrine-row h-3 w-[78%] rounded-full bg-gray-100" data-bento-vitrine-row></span>
						<span class="vitrine-cta mt-2 inline-flex w-fit items-center rounded-full bg-blue-500 px-3 py-1 text-[10px] font-medium text-white shadow-sm" data-bento-vitrine-cta>
							Contact
						</span>
					</div>
					<div class="vitrine-image flex h-[126px] w-[116px] shrink-0 items-center justify-center rounded-lg bg-blue-50 shadow-[0_16px_34px_-28px_rgba(62,96,212,0.55)]" data-bento-vitrine-image>
						<svg xmlns="http://www.w3.org/2000/svg" class="size-[18px] text-blue-200" viewBox="0 0 18 18" aria-hidden="true">
							<g fill="currentColor">
								<path d="M5.5 6C6.60457 6 7.5 5.10457 7.5 4C7.5 2.89543 6.60457 2 5.5 2C4.39543 2 3.5 2.89543 3.5 4C3.5 5.10457 4.39543 6 5.5 6Z" fill="currentColor"></path>
								<path d="M12.661 6.401C11.995 5.495 10.506 5.495 9.83998 6.401L7.12498 10.093L6.28498 8.951C5.61898 8.044 4.13098 8.044 3.46498 8.951L1.06698 12.213C0.673982 12.748 0.615982 13.447 0.915982 14.04C1.21598 14.633 1.81398 15 2.47798 15H15.523C16.186 15 16.785 14.632 17.085 14.04C17.385 13.448 17.326 12.748 16.934 12.213L12.661 6.401Z" fill="currentColor" fill-opacity="0.4"></path>
							</g>
						</svg>
					</div>
				</div>
			</div>

			<span class="vitrine-click-ring absolute top-[118px] left-[38px] size-10 rounded-full border-2 border-blue-400" data-bento-vitrine-click-ring></span>

			<div class="vitrine-toast absolute -top-3 -right-1 flex items-center gap-1.5 rounded-lg bg-white px-2.5 py-1.5 shadow-[0_18px_34px_-18px_rgba(34,42,55,0.5)]" data-bento-vitrine-toast>
				<span class="flex size-3.5 items-center justify-center rounded-full bg-emerald-500">
					<svg class="size-2 text-white" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<path d="M3.5 8.5l3 3 6-7"></path>
					</svg>
				</span>
				<span class="text-[9px] font-medium text-gray-700">Nouveau message</span>
			</div>

			<div class="vitrine-cursor absolute top-0 left-0 flex items-start" data-bento-vitrine-cursor-builder>
				<svg xmlns="http://www.w3.org/2000/svg" class="size-[18px] text-blue-500 drop-shadow-sm" viewBox="0 0 18 18" aria-hidden="true">
					<g fill="currentColor">
						<path d="M15.154,6.253L3.731,2.079h0c-.477-.175-.994-.058-1.353,.3-.357,.358-.473,.876-.298,1.352L6.254,15.154c.188,.517,.66,.846,1.208,.846,.009,0,.019,0,.027,0,.559-.011,1.03-.362,1.2-.895l1.556-4.86,4.859-1.555c.532-.17,.884-.642,.896-1.201,.011-.559-.321-1.044-.846-1.236Z" fill="currentColor"></path>
					</g>
				</svg>
				<span class="mt-2.5 -ml-0.5 rounded-full bg-blue-500 px-1.5 py-0.5 text-[8px] font-semibold text-white shadow-sm">William</span>
			</div>

			<div class="vitrine-cursor absolute top-0 left-0 flex items-start" data-bento-vitrine-cursor-visitor>
				<svg xmlns="http://www.w3.org/2000/svg" class="size-[18px] text-emerald-500 drop-shadow-sm" viewBox="0 0 18 18" aria-hidden="true">
					<g fill="currentColor">
						<path d="M15.154,6.253L3.731,2.079h0c-.477-.175-.994-.058-1.353,.3-.357,.358-.473,.876-.298,1.352L6.254,15.154c.188,.517,.66,.846,1.208,.846,.009,0,.019,0,.027,0,.559-.011,1.03-.362,1.2-.895l1.556-4.86,4.859-1.555c.532-.17,.884-.642,.896-1.201,.011-.559-.321-1.044-.846-1.236Z" fill="currentColor"></path>
					</g>
				</svg>
				<span class="mt-2.5 -ml-0.5 rounded-full bg-emerald-500 px-1.5 py-0.5 text-[8px] font-semibold text-white shadow-sm">Prospect</span>
			</div>
		</div>
	</div>
</div>

<style>
	.vitrine-glow {
		will-change: opacity, transform;
	}

	.vitrine-cursor {
		opacity: 0;
		will-change: transform;
	}

	.vitrine-row {
		transform-origin: left center;
		will-change: transform;
	}

	.vitrine-image {
		transform-origin: center;
		will-change: opacity, transform;
	}

	.vitrine-cta {
		transform-origin: left center;
		will-change: opacity, transform;
	}

	.vitrine-click-ring {
		opacity: 0;
		transform-origin: center;
		will-change: opacity, transform;
	}

	.vitrine-toast {
		transform-origin: center;
		will-change: opacity, transform;
	}
</style>
