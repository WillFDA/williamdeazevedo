---
import { Image } from "astro:assets";
import ArrowRight from "./icons/nucleo/arrow-right-fill.svg";
import ArrowUpRight from "./icons/nucleo/arrow-up-right-fill.svg";
import Star from "./icons/nucleo/star-fill.svg";
import SectionHeader from "./ui/SectionHeader.astro";
import { googleReviews } from "@/data/contact";
import { getPublishedTestimonials } from "@/lib/testimonials";

interface Props {
    id?: string;
}

const { id = "avis" } = Astro.props;
const testimonials = getPublishedTestimonials();

// Guillemets français, espaces insécables à l'intérieur.
const quote = (text: string) => `«\u00A0${text}\u00A0»`;
const formatIndex = (index: number) => String(index + 1).padStart(2, "0");
const lastIndex = formatIndex(testimonials.length - 1);
---

{
    testimonials.length > 0 && (
        <section
            id={id}
            class="section-shell"
            aria-labelledby={`${id}-title`}
        >
            <SectionHeader
                eyebrow="Avis clients"
                id={`${id}-title`}
                title="Ce qu'en disent mes clients"
                description="Leurs mots, leur projet, le site livré : chaque avis renvoie à la réalisation correspondante."
            />

            <ol class="mt-section-content border-t border-gray-200">
                {testimonials.map((testimonial, index) => (
                    <li class="testimonial-row grid gap-y-7 border-b border-gray-200 py-10 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-x-12 md:py-14 lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-x-16">
                        <div class="flex flex-col items-start gap-4 md:row-span-2">
                            <span
                                class="font-mono text-xs font-medium tracking-[0.08em] text-gray-900"
                                aria-hidden="true"
                            >
                                {formatIndex(index)}
                                <span class="text-gray-600">/{lastIndex}</span>
                            </span>
                            {testimonial.image ? (
                                <Image
                                    class="block size-28 rounded-lg bg-snow-600 object-cover md:size-44 lg:size-52"
                                    src={testimonial.image}
                                    alt={testimonial.imageAlt ?? ""}
                                    width={416}
                                    height={416}
                                    widths={[224, 416]}
                                    sizes="(min-width: 1024px) 13rem, (min-width: 768px) 11rem, 7rem"
                                    loading="lazy"
                                />
                            ) : (
                                <span
                                    class="flex size-28 items-center justify-center rounded-lg bg-snow-600 font-mono text-2xl text-gray-900 md:size-44 lg:size-52"
                                    aria-hidden="true"
                                >
                                    {testimonial.initials}
                                </span>
                            )}
                        </div>

                        <figure class="flex min-w-0 flex-col gap-8 md:col-start-2">
                            <blockquote class="testimonial-row__quote m-0 text-gray-900">
                                <p>
                                    {quote(
                                        testimonial.excerpt ?? testimonial.text,
                                    )}
                                </p>
                            </blockquote>
                            <figcaption>
                                <dl class="grid gap-y-3 border-t border-gray-200 pt-5 font-mono text-[0.8125rem] leading-snug lg:grid-cols-[1fr_1fr_1.4fr] lg:gap-x-6">
                                    <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] items-baseline gap-x-3 lg:block">
                                        <dt class="text-[0.6875rem] font-medium uppercase tracking-[0.08em] text-gray-600">
                                            Client
                                        </dt>
                                        <dd class="font-medium text-gray-900 lg:mt-1.5">
                                            {testimonial.name}
                                        </dd>
                                    </div>
                                    <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] items-baseline gap-x-3 lg:block">
                                        <dt class="text-[0.6875rem] font-medium uppercase tracking-[0.08em] text-gray-600">
                                            Entreprise
                                        </dt>
                                        <dd class="text-gray-900 lg:mt-1.5">
                                            {testimonial.company}
                                        </dd>
                                    </div>
                                    <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] items-baseline gap-x-3 lg:block">
                                        <dt class="text-[0.6875rem] font-medium uppercase tracking-[0.08em] text-gray-600">
                                            Projet
                                        </dt>
                                        <dd class="lg:mt-1.5">
                                            <a
                                                class="group text-gray-900 underline decoration-gray-300 underline-offset-4 transition-colors hover:decoration-gray-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                                                href={testimonial.caseStudyHref}
                                            >
                                                {testimonial.projectLabel}
                                                <span class="sr-only">
                                                    {` : voir la réalisation ${testimonial.company}`}
                                                </span>
                                                <ArrowRight
                                                    class="ml-2 inline-block size-3 align-[-0.05em] transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none"
                                                    aria-hidden="true"
                                                />
                                            </a>
                                        </dd>
                                    </div>
                                </dl>
                            </figcaption>
                        </figure>

                        {testimonial.excerpt && (
                            <details class="disclosure md:col-start-2">
                                <summary class="inline-flex cursor-pointer items-center gap-3 rounded-sm font-mono text-xs font-medium uppercase tracking-[0.08em] text-gray-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500">
                                    <span
                                        class="disclosure-toggle"
                                        aria-hidden="true"
                                    />
                                    Lire l'avis complet
                                </summary>
                                <p class="max-w-2xl pt-5 text-base font-light leading-relaxed text-gray-700 sm:text-lg">
                                    {testimonial.text}
                                </p>
                            </details>
                        )}
                    </li>
                ))}
            </ol>

            <a
                aria-label="Tous les avis sur Google : 5 étoiles sur 5 (nouvel onglet)"
                class="group mt-8 inline-flex items-center gap-3 font-mono text-xs font-medium uppercase tracking-[0.08em] text-gray-900 no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                href={googleReviews.href}
                rel="noreferrer"
                target="_blank"
            >
                <span class="inline-flex items-center gap-1.5 rounded-md bg-blue-500 px-2 py-1 text-snow-50">
                    <Star aria-hidden="true" class="size-3.5" />
                    {googleReviews.rating}
                </span>
                <span class="underline decoration-gray-300 underline-offset-4 transition-colors group-hover:decoration-gray-900">
                    Tous les avis sur Google
                </span>
                <ArrowUpRight aria-hidden="true" class="size-3" />
            </a>
        </section>
    )
}

<style>
    .testimonial-row__quote {
        font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
        font-weight: 400;
        letter-spacing: -0.015em;
        line-height: 1.18;
        text-wrap: pretty;
    }
</style>
