---
import { Image } from "astro:assets";
import Carousel from "@/components/Carousel.astro";
import ArrowRight from "@/components/icons/nucleo/arrow-right-fill.svg";
import ProjectTag from "@/components/realisations/ProjectTag.astro";
import WaveIcon from "@/components/ui/WaveIcon.astro";
import WaveText from "@/components/ui/WaveText.astro";
import { getPublishedTestimonials } from "@/lib/testimonials";

const splitQuote = (text: string, excerpt?: string) => {
    const start = excerpt ? text.indexOf(excerpt) : -1;

    return excerpt && start !== -1
        ? {
              before: text.slice(0, start),
              highlight: excerpt,
              after: text.slice(start + excerpt.length),
          }
        : { before: text };
};

const testimonials = getPublishedTestimonials().map((testimonial) => ({
    ...testimonial,
    quote: splitQuote(testimonial.text, testimonial.excerpt),
}));
---

{
    testimonials.length > 0 && (
        <section
            class="client-testimonials mx-auto w-full max-w-7xl px-4 py-12 sm:px-8 md:py-16"
            aria-labelledby="testimonials-title"
        >
            <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
                <div class="flex max-w-3xl flex-col gap-4">
                    <h2
                        id="testimonials-title"
                        class="section-heading text-left text-[clamp(2.35rem,3.9vw,3.45rem)]"
                    >
                        Ce que mes clients disent de leur site
                    </h2>
                    <p class="section-subheading mx-0 text-left">
                        Des entreprises accompagnées du cadrage à la mise en
                        ligne, et ce qu'elles en retiennent.
                    </p>
                </div>
                <a
                    class="service-method-button flex min-h-14 w-full max-w-full shrink-0 items-center justify-center gap-4 rounded-xl px-8 py-3 text-base font-normal sm:w-auto sm:px-10"
                    href="/realisations/"
                >
                    <WaveText
                        class="relative z-10"
                        text="Voir mes réalisations"
                        trigger="parent"
                    />
                    <WaveIcon
                        class="relative z-10"
                        style="--wui-wave-icon-size: 1rem;"
                        direction="right"
                        trigger="parent"
                    >
                        <ArrowRight class="size-full" aria-hidden="true" />
                    </WaveIcon>
                </a>
            </div>

            <Carousel
                class="testimonial-carousel mt-10 md:mt-14"
                compactControls
            >
                {testimonials.map(
                    ({ image, imageAlt, initials, name, project, quote }) => (
                        <article class="embla__slide">
                            <figure class="testimonial-card flex h-full flex-col rounded-3xl bg-gray-100 p-6 sm:p-8">
                                <div class="flex flex-wrap gap-2">
                                    {project.tags.map((tag) => (
                                        <ProjectTag tag={tag} />
                                    ))}
                                </div>

                                <blockquote class="mt-6 text-lg font-light leading-relaxed text-gray-600 sm:text-xl">
                                    “{quote.before}{
                                        quote.highlight && (
                                            <span class="font-normal text-gray-900">
                                                {quote.highlight}
                                            </span>
                                        )
                                    }{quote.after}”
                                </blockquote>

                                <figcaption class="mt-auto flex items-end justify-between gap-6 pt-8">
                                    <div>
                                        <p class="text-base font-medium text-gray-900">
                                            {name}
                                        </p>
                                        <p class="text-sm text-gray-500">
                                            {project.title}
                                        </p>
                                        <a
                                            class="mt-3 inline-flex items-center gap-2 text-sm text-blue-500 no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                                            href={`/realisations/${project.id}/`}
                                        >
                                            <WaveText
                                                text="Découvrir ce projet"
                                                trigger="parent"
                                            />
                                            <WaveIcon
                                                style="--wui-wave-icon-size: 0.875rem;"
                                                direction="right"
                                                trigger="parent"
                                            >
                                                <ArrowRight
                                                    class="size-full"
                                                    aria-hidden="true"
                                                />
                                            </WaveIcon>
                                        </a>
                                    </div>
                                    {image ? (
                                        <Image
                                            class="size-16 shrink-0 rounded-xl object-cover"
                                            src={image}
                                            alt={imageAlt ?? ""}
                                            width={128}
                                            height={128}
                                        />
                                    ) : (
                                        <div class="flex size-16 shrink-0 items-center justify-center rounded-xl bg-snow-50 text-base font-medium text-gray-900">
                                            {initials}
                                        </div>
                                    )}
                                </figcaption>
                            </figure>
                        </article>
                    ),
                )}
            </Carousel>
        </section>
    )
}

<style>
    /* Embla only scrolls when the slides overflow the viewport: two narrower
       cards would both fit and the arrows would do nothing. */
    .client-testimonials :global(.embla) {
        --slide-size: min(100% - var(--slide-spacing), 52rem);
    }

    /* Hides each slide's leading padding so the cards line up with the
       heading. `position: relative` keeps the container's offsetLeft at 0,
       which Embla compares with the slides' offsets. */
    .client-testimonials :global(.embla__viewport) {
        margin-left: calc(var(--slide-spacing) * -1);
        position: relative;
    }

    .client-testimonials :global(.embla__slide) {
        aspect-ratio: auto;
    }

    .testimonial-card {
        transition: opacity 520ms
            var(--wui-ease-standard, cubic-bezier(0.2, 0, 0, 1));
    }

    .embla__slide[aria-hidden="true"] .testimonial-card {
        opacity: 0.45;
    }

    @media (prefers-reduced-motion: reduce) {
        .testimonial-card {
            transition: none;
        }
    }
</style>
