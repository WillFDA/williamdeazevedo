---
import { Image } from "astro:assets";
import Carousel from "@/components/Carousel.astro";
import ArrowRight from "@/components/icons/nucleo/arrow-right-fill.svg";
import ProjectTag from "@/components/realisations/ProjectTag.astro";
import WaveIcon from "@/components/ui/WaveIcon.astro";
import WaveText from "@/components/ui/WaveText.astro";
import { getPublishedTestimonials } from "@/lib/testimonials";

const splitQuote = (text: string, excerpt?: string) => {
    const start = excerpt ? text.indexOf(excerpt) : -1;

    return excerpt && start !== -1
        ? {
              before: text.slice(0, start),
              highlight: excerpt,
              after: text.slice(start + excerpt.length),
          }
        : { before: text };
};

const testimonials = getPublishedTestimonials().map((testimonial) => ({
    ...testimonial,
    quote: splitQuote(testimonial.text, testimonial.excerpt),
}));
const titleWords = "Ce que mes clients disent de leur site".split(" ");
---

{
    testimonials.length > 0 && (
        <section
            class="client-testimonials mx-auto w-full max-w-7xl px-4 py-12 sm:px-8 md:py-16"
            aria-labelledby="testimonials-title"
            data-section-reveal="false"
            data-testimonials
        >
            <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
                <div class="flex max-w-3xl flex-col gap-4">
                    <h2
                        id="testimonials-title"
                        class="section-heading section-heading--left"
                    >
                        {titleWords.map((word, index) => (
                            <Fragment>
                                {index > 0 && " "}
                                <span class="inline-block" data-testimonials-word>
                                    {word}
                                </span>
                            </Fragment>
                        ))}
                    </h2>
                    <p class="section-subheading mx-0 text-left" data-testimonials-description>
                        Des entreprises accompagnées du cadrage à la mise en
                        ligne, et ce qu'elles en retiennent.
                    </p>
                </div>
                <a
                    class="service-method-button flex min-h-14 w-full max-w-full shrink-0 items-center justify-center gap-4 rounded-xl px-8 py-3 text-base font-normal sm:w-auto sm:px-10"
                    href="/realisations/"
                    data-testimonials-cta
                >
                    <WaveText
                        class="relative z-10"
                        text="Voir mes réalisations"
                        trigger="parent"
                    />
                    <WaveIcon
                        class="relative z-10"
                        style="--wui-wave-icon-size: 1rem;"
                        direction="right"
                        trigger="parent"
                    >
                        <ArrowRight class="size-full" aria-hidden="true" />
                    </WaveIcon>
                </a>
            </div>

            <Carousel
                class="testimonial-carousel mt-10 md:mt-14"
                compactControls
            >
                {testimonials.map(
                    ({ image, imageAlt, initials, name, project, quote }) => (
                        <article class="embla__slide">
                            <figure class="testimonial-card flex min-h-full flex-col rounded-3xl bg-surface-muted p-6 sm:p-8">
                                <div class="flex flex-wrap gap-2">
                                    {project.tags.map((tag) => (
                                        <ProjectTag tag={tag} />
                                    ))}
                                </div>

                                <blockquote class="mt-6 text-lg font-light leading-relaxed text-gray-600 sm:text-xl">
                                    “{quote.before}{
                                        quote.highlight && (
                                            <span class="text-gray-900">
                                                {quote.highlight}
                                            </span>
                                        )
                                    }{quote.after}”
                                </blockquote>

                                {/* Identity first in the DOM: on top on mobile, flipped to the right of the CTA from sm. */}
                                <figcaption class="mt-auto flex flex-col gap-5 pt-8 sm:flex-row-reverse sm:items-center sm:justify-between">
                                    <div class="flex flex-row-reverse items-center justify-end gap-4 sm:flex-row">
                                        <div class="sm:text-right">
                                            <p class="text-base font-medium text-gray-900">
                                                {name}
                                            </p>
                                            <p class="text-sm text-gray-600">
                                                {project.title}
                                            </p>
                                        </div>
                                        {image ? (
                                            <Image
                                                class="size-16 shrink-0 rounded-xl object-cover"
                                                src={image}
                                                alt={imageAlt ?? ""}
                                                width={128}
                                                height={128}
                                            />
                                        ) : (
                                            <div class="flex size-16 shrink-0 items-center justify-center rounded-xl bg-snow-50 text-base font-medium text-gray-900">
                                                {initials}
                                            </div>
                                        )}
                                    </div>
                                    <a
                                        class="hero-button hero-button--primary flex min-h-14 w-full items-center justify-center gap-5 rounded-xl px-8 py-3 text-base font-normal sm:w-auto"
                                        href={`/realisations/${project.id}/`}
                                    >
                                        <WaveText
                                            text="Découvrir ce projet"
                                            trigger="parent"
                                        />
                                        <WaveIcon
                                            style="--wui-wave-icon-size: 1rem;"
                                            direction="right"
                                            trigger="parent"
                                        >
                                            <ArrowRight
                                                class="size-full"
                                                aria-hidden="true"
                                            />
                                        </WaveIcon>
                                    </a>
                                </figcaption>
                            </figure>
                        </article>
                    ),
                )}
            </Carousel>
        </section>
    )
}

<script>
    import { createScrollReveal, prefersReducedMotion, queryAll } from "@/scripts/motion";

    document.addEventListener("astro:page-load", () => {
        if (prefersReducedMotion()) return;
        for (const section of queryAll(document, "[data-testimonials]")) {
            const motion = createScrollReveal(section, [
                {
                    at: 0,
                    duration: 0.5,
                    from: { opacity: 0, scale: 0.985, y: 18 },
                    stagger: 0.025,
                    targets: queryAll(section, "[data-testimonials-word]"),
                },
                {
                    at: 0.1,
                    duration: 0.44,
                    from: { opacity: 0, y: 14 },
                    targets: section.querySelector<HTMLElement>(
                        "[data-testimonials-description]",
                    ),
                },
                {
                    at: 0.16,
                    duration: 0.44,
                    from: { opacity: 0, y: 12 },
                    targets: section.querySelector<HTMLElement>(
                        "[data-testimonials-cta]",
                    ),
                },
                // The fade goes on the viewport: Embla loops, so it owns the
                // slides' transform, and inactive cards rest at 0.45 opacity.
                {
                    at: 0.2,
                    duration: 0.46,
                    from: { opacity: 0 },
                    targets: section.querySelector<HTMLElement>(".embla__viewport"),
                },
                {
                    at: 0.2,
                    duration: 0.52,
                    from: { scale: 0.985, y: 22 },
                    stagger: 0.07,
                    targets: queryAll(section, ".testimonial-card"),
                },
            ]);
            document.addEventListener("astro:before-swap", motion.revert, {
                once: true,
            });
        }
    });
</script>

<style>
    /* Embla only scrolls when the slides overflow the viewport: two narrower
       cards would both fit and the arrows would do nothing. */
    .client-testimonials :global(.embla) {
        --slide-size: min(100% - var(--slide-spacing), 52rem);
    }

    /* Hides each slide's leading padding so the cards line up with the
       heading. `position: relative` keeps the container's offsetLeft at 0,
       which Embla compares with the slides' offsets. */
    .client-testimonials :global(.embla__viewport) {
        margin-left: calc(var(--slide-spacing) * -1);
        position: relative;
    }

    /* Below lg the carousel's 16/9 frame is too short for a quote, which
       would spill under the arrows: the card follows its content instead.
       From lg the 16/9 card stays, as a minimum (`min-h-full` on the card). */
    @media (max-width: 1023px) {
        .client-testimonials :global(.embla) {
            --slide-aspect-ratio: auto;
        }
    }

    .testimonial-card {
        transition: opacity 520ms
            var(--wui-ease-standard, cubic-bezier(0.2, 0, 0, 1));
    }

    .embla__slide[aria-hidden="true"] .testimonial-card {
        opacity: 0.45;
    }

    @media (prefers-reduced-motion: reduce) {
        .testimonial-card {
            transition: none;
        }
    }
</style>
