---
import { ClientRouter } from "astro:transitions";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import CalDrawer from "../components/CalDrawer.astro";
import FloatingEmailBubble from "../components/FloatingEmailBubble.astro";
import TopContactBanner from "../components/TopContactBanner.astro";
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    imageAlt?: string;
    canonicalPath?: string;
    ogType?: "website" | "article" | "profile";
    article?: {
        publishedTime?: string;
        modifiedTime?: string;
        author?: string;
        tags?: string[];
    };
}

const {
    title = "William De Azevedo - Développeur front-end freelance",
    description = "Développeur front-end freelance orienté design et produit, je rends les sites plus clairs, rapides, accessibles et crédibles.",
    image = "/pictures/william-low.png",
    imageAlt = "William De Azevedo, développeur front-end freelance",
    canonicalPath,
    ogType = "website",
    article,
} = Astro.props;

const siteName = "William De Azevedo";
const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, siteUrl);
const imageUrl = new URL(image, siteUrl);
const phoneDisplay = String(import.meta.env.PUBLIC_PHONE_DISPLAY ?? "").trim();
const phoneValue = String(import.meta.env.PUBLIC_PHONE_HREF ?? phoneDisplay)
    .replace(/^tel:/, "")
    .replaceAll(/[^\d+]/g, "");
const phoneHref = phoneValue ? `tel:${phoneValue}` : "";

const personId = new URL("/#person", siteUrl).href;

const personJsonLd = {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": personId,
    name: "William De Azevedo",
    url: siteUrl.href,
    image: new URL("/pictures/william-low.png", siteUrl).href,
    jobTitle: "Développeur front-end freelance",
    description:
        "Développeur front-end freelance orienté design et produit, je rends les sites plus clairs, rapides, accessibles et crédibles.",
    sameAs: [
        "https://www.linkedin.com/in/william-de-azevedo/",
        "https://x.com/Williamdazevedo",
        "https://github.com/WillFDA",
        "https://www.malt.fr/profile/williamferreiradeazevedo",
    ],
    knowsAbout: [
        "Astro",
        "React",
        "Next.js",
        "TypeScript",
        "Tailwind CSS",
        "SEO technique",
        "Accessibilité web",
        "UI design",
    ],
    address: {
        "@type": "PostalAddress",
        addressRegion: "Île-de-France",
        addressCountry: "FR",
    },
    worksFor: {
        "@type": "Organization",
        name: "William De Azevedo — Développeur freelance",
    },
};

// Nom du site pour Google : publié uniquement sur la page d'accueil et relié
// au nœud Person ci-dessus par son @id (pas de second bloc Person).
const isHomePage = canonicalUrl.pathname === "/";
const websiteJsonLd = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": new URL("/#website", siteUrl).href,
    name: siteName,
    alternateName: "williamdeazevedo.fr",
    url: new URL("/", siteUrl).href,
    inLanguage: "fr-FR",
    publisher: { "@id": personId },
    about: { "@id": personId },
};
---

<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link
            rel="icon"
            type="image/png"
            sizes="96x96"
            href="/favicon-96x96.png"
        />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#f8fafc" />
        <meta name="generator" content={Astro.generator} />
        {/* Client-side routing + view transitions. Swaps the DOM in place so
            navigation no longer triggers a full reload (the white flash) and
            fires the astro:page-load / astro:before-swap lifecycle the
            interactive components rely on to (re)initialise. */}
        <ClientRouter />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalUrl.href} />
        <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
        <meta property="og:locale" content="fr_FR" />
        <meta property="og:site_name" content={siteName} />
        <meta property="og:type" content={ogType} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl.href} />
        <meta property="og:image" content={imageUrl.href} />
        <meta property="og:image:alt" content={imageAlt} />
        {
            article && (
                <>
                    {article.publishedTime && (
                        <meta
                            property="article:published_time"
                            content={article.publishedTime}
                        />
                    )}
                    {article.modifiedTime && (
                        <meta
                            property="article:modified_time"
                            content={article.modifiedTime}
                        />
                    )}
                    {article.author && (
                        <meta
                            property="article:author"
                            content={article.author}
                        />
                    )}
                    {article.tags?.map((tag) => (
                        <meta property="article:tag" content={tag} />
                    ))}
                </>
            )
        }
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageUrl.href} />
        <meta name="twitter:image:alt" content={imageAlt} />
        <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify(personJsonLd)}
        />
        {
            isHomePage && (
                <script
                    type="application/ld+json"
                    is:inline
                    set:html={JSON.stringify(websiteJsonLd)}
                />
            )
        }
        <title>{title}</title>
    </head>
    <body class="min-h-screen min-w-0 flex flex-col">
        <a
            class="skip-link fixed top-3 left-3 z-[100] rounded-[0.7rem] bg-coffee-300 px-4 py-2.5 text-sm text-snow-50 no-underline"
            href="#main-content"
        >
            Aller au contenu principal
        </a>
        <TopContactBanner phoneDisplay={phoneDisplay} phoneHref={phoneHref} />
        <Header pathName={Astro.url.pathname} />
        <main
            id="main-content"
            tabindex="-1"
            class="mt-12 flex-1 flex flex-col gap-8"
        >
            <slot />
        </main>
        <Footer />
        <CalDrawer />
        <FloatingEmailBubble />
        <script>
            import {
                initFadeInAnimations,
                resetFadeInAnimations,
            } from "../scripts/animations/fadeIn";
            import {
                initAnalytics,
                trackAnalytics,
                type TrackingProperties,
            } from "../scripts/analytics";
            import { initMobileFooterBoundary } from "../scripts/mobileFooterBoundary";

            initAnalytics();

            const windowWithSectionReveal = window as Window & {
                __wuiContactClickTrackingReady?: boolean;
                __wuiSectionRevealReady?: boolean;
            };

            const socialHosts = new Map([
                ["github.com", "github"],
                ["linkedin.com", "linkedin"],
                ["malt.fr", "malt"],
                ["x.com", "x"],
            ]);

            const normalizeTrackingValue = (
                value: string | null | undefined,
                maxLength = 120,
            ) => value?.replaceAll(/\s+/g, " ").trim().slice(0, maxLength) ?? "";

            const getTrackingLabel = (link: HTMLAnchorElement) =>
                normalizeTrackingValue(
                    link.dataset.analyticsLabel ||
                        link.getAttribute("aria-label") ||
                        link.textContent,
                );

            const getTrackingLocation = (link: HTMLAnchorElement) => {
                const explicitLocation = normalizeTrackingValue(
                    link.dataset.analyticsLocation,
                );

                if (explicitLocation) return explicitLocation;
                if (link.closest("[data-site-header]")) return "header";
                if (link.closest("footer")) return "footer";

                const section = link.closest<HTMLElement>(
                    "[data-analytics-section], section[id]",
                );

                return (
                    normalizeTrackingValue(section?.dataset.analyticsSection) ||
                    normalizeTrackingValue(section?.id) ||
                    window.location.pathname ||
                    "/"
                );
            };

            const trackContactIntent = (
                eventName: string,
                properties: TrackingProperties,
            ) => {
                trackAnalytics(eventName, properties);
            };

            const trackContactLinkClick = (event: MouseEvent) => {
                const target = event.target;
                if (!(target instanceof Element)) return;

                const link = target.closest<HTMLAnchorElement>("a[href]");
                if (!link || link.closest("[data-cal-open]")) return;

                const href = link.getAttribute("href");
                if (!href) return;

                let url: URL;

                try {
                    url = new URL(href, window.location.href);
                } catch {
                    return;
                }

                const baseProperties = {
                    label: getTrackingLabel(link),
                    location: getTrackingLocation(link),
                    path: window.location.pathname || "/",
                };

                if (url.protocol === "mailto:") {
                    trackContactIntent("contact_email_click", {
                        ...baseProperties,
                        email: normalizeTrackingValue(url.pathname),
                    });
                    return;
                }

                if (url.protocol === "tel:") {
                    trackContactIntent("contact_phone_click", {
                        ...baseProperties,
                        phone: normalizeTrackingValue(url.pathname),
                    });
                    return;
                }

                if (
                    !["http:", "https:"].includes(url.protocol) ||
                    url.origin === window.location.origin
                ) {
                    return;
                }

                const host = url.hostname.replace(/^www\./, "");
                const platform = socialHosts.get(host);

                trackContactIntent(
                    platform ? "contact_social_click" : "outbound_link_click",
                    {
                        ...baseProperties,
                        host,
                        platform: platform ?? "external",
                        url: normalizeTrackingValue(url.href, 240),
                    },
                );
            };

            if (!windowWithSectionReveal.__wuiContactClickTrackingReady) {
                document.addEventListener("click", trackContactLinkClick, {
                    capture: true,
                });
                windowWithSectionReveal.__wuiContactClickTrackingReady = true;
            }

            const prepareSectionReveals = (root: Document) => {
                root.querySelectorAll<HTMLElement>("#main-content section").forEach(
                    (section, index) => {
                        if (section.dataset.sectionReveal === "false") {
                            return;
                        }

                        if (section.dataset.revealOnScroll === "") {
                            return;
                        }

                        section.dataset.revealOnScroll = "";
                        section.classList.add("section-fade-reveal", "is-reveal-ready");
                        section.style.setProperty(
                            "--fade-delay",
                            `${Math.min(index * 0.06, 0.18)}s`,
                        );
                    },
                );

                initFadeInAnimations(root);
            };

            prepareSectionReveals(document);
            initMobileFooterBoundary();

            if (!windowWithSectionReveal.__wuiSectionRevealReady) {
                document.addEventListener("astro:page-load", () =>
                    prepareSectionReveals(document),
                );
                document.addEventListener("astro:before-swap", () =>
                    resetFadeInAnimations(document),
                );
                windowWithSectionReveal.__wuiSectionRevealReady = true;
            }
        </script>
    </body>
</html>

<style>
    /* Keyboard "skip to content" shortcut: hidden until focused. */
    .skip-link {
        transform: translateY(-160%);
        transition: transform 220ms cubic-bezier(0.2, 0, 0, 1);
    }

    .skip-link:focus-visible {
        transform: translateY(0);
        outline: 2px solid var(--color-blue-500);
        outline-offset: 3px;
    }

    /* Don't paint a focus ring around <main> when focus is moved to it. */
    main:focus {
        outline: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .skip-link {
            transition: none;
        }
    }

    :global(.section-fade-reveal) {
        transition:
            opacity 1050ms cubic-bezier(0.16, 1, 0.3, 1),
            transform 1050ms cubic-bezier(0.16, 1, 0.3, 1),
            filter 1050ms cubic-bezier(0.16, 1, 0.3, 1);
        transition-delay: var(--fade-delay, 0s);
    }

    :global(.section-fade-reveal.is-reveal-ready) {
        filter: blur(2px);
        opacity: 0;
        transform: translate3d(0, 1.2rem, 0);
        will-change: opacity, transform, filter;
    }

    :global(.section-fade-reveal.is-reveal-ready.is-visible),
    :global(.section-fade-reveal.is-reveal-complete) {
        filter: none;
        opacity: 1;
        transform: none;
        will-change: auto;
    }

    :global(.section-fade-reveal.is-reveal-complete) {
        transition: none;
    }

    @media (scripting: none), (prefers-reduced-motion: reduce) {
        :global(.section-fade-reveal),
        :global(.section-fade-reveal.is-reveal-ready),
        :global(.section-fade-reveal.is-reveal-ready.is-visible),
        :global(.section-fade-reveal.is-reveal-complete) {
            filter: none;
            opacity: 1;
            transform: none;
            transition: none;
            will-change: auto;
        }
    }
</style>
