{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bunx ultracite fix --hook",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-shell.mjs\""
          }
        ]
      }
    ]
  }
}
